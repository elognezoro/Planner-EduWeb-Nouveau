// EduWeb Planner — Schéma Prisma de référence
// Phase 0/1 : RBAC à périmètre + authentification.
// Les entités de périmètre (Region, Etablissement, Cafop, Apfc) sont posées ici
// en version minimale ; elles seront étoffées en Phase 2 (cf. cahier des charges §3.1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 : l'URL n'est plus déclarée ici.
  // - Au runtime, elle est fournie via le driver adapter (@prisma/adapter-pg) — voir src/lib/prisma.ts.
  // - Pour les migrations, elle est lue depuis prisma.config.ts (env DIRECT_URL).
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  Énumérations
// ─────────────────────────────────────────────────────────────

/// Statut du COMPTE — découplé du statut de la demande de rôle (cahier §6.1).
enum StatutCompte {
  en_attente_verification // inscrit, e-mail pas encore confirmé
  actif // e-mail confirmé : peut se connecter
  suspendu // bloqué temporairement par l'administrateur
  archive // archivé (conservation) — connexion impossible, réactivable
}

/// Statut d'une demande de rôle (cahier §6.6).
enum StatutDemandeRole {
  en_attente
  approuvee
  refusee
}

/// Type de jeton à usage unique (vérification e-mail / réinitialisation mot de passe).
enum TypeJeton {
  verification_email
  reinitialisation_mot_de_passe
  connexion_2fa // code à 6 chiffres envoyé à la connexion (double authentification)
  activation_2fa // code à 6 chiffres confirmant l'activation de la 2FA depuis le profil
}

// ── Phase 2 : structure & établissements ──

enum TypeEtablissement {
  prescolaire
  primaire
  college
  lycee
  technique
  formation_professionnelle
  technique_professionnel
  groupe_scolaire
  autre
}

enum StatutEtablissement {
  public
  prive
  confessionnel
  autre
}

enum TypeSalle {
  ordinaire
  laboratoire
  salle_informatique
  atelier
  salle_eps
  autre
}

/// Cycle d'un niveau scolaire.
enum CycleNiveau {
  prescolaire
  primaire
  college
  lycee
}

/// Régime de vacation (cahier §5.3.0-e) : simple ou double vacation.
enum RegimeVacation {
  simple
  double
}

/// Régime de notation par défaut (cahier §5.2.17) — séquentiel : 6 ou 8 séquences.
enum RegimeNotation {
  trimestre
  semestre
  sequence
}

/// Statut de présence d'un élève sur une séance (cahier §5.3.1).
enum StatutPresence {
  present
  absent
  retard
  excuse
}

/// Nature d'une notification in-app (pilote l'icône et la couleur d'affichage).
enum TypeNotification {
  info
  succes
  alerte
  role
}

/// Type de visite d'inspection (cahier §5 — inspection & supervision).
enum TypeVisite {
  classe
  etablissement
  suivi
}

/// Statut d'une visite d'inspection.
enum StatutVisite {
  planifiee
  realisee
  annulee
}

/// Priorité d'une recommandation d'inspection.
enum PrioriteRecommandation {
  basse
  moyenne
  haute
}

/// Statut de traitement d'une recommandation.
enum StatutRecommandation {
  ouverte
  en_cours
  traitee
}

/// Nature d'une cohorte de formation (cahier partie 5 — CAFOP & APFC).
enum TypeCohorte {
  cafop_promotion // promotion d'élèves-maîtres (CAFOP)
  apfc_session // session de formation continue (APFC)
}

/// Statut d'une cohorte de formation.
enum StatutCohorte {
  active
  cloturee
}

/// Formule d'abonnement Académie Premium (tarif selon l'effectif de l'établissement).
enum FormulePremium {
  petit // < 800 élèves
  grand // ≥ 800 élèves
}

/// Moyen de paiement (carte bancaire + Mobile Money ivoiriens).
enum ModePaiement {
  carte
  wave
  orange
  mtn
  moov
}

/// Statut d'un abonnement Premium.
enum StatutAbonnement {
  en_attente
  actif
  expire
}

/// Statut d'une demande de code promo (instruite par l'admin).
enum StatutDemandePromo {
  en_attente
  approuvee
  refusee
}

/// Nature d'une alerte SMS envoyée aux parents.
enum TypeAlerteSMS {
  absence
  retard
  note
  convocation
  info
}

/// Statut d'envoi d'un SMS (simulé tant qu'aucun fournisseur n'est branché).
enum StatutSMS {
  simule
  envoye
  echec
}

/// Statut d'un rendez-vous (parent ↔ personnel).
enum StatutRendezVous {
  demande
  confirme
  refuse
  annule
}

// ─────────────────────────────────────────────────────────────
//  RBAC : Rôle, Utilisateur, Demande de rôle
// ─────────────────────────────────────────────────────────────

/// Définition statique d'un profil d'accès (les 13 rôles, cahier §4.1).
model Role {
  id           String  @id @default(cuid())
  nomTechnique String  @unique // ex : "admin", "enseignant" (snake_case, cf. CLAUDE.md §8)
  libelle      String // ex : "Administrateur Système"
  description  String?
  rang         Int     @default(0) // ordre d'affichage / niveau de privilège indicatif

  utilisateurs Utilisateur[] @relation("RoleActif")
  demandes     DemandeRole[] @relation("RoleDemande")

  @@map("roles")
}

/// Compte d'un acteur de la plateforme (cahier §3.1, §4.2).
model Utilisateur {
  id             String       @id @default(cuid())
  email          String       @unique
  motDePasseHash String
  nom            String?
  prenoms        String?
  telephone      String?
  pays           String? // pays de l'utilisateur (détecté à l'inscription, modifiable au profil)
  sexe           String? // « F » / « M » — affiché notamment au registre d'appel
  matricule      String? // matricule élève (registre, bulletins)
  dateNaissance  DateTime? // date de naissance (fiche élève du registre)
  photoUrl       String?
  statutCompte   StatutCompte @default(en_attente_verification)
  emailVerifieLe DateTime?
  langue         String       @default("fr")

  // Double authentification (2FA) — OPTIONNELLE, au choix de l'utilisateur (Mon Profil › Sécurité).
  // Quand elle est active, la connexion exige un code à 6 chiffres envoyé par `deuxFacteursMethode`.
  // Étape 1 : canal « email » (Resend). Canaux « sms »/« whatsapp » branchés ultérieurement.
  deuxFacteursActif   Boolean @default(false)
  deuxFacteursMethode String  @default("email")

  // Rôle actif (technique). À l'inscription = "eleve" par défaut (cahier §6.2).
  roleActifId String
  roleActif   Role   @relation("RoleActif", fields: [roleActifId], references: [id])

  // Périmètre — nullable selon le rôle (cahier §3.2, §4.2).
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])
  cafopId         String?
  cafop           Cafop?         @relation(fields: [cafopId], references: [id])
  apfcId          String?
  apfc            Apfc?          @relation(fields: [apfcId], references: [id])
  regionId        String?
  region          Region?        @relation(fields: [regionId], references: [id])
  // Périmètre « diocèse » (rôle SEDEC — enseignement catholique diocésain) : nom du diocèse.
  diocese         String?
  /// Spécialité(s) d'encadrement pédagogique (rôles inspecteur / conseiller_pedagogique) :
  /// tableau JSON de NOMS de disciplines SIMPLES du référentiel (jamais les couples « X / Y »).
  /// Saisie au bloc « Ma spécialité » de Mon Profil ; restreint la liste des enseignants
  /// proposés à la planification d'une visite (intersection de spécialités).
  specialites     Json?
  // Rattachements SECONDAIRES à d'autres établissements (groupes scolaires) : même accès
  // que l'établissement principal `etablissementId` pour les rôles à portée « etablissement ».
  etablissementsSecondaires AffectationEtablissement[]

  // Période d'essai (fixée par l'admin système à l'affectation à un établissement) : pendant
  // l'essai, seul l'espace Emplois du temps est éditable ; le reste est en lecture seule. Un
  // bandeau rouge avec compte à rebours invite à l'abonnement. `essaiFinLe` nul = pas d'essai.
  essaiDebutLe DateTime?
  essaiFinLe   DateTime?
  // Horodatage de l'e-mail automatique de fin d'essai (anti-doublon : envoyé une seule fois).
  // Remis à null lorsqu'un nouvel essai est fixé, pour re-notifier à la nouvelle échéance.
  essaiFinNotifieLe DateTime?

  // PARRAINAGE — chaque utilisateur possède un code unique ; qui s'inscrit via son lien devient
  // son filleul. Le parrain touche une commission (cf. CommissionParrainage) à chaque abonnement
  // payé par un filleul. `parrainId` est fixé UNE fois à l'inscription et n'est jamais réécrit
  // (empêche de « voler » un filleul déjà rattaché). Auto-parrainage impossible (contrôlé en code).
  codeParrainage String?      @unique
  parrainId      String?
  parrain        Utilisateur? @relation("Parrainage", fields: [parrainId], references: [id], onDelete: SetNull)
  filleuls       Utilisateur[] @relation("Parrainage")
  commissionsRecues   CommissionParrainage[] @relation("CommissionParrain")
  commissionsGenerees CommissionParrainage[] @relation("CommissionFilleul")

  // Relations
  demandes            DemandeRole[]        @relation("DemandeUtilisateur")
  demandesTraitees    DemandeRole[]        @relation("DemandeTraitePar")
  echangesApprobation EchangeApprobation[] @relation("EchangeAuteur")
  liensCommeParent LienParentEleve[] @relation("Parent")
  liensCommeEleve  LienParentEleve[] @relation("Eleve")
  jetons           Jeton[]
  evenementsAppel  EvenementAppel[]  @relation("EvenementsEleve")
  evenementsSaisis EvenementAppel[]  @relation("EvenementsSaisis")
  seancesEnseignees   CahierTexte[]        @relation("SeancesEnseignant")
  demandesAccesCahier DemandeAccesCahier[] @relation("DemandesAccesCahier")
  // Vie scolaire (Phase 3)
  affectations     AffectationEnseignant[] @relation("AffectationsEnseignant")
  inscriptions     Inscription[]           @relation("InscriptionsEleve")
  appelsSaisis     Appel[]                 @relation("AppelsSaisis")
  presences        Presence[]              @relation("Presences")
  notesEleve         Note[]                  @relation("NotesEleve")
  notesSaisies       Note[]                  @relation("NotesSaisies")
  cahiersSaisis      CahierTexte[]           @relation("CahiersSaisis")
  notifications      Notification[]          @relation("NotificationsRecues")
  messagesEnvoyes    Message[]               @relation("MessagesEnvoyes")
  messagesRecus      Message[]               @relation("MessagesRecus")
  demandesPromo      DemandeCodePromo[]      @relation("DemandesPromo")
  invitationsCreees  InvitationFormation[]   @relation("InvitationsCreees")
  abonnementsSouscrits AbonnementPremium[]   @relation("AbonnementsSouscrits")
  rdvDemandes        RendezVous[]            @relation("RdvDemandes")
  rdvRecus           RendezVous[]            @relation("RdvRecus")
  visitesInspecteur  Visite[]                @relation("VisitesInspecteur")
  visitesEnseignant  Visite[]                @relation("VisitesEnseignant")
  grillesSupervision GrilleSupervision[]     @relation("GrillesSupervisionRempliPar")
  rapportsDisciplinaires RapportDisciplinaire[] @relation("RapportsDisciplinairesRempliPar")
  rapportsAntenne        RapportAntenne[]       @relation("RapportsAntenneRempliPar")
  modelesRapport         ModeleRapport[]        @relation("ModelesRapportProprietaire")
  competences        CompetenceEnseignant[]  @relation("CompetencesEnseignant")
  niveauxIntervention NiveauEnseignant[]     @relation("NiveauxEnseignant")
  absencesEnseignant AbsenceEnseignant[]     @relation("AbsencesEnseignant")
  absencesSaisies    AbsenceEnseignant[]     @relation("AbsencesSaisies")
  demandesAbsence         DemandeAbsence[]   @relation("DemandesAbsenceDemandeur")
  demandesAbsenceDecidees DemandeAbsence[]   @relation("DemandesAbsenceDecideur")
  remisesScolarite        RemiseEleve[]      @relation("RemisesEleve")
  paiementsScolarite      PaiementScolarite[] @relation("PaiementsEleve")
  // LMS « Aide et Formation »
  inscriptionsCours   InscriptionCours[]     @relation("InscriptionsCours")
  inscriptionsSession InscriptionSession[]   @relation("InscriptionsSession")
  tentativesQuiz      TentativeQuiz[]        @relation("TentativesQuiz")
  inscriptionsParcours InscriptionParcours[] @relation("InscriptionsParcours")
  badgesObtenus       BadgeObtenu[]          @relation("BadgesObtenus")
  soumissionsDevoir   SoumissionDevoir[]     @relation("SoumissionsDevoir")
  correctionsDevoir   SoumissionDevoir[]     @relation("CorrectionsDevoir")
  tuteurCours         TuteurCours[]          @relation("TuteurCours")
  pagesWikiCreees     PageWiki[]             @relation("PagesWikiCreees")
  pagesWikiModifiees  PageWiki[]             @relation("PagesWikiModifiees")
  revisionsWiki       RevisionWiki[]         @relation("RevisionsWiki")
  evaluationsWiki     EvaluationWiki[]       @relation("EvaluationsWiki")
  // Finances — fondation transverse : journal d'audit, taux de change et annulations logiques (RM-003/004/007)
  auditsFinance        JournalAuditFinance[] @relation("AuditsFinanceUtilisateur")
  tauxChangeCrees      TauxChange[]          @relation("TauxChangeCreePar")
  fraisAnnules         FraisScolarite[]      @relation("AnnulationsFraisScolarite")
  remisesAnnulees      RemiseEleve[]         @relation("AnnulationsRemiseEleve")
  paiementsAnnules     PaiementScolarite[]   @relation("AnnulationsPaiementScolarite")
  operationsAnnulees   OperationFinanciere[] @relation("AnnulationsOperationFinanciere")
  articlesAnnules      ArticleEconomat[]     @relation("AnnulationsArticleEconomat")
  mouvementsAnnules    MouvementStock[]      @relation("AnnulationsMouvementStock")
  relevesAnnules       ReleveBancaire[]      @relation("AnnulationsReleveBancaire")
  budgetsAnnules       BudgetLigne[]         @relation("AnnulationsBudgetLigne")
  cloturesAnnulees     ClotureExercice[]     @relation("AnnulationsClotureExercice")
  // Finances — sous-module Scolarité (06) : compte financier de l'élève + annulations logiques
  creancesEleve        CreanceEleve[]         @relation("CreancesEleve")
  exonerationsEleve    ExonerationEleve[]     @relation("ExonerationsEleve")
  boursesEleve         BourseEleve[]          @relation("BoursesEleve")
  plansPaiementEleve   PlanPaiement[]         @relation("PlansPaiementEleve")
  penalitesEleve       PenaliteEleve[]        @relation("PenalitesEleve")
  avancesEleve         AvanceEleve[]          @relation("AvancesEleve")
  remboursementsEleve  DemandeRemboursement[] @relation("RemboursementsEleve")
  categoriesFraisAnnulees CategorieFrais[]       @relation("AnnulationsCategorieFrais")
  creancesAnnulees        CreanceEleve[]         @relation("AnnulationsCreanceEleve")
  exonerationsAnnulees    ExonerationEleve[]     @relation("AnnulationsExonerationEleve")
  boursesAnnulees         BourseEleve[]          @relation("AnnulationsBourseEleve")
  plansPaiementAnnules    PlanPaiement[]         @relation("AnnulationsPlanPaiement")
  reglesPenalitesAnnulees ReglePenalite[]        @relation("AnnulationsReglePenalite")
  penalitesAnnulees       PenaliteEleve[]        @relation("AnnulationsPenaliteEleve")
  avancesAnnulees         AvanceEleve[]          @relation("AnnulationsAvanceEleve")
  remboursementsAnnules   DemandeRemboursement[] @relation("AnnulationsDemandeRemboursement")
  reglesBlocageAnnulees   RegleBlocage[]         @relation("AnnulationsRegleBlocage")
  // Finances — délégations de permissions (97-RBAC, RM-2604)
  delegationsFinanceRecues    DelegationFinance[] @relation("DelegationsFinanceBeneficiaire")
  delegationsFinanceAccordees DelegationFinance[] @relation("DelegationsFinanceAccordePar")
  delegationsFinanceAnnulees  DelegationFinance[] @relation("AnnulationsDelegationFinance")
  // Finances — facturation (07)
  facturesEleve        FactureEleve[]       @relation("FacturesEleve")
  facturesAnnulees     FactureEleve[]       @relation("AnnulationsFactureEleve")
  lignesFactureAnnulees LigneFacture[]      @relation("AnnulationsLigneFacture")
  avoirsAnnules        AvoirFacture[]       @relation("AnnulationsAvoirFacture")
  notesDebitAnnulees   NoteDebitFacture[]   @relation("AnnulationsNoteDebitFacture")
  // Finances — encaissements (08)
  ventilationsAnnulees VentilationPaiement[] @relation("AnnulationsVentilationPaiement")
  // Finances — caisses (09)
  caissesResponsable   CaisseEtablissement[] @relation("CaissesResponsable")
  sessionsCaissier     SessionCaisse[]       @relation("SessionsCaissier")
  caissesAnnulees      CaisseEtablissement[] @relation("AnnulationsCaisse")
  sessionsCaisseAnnulees SessionCaisse[]     @relation("AnnulationsSessionCaisse")
  mouvementsCaisseAnnules MouvementCaisse[]  @relation("AnnulationsMouvementCaisse")
  // Finances — banque (10)
  comptesBancairesResponsable CompteBancaire[]    @relation("ComptesBancairesResponsable")
  comptesBancairesAnnules     CompteBancaire[]    @relation("AnnulationsCompteBancaire")
  mouvementsBancairesAnnules  MouvementBancaire[] @relation("AnnulationsMouvementBancaire")
  chequesAnnules              Cheque[]            @relation("AnnulationsCheque")
  // Finances — comptabilité (11)
  comptesComptablesAnnules    CompteComptable[]       @relation("AnnulationsCompteComptable")
  journauxComptablesAnnules   JournalComptable[]      @relation("AnnulationsJournalComptable")
  ecrituresAnnulees           EcritureComptable[]     @relation("AnnulationsEcritureComptable")
  lignesEcritureAnnulees      LigneEcriture[]         @relation("AnnulationsLigneEcriture")
  cloturesPeriodeAnnulees     CloturePeriodeComptable[] @relation("AnnulationsCloturePeriode")
  // Finances — achats (12) & fournisseurs (13)
  fournisseursAnnules         Fournisseur[]           @relation("AnnulationsFournisseur")
  contactsFournisseurAnnules  ContactFournisseur[]    @relation("AnnulationsContactFournisseur")
  comptesFournisseurAnnules   CompteBancaireFournisseur[] @relation("AnnulationsCompteBancaireFournisseur")
  documentsFournisseurAnnules DocumentFournisseur[]   @relation("AnnulationsDocumentFournisseur")
  contratsFournisseurAnnules  ContratFournisseur[]    @relation("AnnulationsContratFournisseur")
  evaluationsFournisseurAnnulees EvaluationFournisseur[] @relation("AnnulationsEvaluationFournisseur")
  litigesFournisseurAnnules   LitigeFournisseur[]     @relation("AnnulationsLitigeFournisseur")
  // Finances — stocks (14)
  magasinsStockAnnules        MagasinStock[]          @relation("AnnulationsMagasinStock")
  lotsStockAnnules            LotStock[]              @relation("AnnulationsLotStock")
  seriesStockAnnulees         SerieStock[]            @relation("AnnulationsSerieStock")
  reservationsStockAnnulees   ReservationStock[]      @relation("AnnulationsReservationStock")
  inventairesStockAnnules     InventaireStock[]       @relation("AnnulationsInventaireStock")
  // Finances — immobilisations (15)
  immobilisationsAnnulees     Immobilisation[]        @relation("AnnulationsImmobilisation")
  // Finances — budgets (16)
  enveloppesBudgetAnnulees    Budget[]                @relation("AnnulationsBudget")
  centresCoutAnnules          CentreCout[]            @relation("AnnulationsCentreCout")
  engagementsBudgetAnnules    EngagementBudget[]      @relation("AnnulationsEngagementBudget")
  // Finances — dépenses (17)
  demandesDepenseAnnulees     DemandeDepense[]        @relation("AnnulationsDemandeDepense")
  avancesFraisAnnulees        AvanceFrais[]           @relation("AnnulationsAvanceFrais")
  depensesRecurrentesAnnulees DepenseRecurrente[]     @relation("AnnulationsDepenseRecurrente")
  demandesAchatAnnulees       DemandeAchat[]          @relation("AnnulationsDemandeAchat")
  devisFournisseurAnnules     DevisFournisseur[]      @relation("AnnulationsDevisFournisseur")
  bonsCommandeAnnules         BonCommande[]           @relation("AnnulationsBonCommande")
  lignesBonCommandeAnnulees   LigneBonCommande[]      @relation("AnnulationsLigneBonCommande")
  receptionsAchatAnnulees     ReceptionAchat[]        @relation("AnnulationsReceptionAchat")
  facturesFournisseurAnnulees FactureFournisseur[]    @relation("AnnulationsFactureFournisseur")
  paiementsFournisseurAnnules PaiementFournisseur[]   @relation("AnnulationsPaiementFournisseur")
  retoursFournisseurAnnules   RetourFournisseur[]     @relation("AnnulationsRetourFournisseur")

  // PRÉSENCE (« Utilisateurs connectés ») : dernier accès authentifié, rafraîchi au plus une
  // fois par minute par la résolution de session (écriture brute, hors journal d'activité).
  dernierAccesLe DateTime?
  accesPages     AccesPage[] @relation("AccesPages")

  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  @@index([roleActifId])
  @@index([etablissementId])
  @@index([cafopId])
  @@index([apfcId])
  @@index([regionId])
  @@index([dernierAccesLe])
  @@map("utilisateurs")
}

/// Demande d'attribution / changement de rôle (couvre l'inscription initiale, cahier §6).
model DemandeRole {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation("DemandeUtilisateur", fields: [utilisateurId], references: [id], onDelete: Cascade)

  roleDemandeId String
  roleDemande   Role   @relation("RoleDemande", fields: [roleDemandeId], references: [id])

  statut StatutDemandeRole @default(en_attente)

  // Périmètre DÉCLARÉ par le demandeur (texte libre + identifiants si connus).
  structureDeclaree      String? // ex : nom de l'établissement saisi à l'inscription
  etablissementDeclareId String?
  cafopDeclareId         String?
  apfcDeclareId          String?
  regionDeclareeId       String?

  motif      String? // message du demandeur et/ou commentaire de l'administrateur
  creeLe     DateTime  @default(now())
  traiteLe   DateTime?
  // Anticipe la délégation future par périmètre (cahier §6.4) — aucune migration requise plus tard.
  traiteParId String?
  traitePar   Utilisateur? @relation("DemandeTraitePar", fields: [traiteParId], references: [id])

  echanges EchangeApprobation[]

  @@index([statut])
  @@index([utilisateurId])
  @@map("demandes_role")
}

/// Fil de discussion entre l'administration et le demandeur d'un rôle, mené sur la page
/// « Approbations des demandes de rôle », avec copie e-mail aux deux parties — afin de
/// clarifier le besoin réel du demandeur AVANT d'approuver son compte.
model EchangeApprobation {
  id          String      @id @default(cuid())
  demandeId   String
  demande     DemandeRole @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteurId    String
  auteur      Utilisateur @relation("EchangeAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  /// Vrai = message écrit par le DEMANDEUR ; faux = par l'administration (approbateur).
  duDemandeur Boolean     @default(false)
  contenu     String
  creeLe      DateTime    @default(now())

  @@index([demandeId, creeLe])
  @@map("echanges_approbation")
}

/// Relation N↔N entre un compte parent et un ou plusieurs comptes élèves (cahier §3.3).
model LienParentEleve {
  id       String      @id @default(cuid())
  parentId String
  parent   Utilisateur @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  eleveId  String
  eleve    Utilisateur @relation("Eleve", fields: [eleveId], references: [id], onDelete: Cascade)
  lien     String? // "père", "mère", "tuteur légal"…
  creeLe   DateTime    @default(now())

  @@unique([parentId, eleveId])
  @@index([parentId])
  @@index([eleveId])
  @@map("liens_parent_eleve")
}

/// Jeton à usage unique pour la confirmation d'e-mail et la réinitialisation de mot de passe (cahier §6.2, §6.5).
model Jeton {
  id            String      @id @default(cuid())
  token         String      @unique
  type          TypeJeton
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime
  utiliseLe     DateTime?
  // Nombre de tentatives de saisie erronées (codes 2FA à 6 chiffres) : borne la force brute.
  tentatives    Int         @default(0)
  creeLe        DateTime    @default(now())

  @@index([utilisateurId])
  @@map("jetons")
}

// ─────────────────────────────────────────────────────────────
//  Entités de périmètre (minimales en Phase 1, étoffées en Phase 2)
// ─────────────────────────────────────────────────────────────

/// Découpage administratif régional (rattachement DRENA/DRENAET, cahier §3.1).
/// Surcharge d'une permission de module pour un rôle (matrice des droits éditable).
/// Une ligne absente = valeur par défaut de la carte de navigation (item.roles).
/// `itemId` = identifiant d'ItemNav (ex : "registre-appel") ; `role` = nomTechnique du rôle.
model PermissionRole {
  id         String   @id @default(cuid())
  itemId     String
  role       String
  accorde    Boolean
  misAJourLe DateTime @updatedAt

  @@unique([itemId, role])
  @@map("permissions_role")
}

model Region {
  id   String  @id @default(cuid())
  nom  String
  code String? @unique
  /// Pays de rattachement — permet des répertoires régionaux multi-pays (déploiement sous-régional).
  pays String  @default("Côte d'Ivoire")

  etablissements Etablissement[]
  cafops         Cafop[]
  apfcs          Apfc[]
  utilisateurs   Utilisateur[]

  creeLe DateTime @default(now())

  @@unique([pays, nom])
  @@map("regions")
}

/// Établissement scolaire (cahier §3.1). Étendu en Phase 2bis avec la configuration
/// complète servant d'intrant au module Emplois du temps (cf. console de configuration).
model Etablissement {
  id        String              @id @default(cuid())
  nom       String
  code      String?             @unique
  type      TypeEtablissement   @default(college)
  statut    StatutEtablissement @default(public)
  ville     String?
  adresse   String?
  email     String?
  telephone String?
  /// Catégorie pédagogique déclarée par l'établissement — pilote l'adaptation de toute la
  /// console de configuration : "prescolaire" | "primaire" | "secondaire" | "superieur".
  /// Au préscolaire/primaire, pas de distinction 1er/2nd cycle (maîtres polyvalents) : le
  /// bloc « Effectifs des enseignants par spécialité » est désactivé et le solveur l'ignore.
  /// Null (établissements créés avant cette fonctionnalité) = dérivée de `type` à la volée
  /// (voir `deriveCategoriePedagogique`) tant que l'utilisateur ne l'a pas choisie lui-même.
  categoriePedagogique String?
  /// Réseau confessionnel de rattachement (cascade quand statut = confessionnel) :
  /// SEDEC, Méthodiste, Protestants, Islamique… — null si non confessionnel.
  reseauConfessionnel String?
  /// Diocèse de rattachement (établissements catholiques du réseau SEDEC) — périmètre du rôle SEDEC.
  diocese             String?
  /// Régime de vacation par défaut de l'établissement (surchargé par niveau si besoin).
  regimeVacation RegimeVacation @default(simple)

  /// Disciplines retirées de la liste de CET établissement (particularités locales :
  /// l'établissement n'est pas forcément aligné sur les conditions nationales).
  disciplinesMasquees String[] @default([])
  /// Renommages LOCAUX de disciplines du référentiel NATIONAL ({ disciplineId: libellé }) :
  /// l'« expression » change pour CET établissement seulement — le référentiel partagé n'est
  /// jamais modifié (une discipline PROPRE est, elle, renommée directement dans sa ligne).
  disciplinesRenommees Json?
  /// Rapport de QUALITÉ du dernier emploi du temps généré ({ genereLe, score, scoreInitial,
  /// penalites, parClasse }) : affiché en permanence tant que l'EDT existe (pastilles des
  /// contraintes souples + détail par classe) ; effacé à la réinitialisation de l'EDT.
  qualiteEdt Json?
  /// Niveaux du référentiel NATIONAL retirés de la configuration de CET établissement
  /// (« supprimer » un niveau national = masquage local ; le référentiel n'est jamais modifié).
  niveauxMasques String[] @default([])

  /// Indexation des classes au calcul : « @ » = lettres (6ème A…), « # » = chiffres (6ème 1…).
  indexationClasses String @default("@")

  /// Régime de notation choisi par le chef d'établissement : trimestriel, semestriel
  /// ou séquentiel (null = régime de la Configuration générale).
  regimeNotation RegimeNotation?
  /// Nombre de séquences (6 ou 8) lorsque le régime est séquentiel.
  nbSequences    Int?

  // ── Étape 1 : paramétrage institutionnel & en-tête de bulletin ──
  pays          String? @default("Côte d'Ivoire")
  // Pas de valeur par défaut : le slogan national officiel est déduit AUTOMATIQUEMENT de la
  // devise du pays de l'établissement (voir sloganOfficiel()). Repli sur cette valeur stockée
  // uniquement pour les rares États sans devise au référentiel.
  sloganBulletin String?
  ministere     String?
  anneeScolaire String? // ex : « 2025-2026 »
  fonctionChef  String? // ex : « Proviseur »
  nomChef       String? // NOM du chef d'établissement (en majuscules)
  prenomsChef   String? // Prénoms du chef d'établissement (casse titre)
  // Documents officiels (URLs Vercel Blob)
  emblemeUrl   String?
  logoUrl      String?
  cachetUrl    String?
  signatureUrl String?
  // Rapport d'établissement
  planRapport         String?
  presentationRapport String? @default("Accordéon")

  // ── Barème de conduite (registre d'appel) — points par événement, ajustable par le chef ──
  conduiteAbsenceNj     Float @default(0.5) // malus par absence non justifiée
  conduiteRetardNj      Float @default(0.25) // malus par retard non justifié
  conduiteObservation   Float @default(0.5) // malus par observation disciplinaire
  conduiteEncouragement Float @default(0.25) // bonus par encouragement

  // ── Étape 2 : dimensionnement & horaires ──
  effectifSouhaiteParClasse Int @default(40)
  nbSallesDisponibles       Int @default(0)
  creneauxParJour           Int @default(8)
  // Horaires journaliers (format « HH:MM »)
  horaireDebutMatin       String? @default("07:30")
  horairePauseMatinDebut  String? @default("09:45")
  horairePauseMatinFin    String? @default("10:05")
  horairePauseMidiDebut   String? @default("12:00")
  horaireRepriseApresMidi String? @default("15:00")
  horaireFinJournee       String? @default("18:00")

  // ── Contraintes d'emploi du temps paramétrables par l'établissement ──
  /// Paramètres conditionnels de double vacation (élèves), ajoutés au fil de l'eau :
  /// [{ "libelle": "Cours d'EPS", "doubleVacation": false }, …]
  conditionsVacation Json @default("[]")
  // Plages horaires d'EPS de l'établissement (format « HH:MM ») — le solveur y confine l'EPS.
  epsMatinDebut      String?
  epsMatinFin        String?
  epsApresMidiDebut  String?
  epsApresMidiFin    String?
  /// Garantir à chaque enseignant un jour de repos parmi les cinq jours (contrainte dure).
  reposEnseignant Boolean @default(true)
  /// Regrouper les heures creuses d'un enseignant sur une demi-journée (optimisation).
  regrouperHeuresCreuses Boolean @default(true)
  /// Autoriser des heures creuses dans l'EDT des élèves (pour souffler) — choix du chef.
  autoriserHeuresCreuses Boolean @default(false)
  /// Contraintes supplémentaires OPTIONNELLES du bloc « Contraintes supplémentaires ».
  /// Une même discipline ne doit jamais avoir deux séances immédiatement consécutives
  /// dans la journée d'une classe (la pause méridienne rompt la consécutivité). Dure.
  interdireMemeDisciplineConsecutive Boolean @default(false)
  /// Deux disciplines LITTÉRAIRES ne doivent pas se suivre immédiatement (classe). Dure.
  interdireLitterairesConsecutifs Boolean @default(false)
  /// Deux disciplines SCIENTIFIQUES ne doivent pas se suivre immédiatement (classe). Dure.
  interdireScientifiquesConsecutifs Boolean @default(false)
  /// Éviter qu'un enseignant n'ait qu'UNE séance dans une demi-journée (optimisation forte,
  /// résidus signalés explicitement après génération).
  eviterSeanceIsoleeEnseignant Boolean @default(false)
  /// Une discipline : au plus UNE séance par demi-journée dans l'EDT d'une classe. Dure.
  limiterDisciplineParDemiJournee Boolean @default(false)
  /// Éviter qu'une classe TERMINE deux jours consécutifs par la même discipline
  /// (optimisation forte, résidus signalés après génération).
  eviterMemeDisciplineFinJournee Boolean @default(false)
  /// Plages sans cours dans TOUT l'établissement : [{ "jour": 0-4, "moment": "matin"|"apresmidi"|"journee" }]
  plagesSansCours Json @default("[]")
  /// En double vacation, quels indices de classes ont cours le MATIN : "impairs" (1,3,5…) ou "pairs".
  doubleVacationMatin String @default("impairs")
  /// En double vacation, la séance d'EPS se tient dans l'AUTRE demi-journée (isolée) : les
  /// autres cours — qui exigent une salle — restent dans la demi-journée de vacation de la
  /// classe, jamais de « journée entière » le jour d'EPS. Choix du chef (bloc Contraintes).
  epsDemiJourneeOpposee Boolean @default(false)
  /// Réduire les DÉPLACEMENTS DES ÉLÈVES : chaque classe reçoit une salle ATTITRÉE (en
  /// double vacation, une même salle physique sert la classe du matin ET celle de
  /// l'après-midi) — ce sont les enseignants qui changent de salle. Seuls les cours à salle
  /// spécialisée (EPS, labo, informatique) sortent de la salle attitrée.
  salleFixeParClasse Boolean @default(false)
  /// Volume horaire hebdomadaire dû par un enseignant du 1er cycle (n'intervient qu'au collège).
  /// Plafonne sa charge dans le solveur. 0 = non plafonné.
  volumeHoraire1erCycle Int @default(0)
  /// Volume horaire hebdomadaire dû par un enseignant du 2nd cycle (compétence sur les deux cycles).
  /// Plafonne sa charge dans le solveur. 0 = non plafonné.
  volumeHoraire2ndCycle Int @default(0)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  utilisateurs   Utilisateur[]
  classes        Classe[]
  salles         Salle[]
  grilles        GrilleHoraire[]
  niveauxConfig  NiveauEtablissement[]
  champsEnseignant ChampEnseignant[]
  /// Disciplines créées PAR cet établissement (le référentiel national a `etablissementId` nul).
  disciplines    Discipline[]
  /// Niveaux créés PAR cet établissement (le référentiel national a `etablissementId` nul).
  niveauxPropres Niveau[]
  competences    CompetenceEnseignant[]
  niveauxEnseignant NiveauEnseignant[]
  effectifsEnseignant EffectifEnseignant[]
  creneaux       Creneau[]
  absencesEnseignant AbsenceEnseignant[]
  demandesAbsence DemandeAbsence[]
  fraisScolarite         FraisScolarite[]
  remisesEleves          RemiseEleve[]
  paiementsScolarite     PaiementScolarite[]
  operationsFinancieres  OperationFinanciere[]
  articlesEconomat       ArticleEconomat[]
  relevesBancaires       ReleveBancaire[]
  budgetLignes           BudgetLigne[]
  cloturesExercice       ClotureExercice[]
  journalAuditFinance    JournalAuditFinance[]
  sequencesNumerotation  SequenceNumerotation[]
  categoriesFrais        CategorieFrais[]
  creancesEleve          CreanceEleve[]
  exonerationsEleve      ExonerationEleve[]
  boursesEleve           BourseEleve[]
  plansPaiement          PlanPaiement[]
  reglesPenalites        ReglePenalite[]
  penalitesEleve         PenaliteEleve[]
  avancesEleve           AvanceEleve[]
  demandesRemboursement  DemandeRemboursement[]
  reglesBlocage          RegleBlocage[]
  delegationsFinance     DelegationFinance[]
  facturesEleve          FactureEleve[]
  avoirsFacture          AvoirFacture[]
  notesDebitFacture      NoteDebitFacture[]
  ventilationsPaiement   VentilationPaiement[]
  caisses                CaisseEtablissement[]
  sessionsCaisse         SessionCaisse[]
  mouvementsCaisse       MouvementCaisse[]
  comptesBancaires       CompteBancaire[]
  mouvementsBancaires    MouvementBancaire[]
  cheques                Cheque[]
  comptesComptables      CompteComptable[]
  journauxComptables     JournalComptable[]
  ecrituresComptables    EcritureComptable[]
  cloturesPeriode        CloturePeriodeComptable[]
  fournisseurs           Fournisseur[]
  demandesAchat          DemandeAchat[]
  devisFournisseur       DevisFournisseur[]
  bonsCommande           BonCommande[]
  receptionsAchat        ReceptionAchat[]
  facturesFournisseur    FactureFournisseur[]
  paiementsFournisseur   PaiementFournisseur[]
  retoursFournisseur     RetourFournisseur[]
  magasinsStock          MagasinStock[]
  seriesStock            SerieStock[]
  reservationsStock      ReservationStock[]
  inventairesStock       InventaireStock[]
  immobilisations        Immobilisation[]
  budgets                Budget[]
  centresCout            CentreCout[]
  revisionsBudget        RevisionBudget[]
  engagementsBudget      EngagementBudget[]
  demandesDepense        DemandeDepense[]
  avancesFrais           AvanceFrais[]
  depensesRecurrentes    DepenseRecurrente[]
  visites        Visite[]
  abonnementsPremium AbonnementPremium[]
  alertesSms     AlerteSMS[]
  affectationsSecondaires AffectationEtablissement[]
  /// Compétence territoriale : l'APFC (Antenne Pédagogique de Formation Continue) dont relève
  /// cet établissement — null si non couvert. Un établissement ne relève que d'UNE seule APFC.
  couvertureApfc CouvertureApfc?

  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  @@index([regionId])
  @@map("etablissements")
}

/// Rattachement SECONDAIRE d'un utilisateur à un établissement (groupes scolaires) : le compte
/// garde son établissement PRINCIPAL (Utilisateur.etablissementId — la référence des gardes
/// individuelles) et obtient le MÊME accès sur chaque établissement listé ici (les filtres de
/// périmètre « etablissement » de lib/rbac/scope.ts couvrent principal + secondaires).
model AffectationEtablissement {
  id              String        @id @default(cuid())
  utilisateurId   String
  utilisateur     Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  creeLe          DateTime      @default(now())

  @@unique([utilisateurId, etablissementId])
  @@index([etablissementId])
  @@map("affectations_etablissement")
}

/// Configuration d'un niveau pour un établissement : effectif total, vacation, classes calculées.
model NiveauEtablissement {
  id              String         @id @default(cuid())
  etablissementId String
  etablissement   Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  niveauId        String
  niveau          Niveau         @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  effectif        Int            @default(0)
  vacation        RegimeVacation @default(simple)
  nbClasses       Int            @default(0)
  /// Effectif souhaité PAR CLASSE propre à CE niveau — indicatif, de SECOND rang : la valeur
  /// globale de l'établissement (`Etablissement.effectifSouhaiteParClasse`) reste la règle
  /// prioritaire, celle-ci s'applique au calcul des classes du niveau quand elle est renseignée.
  effectifSouhaiteClasse Int?
  /// Ordre d'affichage des niveaux PROPRE à cet établissement (6ème en tête, etc.).
  /// Nul = pas de choix local, on retombe sur l'ordre global `Niveau.ordre`. Cette colonne existe
  /// précisément pour que réordonner chez l'un ne réordonne pas chez les autres : `Niveau` est
  /// une table PARTAGÉE entre tous les établissements.
  ordre           Int?
  /// Nom d'affichage du niveau PROPRE à cet établissement (« 6e », « Sixième »…). Même logique
  /// que `ordre` : `Niveau.nom` est global et partagé, donc renommer localement passe par ici.
  /// Nul = pas de nom local, on affiche le nom canonique `Niveau.nom`.
  nomAffiche      String?

  @@unique([etablissementId, niveauId])
  @@index([etablissementId])
  @@map("niveaux_etablissement")
}

/// Champ personnalisé requis pour l'enregistrement des enseignants d'un établissement.
model ChampEnseignant {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  etiquette       String
  type            String        @default("text") // text | date | number | select
  placeholder     String?
  requis          Boolean       @default(false)
  ordre           Int           @default(0)

  @@index([etablissementId])
  @@map("champs_enseignant")
}

/// Compétence d'un enseignant : discipline qu'il est habilité à enseigner (intrant du solveur).
model CompetenceEnseignant {
  id              String        @id @default(cuid())
  enseignantId    String
  enseignant      Utilisateur   @relation("CompetencesEnseignant", fields: [enseignantId], references: [id], onDelete: Cascade)
  disciplineId    String
  discipline      Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, disciplineId])
  @@index([etablissementId])
  @@map("competences_enseignant")
}

/// Niveau auquel un enseignant intervient (intrant de l'affectation automatique).
model NiveauEnseignant {
  id              String        @id @default(cuid())
  enseignantId    String
  enseignant      Utilisateur   @relation("NiveauxEnseignant", fields: [enseignantId], references: [id], onDelete: Cascade)
  niveauId        String
  niveau          Niveau        @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, niveauId])
  @@index([etablissementId])
  @@map("niveaux_enseignant")
}

/// Effectif d'enseignants déclaré par cycle et discipline (intrant du solveur, approche par compteurs).
model EffectifEnseignant {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  disciplineId    String
  discipline      Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  cycle           CycleNiveau
  nombre          Int           @default(0)

  @@unique([etablissementId, disciplineId, cycle])
  @@index([etablissementId])
  @@map("effectifs_enseignant")
}

/// Niveau scolaire national (ex : 6ème, Seconde C) — cahier §3.1.
model Niveau {
  id    String      @id @default(cuid())
  /// Unicité gérée par index : globale pour le référentiel NATIONAL (index partiel SQL, cf.
  /// migration 20260819090000), et par établissement pour les niveaux propres.
  nom   String
  code  String?     @unique
  ordre Int         @default(0)
  cycle CycleNiveau @default(college)

  /// PÉRIMÈTRE (règle client : la configuration d'un établissement lui est propre).
  /// NULL = niveau du référentiel NATIONAL, commun à tous — ce sont les lignes historiques.
  /// Non NULL = niveau créé PAR et POUR cet établissement : invisible aux autres écoles.
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  classes       Classe[]
  grilles       GrilleHoraire[]
  niveauxConfig NiveauEtablissement[]
  enseignants   NiveauEnseignant[]

  @@unique([etablissementId, nom])
  @@index([etablissementId])
  @@map("niveaux")
}

/// Discipline / matière enseignée — cahier §3.1.
model Discipline {
  id      String  @id @default(cuid())
  /// Unicité gérée par index : globale pour le référentiel NATIONAL (index partiel SQL, cf.
  /// migration 20260813090000), et par établissement pour les disciplines propres.
  nom     String
  code    String? @unique
  couleur String? // code couleur pour l'affichage des emplois du temps

  /// PÉRIMÈTRE (règle client : la configuration d'un établissement lui est propre).
  /// NULL = discipline du référentiel NATIONAL, commune à tous — ce sont les lignes historiques.
  /// Non NULL = discipline créée PAR et POUR cet établissement : invisible aux autres écoles.
  /// Aucune référence existante n'est déplacée par ce champ ; il ne régit que la VISIBILITÉ et
  /// les créations futures.
  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  grilles      GrilleHoraire[]
  affectations AffectationEnseignant[]
  appels       Appel[]
  notes        Note[]
  cahiers      CahierTexte[]
  competences  CompetenceEnseignant[]
  effectifsEnseignant EffectifEnseignant[]

  @@unique([etablissementId, nom])
  @@index([etablissementId])
  @@map("disciplines")
}

/// Classe pédagogique au sein d'un établissement (ex : 6ème A) — cahier §3.1.
model Classe {
  id       String @id @default(cuid())
  nom      String
  effectif Int    @default(0)

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  niveauId        String
  niveau          Niveau        @relation(fields: [niveauId], references: [id])

  anneeScolaireId String?
  anneeScolaire   AnneeScolaire? @relation(fields: [anneeScolaireId], references: [id])

  regimeVacation RegimeVacation @default(simple)

  affectations AffectationEnseignant[]
  inscriptions Inscription[]
  appels       Appel[]
  notes        Note[]
  cahiers      CahierTexte[]
  evenements   EvenementAppel[]

  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  @@index([etablissementId])
  @@index([niveauId])
  @@map("classes")
}

/// Salle physique d'un établissement (capacité + type) — cahier §3.1, §5.3.0-e.
model Salle {
  id        String    @id @default(cuid())
  nom       String
  capacite  Int       @default(0)
  type      TypeSalle @default(ordinaire)

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  creeLe DateTime @default(now())

  @@index([etablissementId])
  @@map("salles")
}

/// Année scolaire (ex : « 2025-2026 ») — base des inscriptions (cahier §5.2.17).
model AnneeScolaire {
  id      String    @id @default(cuid())
  libelle String    @unique
  debut   DateTime?
  fin     DateTime?
  active  Boolean   @default(false)

  classes      Classe[]
  inscriptions Inscription[]

  @@map("annees_scolaires")
}

/// Grille horaire : volume hebdomadaire par niveau et discipline (cahier §5.3.0-e).
/// `etablissementId` null = modèle national par défaut ; non-null = surcharge établissement.
model GrilleHoraire {
  id          String @id @default(cuid())
  niveauId    String
  niveau      Niveau @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline  Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  /// Pays du modèle : la grille NATIONALE (etablissementId null) est définie par pays.
  pays String @default("Côte d'Ivoire")

  heuresHebdo    Float @default(0) // volume horaire hebdomadaire (heures), dérivé des séances
  nbSeances      Int?  // nombre de séances hebdomadaires
  coefficient    Float @default(1)
  seancesMinutes Int[] @default([]) // durées (min) de chaque séance hebdomadaire — ex : [60,60,60,60]
  /// Discipline FACULTATIVE (ex : LV2 en 1èreC/D, TleC/D) : proposée par le modèle national mais
  /// NON générée par défaut. Chaque établissement l'inclut s'il peut l'assurer (surcharge locale).
  facultatif     Boolean @default(false)

  @@unique([niveauId, disciplineId, etablissementId])
  @@index([niveauId])
  @@index([etablissementId])
  @@map("grilles_horaires")
}

/// Configuration globale de la plateforme (singleton) — cahier §5.2.17.
model Configuration {
  id                   String         @id @default("global")
  anneeScolaireCourante String?
  regimeNotation       RegimeNotation @default(trimestre)
  // Période d'essai par défaut (appliquée à l'approbation d'un rôle et aux affectations « Période
  // d'essai »). Durée = valeur × unité (jour / mois / année) ; heure de fin optionnelle (HH:mm).
  essaiDureeValeur     Int            @default(7)
  essaiDureeUnite      String         @default("jour")
  essaiHeureFin        String?
  // Adresses e-mail (séparées par virgules / retours à la ligne) des utilisateurs expressément
  // habilités, EN PLUS de l'admin système, à voir les réductions disponibles et à instruire
  // les demandes de rabais de l'Académie Premium.
  emailsHabilitesRabais String?
  // Adresses e-mail des FORMATEURS DÉSIGNÉS : seuls accès (avec l'admin système) au document
  // de formation générale (manuel du formateur, Word) de l'espace Guides d'utilisateurs.
  emailsFormateurs      String?
  // Déconnexion automatique après INACTIVITÉ (réglée par l'admin système, appliquée à tous les
  // utilisateurs connectés). Le préavis déclenche l'alerte visuelle et sonore avant la coupure.
  inactiviteDeconnexionActive     Boolean @default(false)
  inactiviteDelaiMinutes          Int     @default(30)
  inactiviteAvertissementSecondes Int     @default(60)
  misAJourLe           DateTime       @updatedAt

  @@map("configuration")
}

/// Centre d'Animation et de Formation Pédagogique (cahier §3.1).
model Cafop {
  id       String  @id @default(cuid())
  nom      String
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  /// Fiche du centre (tableau de bord « Gestion des CAFOP »).
  code         String? // ex. « CAF-ABG-001 »
  pays         String  @default("Côte d'Ivoire")
  drena        String? // Direction Régionale (DRENA) de rattachement, ex. « Abengourou »
  localite     String? // localité / site du centre, ex. « Bouaké 1 »
  directeur    String? // nom du directeur du centre
  directeurTel String? // téléphone du directeur
  effectif     Int     @default(0) // nombre d'élèves-maîtres du centre

  /// Coordonnées du centre (en-tête gauche des bulletins de notes) — toutes facultatives.
  adresse   String? // adresse postale (ex. « BP 123 Abengourou »)
  telephone String? // téléphone du centre
  email     String? // e-mail du centre

  /// Documents officiels (Vercel Blob) — repli sur les armoiries nationales du pays si emblème absent.
  emblemeUrl   String? // armoiries du pays déposées
  logoUrl      String? // logo du CAFOP
  cachetUrl    String? // cachet du directeur
  signatureUrl String? // signature électronique du directeur

  utilisateurs    Utilisateur[]
  cohortes        Cohorte[]
  seances         SeanceCafop[]
  enseignants     EnseignantCafop[]
  profsPrincipaux ProfPrincipalCafop[]

  creeLe DateTime @default(now())

  @@index([regionId])
  @@map("cafops")
}

/// Enseignant d'un CAFOP (annuaire simple du centre : nom, prénoms, discipline).
model EnseignantCafop {
  id         String   @id @default(cuid())
  cafopId    String
  cafop      Cafop    @relation(fields: [cafopId], references: [id], onDelete: Cascade)
  nom        String
  prenoms    String?
  discipline String?
  creeLe     DateTime @default(now())

  principalDe ProfPrincipalCafop[]

  @@index([cafopId])
  @@map("enseignants_cafop")
}

/// Professeur principal d'un groupe-classe d'un CAFOP (renseigne le bulletin de notes).
model ProfPrincipalCafop {
  id           String          @id @default(cuid())
  cafopId      String
  cafop        Cafop           @relation(fields: [cafopId], references: [id], onDelete: Cascade)
  groupe       String // groupe-classe (ex. « B », « F2 »)
  enseignantId String
  enseignant   EnseignantCafop @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  creeLe       DateTime        @default(now())

  @@unique([cafopId, groupe])
  @@index([cafopId])
  @@index([enseignantId])
  @@map("prof_principaux_cafop")
}

/// Module de formation des élèves-maîtres (CAFOP) — matière évaluée dans les bulletins.
model ModuleCafop {
  id          String   @id @default(cuid())
  nom         String
  code        String?
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  coefficient Int      @default(1)
  /// Niveau de formation auquel le module est rattaché : 1re, 2e ou 3e année.
  annee       Int      @default(1)
  /// Semestre de dispensation du module (1 ou 2).
  semestre    Int?
  /// Jalons de planning du module.
  dateDebut      DateTime?
  dateFin        DateTime?
  datePretest    DateTime?
  dateEvaluation DateTime?
  /// Structure pédagogique : [{ nom (composante), themes: [nom] }] — cascade Module → Composante → Thème.
  /// Pour un STAGE, composantes et thèmes décrivent les HABILETÉS visées.
  composantes    Json?
  /// Vrai = STAGE PRATIQUE (enregistré comme module, rattaché à une année de formation) ;
  /// faux = module de formation théorique. Plusieurs stages possibles par année.
  estStage    Boolean  @default(false)
  creeLe      DateTime @default(now())

  notes        NoteCafop[]
  seances      SeanceCafop[]
  presences    PresenceCafop[]
  attributions AttributionStagiaire[]
  evaluations  EvaluationStage[]

  @@index([annee])
  @@map("modules_cafop")
}

/// Termes locaux désignant les CAFOP et les APFC, par pays (ex. « CAFOP »/« IFM », « APFC »/« ADEN »).
model ParametreCafopPays {
  pays      String   @id
  terme     String   @default("CAFOP")
  termeApfc String   @default("APFC")
  majLe     DateTime @default(now()) @updatedAt

  @@map("parametres_cafop_pays")
}

/// Plan de formation (Formation Initiale des Maîtres) — document national par pays et année scolaire,
/// consultable par tous les CAFOP et pour tous les niveaux de formation.
model PlanFormation {
  id                 String   @id @default(cuid())
  pays               String
  anneeScolaire      String
  titre              String   @default("Plan de formation — Formation Initiale des Maîtres")
  intro              String? // texte de présentation
  signataire         String? // ancien libellé complet (legacy) — remplacé par prénoms + nom
  signatairePrenoms  String?
  signataireNom      String?
  signataireFonction String? // ex. « Le Directeur des Écoles, Lycées et Collèges (DELC) »
  cachetUrl          String? // cachet du DELC (Vercel Blob)
  signatureUrl       String? // signature électronique du DELC (Vercel Blob)
  publie             Boolean  @default(true)
  creeLe             DateTime @default(now())
  majLe              DateTime @default(now()) @updatedAt

  sections SectionPlanFormation[]

  @@unique([pays, anneeScolaire])
  @@map("plans_formation")
}

/// Section d'un plan : tableau de volumes (niveau null = commun) ou plan chronologique d'un niveau (1/2/3).
model SectionPlanFormation {
  id       String        @id @default(cuid())
  planId   String
  plan     PlanFormation @relation(fields: [planId], references: [id], onDelete: Cascade)
  ordre    Int           @default(0)
  /// null = section commune (volumes) ; 1/2/3 = plan chronologique de ce niveau de formation.
  niveau   Int?
  titre    String
  intro    String?
  note     String? // ex. note sur le module TIC
  /// En-têtes de colonnes (tableau JSON de chaînes).
  colonnes Json

  lignes LignePlanFormation[]

  @@index([planId])
  @@map("sections_plan_formation")
}

/// Ligne d'une section : cellules alignées sur les colonnes, ou bannière pleine largeur.
model LignePlanFormation {
  id        String               @id @default(cuid())
  sectionId String
  section   SectionPlanFormation @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  ordre     Int                  @default(0)
  /// « donnee » (cellules), « banniere » (texte pleine largeur), « total » (ligne mise en avant).
  type      String               @default("donnee")
  /// Cellules alignées sur `colonnes` (tableau JSON de chaînes).
  cellules  Json
  /// Texte des bannières (congés, jalons…).
  texte     String?
  /// Ton visuel : conges | jalon | note | total | null.
  ton       String?

  @@index([sectionId])
  @@map("lignes_plan_formation")
}

/// Antenne Pédagogique de Formation Continue (cahier §3.1).
model Apfc {
  id       String  @id @default(cuid())
  nom      String
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  /// Fiche de l'antenne : chef d'antenne + documents officiels (Vercel Blob).
  /// Les armoiries du pays sont affichées automatiquement (référentiel pays, via region.pays) —
  /// pas de champ dédié, à la différence du CAFOP qui autorise un dépôt d'emblème personnalisé.
  chefAntenneNom     String?
  chefAntennePrenoms String?
  logoUrl            String?
  cachetUrl          String?
  signatureUrl       String?

  /// Coordonnées de l'antenne (formulaire « Nouvelle APFC » — maquette client) : code, localité,
  /// adresse, téléphone, e-mail, + contact du responsable d'antenne (son nom/prénoms = les colonnes
  /// chefAntenneNom / chefAntennePrenoms ci-dessus, réutilisées — pas de doublon).
  code               String?
  localite           String?
  adresse            String?
  telephone          String?
  email              String?
  chefAntenneContact String?

  utilisateurs Utilisateur[]
  cohortes     Cohorte[]
  personnel    PersonnelApfc[]
  /// Établissements sous compétence territoriale de cette antenne (bloc « Établissements couverts »).
  couvertures  CouvertureApfc[]
  /// Rapports bilans des Coordinations Régionales Disciplinaires (un par discipline).
  rapportsDisciplinaires RapportDisciplinaire[]
  /// Rapports narratifs de l'antenne (trimestriels et annuels).
  rapportsAntenne        RapportAntenne[]

  creeLe DateTime @default(now())

  @@index([regionId])
  @@map("apfc")
}

/// Personnel de l'APFC selon le profil disciplinaire (conseillers pédagogiques, formateurs…).
model PersonnelApfc {
  id       String @id @default(cuid())
  apfcId   String
  apfc     Apfc   @relation(fields: [apfcId], references: [id], onDelete: Cascade)
  nom      String
  prenoms  String?
  fonction String? // ex. « Conseiller pédagogique », « Formateur »
  /// Disciplines rattachées — choix multiples, noms rapprochés du référentiel Discipline
  /// (tableau JSON de chaînes ; entrées non reconnues à l'import conservées telles quelles).
  disciplines Json?
  email       String?
  telephone   String?
  creeLe      DateTime @default(now())

  @@index([apfcId])
  @@map("personnel_apfc")
}

/// Compétence territoriale d'une antenne (APFC) sur un établissement — un établissement ne
/// relève que d'UNE seule APFC (unicité sur `etablissementId`). Alimente le bloc « Établissements
/// couverts » de la fiche APFC (saisie manuelle par recherche + import CSV).
model CouvertureApfc {
  id              String        @id @default(cuid())
  apfcId          String
  apfc            Apfc          @relation(fields: [apfcId], references: [id], onDelete: Cascade)
  etablissementId String        @unique
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  creeLe          DateTime      @default(now())

  @@index([apfcId])
  @@map("couvertures_apfc")
}

/// Cohorte de formation : promotion d'élèves-maîtres (CAFOP) ou session de formation
/// continue (APFC). Rattachée à l'une des deux structures selon `type` (cahier partie 5).
model Cohorte {
  id        String        @id @default(cuid())
  type      TypeCohorte
  cafopId   String?
  cafop     Cafop?        @relation(fields: [cafopId], references: [id], onDelete: Cascade)
  apfcId    String?
  apfc      Apfc?         @relation(fields: [apfcId], references: [id], onDelete: Cascade)
  libelle   String
  anneeDebut Int?
  anneeFin   Int?
  dateDebut  DateTime?
  dateFin    DateTime?
  lieu       String?
  statut    StatutCohorte @default(active)

  /// Vue « Promotions » du tableau de bord CAFOP.
  nbCohortes  Int @default(1) // nombre de groupes/cohortes au sein de la promotion
  effectif    Int @default(0) // effectif d'élèves-maîtres de la promotion
  progression Int @default(0) // avancement de la formation, 0–100 (%)

  apprenants Apprenant[]

  creeLe DateTime @default(now())

  @@index([cafopId])
  @@index([apfcId])
  @@map("cohortes")
}

/// Apprenant d'une cohorte (élève-maître ou participant à une formation continue).
/// Simple enregistrement de liste (pas un compte Utilisateur) — alimenté par import CSV Moodle.
model Apprenant {
  id                   String   @id @default(cuid())
  cohorteId            String
  cohorte              Cohorte  @relation(fields: [cohorteId], references: [id], onDelete: Cascade)
  matricule            String?
  nom                  String
  prenoms              String?
  email                String?
  etablissementOrigine String?
  groupe               String? // classe pédagogique au sein de la promotion (ex. « F2 »)
  annee                Int? // année de formation : 1re, 2e ou 3e année
  /// Registre d'appel : sexe (« F »/« M »), date de naissance, téléphone (alerte SMS).
  sexe                 String?
  dateNaissance        DateTime?
  telephone            String?
  /// Photo d'identité (Vercel Blob) — recadrée 3:4 côté serveur (360×480 WebP), affichée sur le bulletin.
  photoUrl             String?
  creeLe               DateTime @default(now())

  notes      NoteCafop[]
  presences  PresenceCafop[]
  evenements EvenementPresenceCafop[]
  /// Stages pratiques : attribution à un maître d'application + suivi.
  attributionsStage AttributionStagiaire[]
  dialoguesStage    DialogueStage[]
  visitesStage      VisiteStagiaire[]
  evaluationsStage  EvaluationStage[]

  @@index([cohorteId])
  @@map("apprenants")
}

/// Séance du cahier de texte d'un CAFOP (module, groupe-classe, contenu enseigné).
model SeanceCafop {
  id       String       @id @default(cuid())
  cafopId  String
  cafop    Cafop        @relation(fields: [cafopId], references: [id], onDelete: Cascade)
  moduleId String?
  module   ModuleCafop? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  groupe   String?
  /// Cascade pédagogique : Module → Composante → Thème (sélection simple, historique).
  composante String?
  theme      String?
  /// Sélection MULTIPLE de composantes/thèmes (habiletés) — [texte]. Prioritaire sur les
  /// champs simples ci-dessus quand renseignée (stages pratiques notamment).
  composantes Json?
  themes      Json?
  discipline String?
  date       DateTime
  /// Horaires de la séance (format « HH:MM »).
  heureDebut String?
  heureFin   String?
  titre      String
  /// Sous-titres hiérarchisés : [{ niveau: 1|2|3, texte }].
  sousTitres Json?
  /// Objectifs de la séance : [texte].
  objectifs  Json?
  contenu    String? // résumé de la séance
  /// Date prévue de la prochaine séance.
  prochaineSeance DateTime?
  /// Exercices donnés (résumé, 500 caractères max).
  exercices    String?
  /// Lien du CAFOP en ligne communiqué pour les exercices (ex. https://cfpl2.eduweb.ci).
  exercicesUrl String?
  creeLe     DateTime @default(now())

  @@index([cafopId])
  @@map("seances_cafop")
}

/// Présence d'un élève-maître (registre d'appel CAFOP), un statut par jour.
model PresenceCafop {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  date        DateTime // normalisée à minuit (jour)
  statut      String    @default("present") // present | absent | retard
  /// Contexte de la séance et justification (registre d'appel enrichi).
  motif       String?
  justifie    Boolean      @default(false)
  heureSeance String? // créneau, ex. « 07h30 - 08h30 »
  moduleId    String?
  module      ModuleCafop? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// Contexte de la séance : discipline (plan de formation) et enseignant (compte « enseignant » du centre).
  discipline   String?
  enseignantId String?
  /// Sélection MULTIPLE de composantes/thèmes (habiletés) de la séance — [texte].
  composantes Json?
  themes      Json?
  creeLe      DateTime     @default(now())

  // Une présence par élève-maître, par jour ET par créneau (plusieurs séances possibles le même jour).
  @@unique([apprenantId, date, heureSeance])
  @@index([apprenantId])
  @@index([moduleId])
  @@map("presences_cafop")
}

/// Événement de conduite au registre d'appel CAFOP (encouragement, observation, infirmerie).
model EvenementPresenceCafop {
  id             String    @id @default(cuid())
  type           String // encouragement | observation | infirmerie
  apprenantId    String
  apprenant      Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  groupe         String?
  date           DateTime
  heureSeance    String?
  description    String
  accompagnateur String? // élève accompagnateur (infirmerie)
  saisiParId     String?
  creeLe         DateTime  @default(now())

  @@index([apprenantId])
  @@map("evenements_presence_cafop")
}

/// Note d'un élève-maître (CAFOP) dans un module, pour un semestre (bulletins).
model NoteCafop {
  id          String      @id @default(cuid())
  apprenantId String
  apprenant   Apprenant   @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  moduleId    String
  module      ModuleCafop @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type        String // type d'évaluation, ex. « Devoir surveillé », « Composition »
  valeur      Float
  bareme      Float       @default(20)
  coefficient Int         @default(1)
  semestre    Int         @default(1) // 1 ou 2
  /// Traçabilité : compte ayant saisi la note (id Utilisateur, sans FK — patron du module CAFOP).
  saisiParId  String?
  creeLe      DateTime    @default(now())

  @@index([apprenantId])
  @@index([moduleId])
  @@map("notes_cafop")
}

// ─────────────────────────────────────────────────────────────
//  Stages pratiques CAFOP : maîtres d'application, suivi des stagiaires,
//  évaluations et gouvernance des modifications de notes.
// ─────────────────────────────────────────────────────────────

/// Attribution d'un STAGIAIRE (élève-maître) à un MAÎTRE D'APPLICATION (compte au rôle
/// maitre_application, rattaché au CAFOP), décidée par le Directeur du CAFOP ou l'ADC.
/// Le maître ne voit QUE les stagiaires qui lui sont attribués. Le registre des maîtres
/// d'application par niveau (1re/2e/3e année) découle de ces attributions.
model AttributionStagiaire {
  id          String    @id @default(cuid())
  cafopId     String
  /// Année de formation du stagiaire au moment de l'attribution (1, 2 ou 3).
  annee       Int       @default(1)
  /// Compte Utilisateur du maître d'application (id sans FK — patron du module CAFOP).
  maitreId    String
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  /// Stage concerné (module estStage) — null = attribution générale pour l'année.
  moduleId    String?
  module      ModuleCafop? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// Directeur/ADC ayant décidé l'attribution (id Utilisateur, traçabilité).
  attribueParId String?
  creeLe        DateTime @default(now())

  @@unique([maitreId, apprenantId])
  @@index([cafopId, annee])
  @@index([maitreId])
  @@index([apprenantId])
  @@map("attributions_stagiaire")
}

/// Boîte de dialogues entre l'administration du CAFOP (Directeur/ADC) et le maître
/// d'application, pour le SUIVI d'un stagiaire — fil chronologique par stagiaire.
model DialogueStage {
  id          String    @id @default(cuid())
  cafopId     String
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  /// Auteur du message (id Utilisateur) ; duMaitre = écrit par le maître d'application.
  auteurId  String
  auteurNom String? // capture lisible même si le compte disparaît
  duMaitre  Boolean  @default(false)
  contenu   String
  creeLe    DateTime @default(now())

  @@index([apprenantId])
  @@index([cafopId])
  @@map("dialogues_stage")
}

/// Visite de classe d'un PROFESSEUR DE CAFOP à un stagiaire sur son lieu de stage.
model VisiteStagiaire {
  id          String    @id @default(cuid())
  cafopId     String
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  /// Professeur de CAFOP visiteur (nom depuis l'annuaire EnseignantCafop du centre).
  professeur  String
  date        DateTime
  ecole       String? // école d'application / lieu de stage
  objet       String?
  observations    String?
  recommandations String?
  noteGlobale     Float? // appréciation chiffrée éventuelle (/20)
  saisiParId String? // compte ayant saisi la visite (traçabilité)
  creeLe     DateTime @default(now())

  @@index([apprenantId])
  @@index([cafopId, date])
  @@map("visites_stagiaire")
}

/// Grille d'évaluation d'un stagiaire pour un STAGE (module estStage) : une grille par
/// évaluateur — le PROFESSEUR DE CAFOP d'une part, le MAÎTRE D'APPLICATION d'autre part.
model EvaluationStage {
  id          String      @id @default(cuid())
  cafopId     String
  apprenantId String
  apprenant   Apprenant   @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  moduleId    String
  module      ModuleCafop @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// « prof_cafop » | « maitre_application ».
  evaluateurType String
  evaluateurNom  String?
  /// Critères de la grille : [{ critere, note, sur }].
  criteres     Json
  noteGlobale  Float
  sur          Float    @default(20)
  appreciation String?
  saisiParId   String? // compte ayant saisi (traçabilité)
  creeLe       DateTime @default(now())
  majLe        DateTime @default(now()) @updatedAt

  @@unique([apprenantId, moduleId, evaluateurType])
  @@index([cafopId])
  @@index([apprenantId])
  @@map("evaluations_stage")
}

/// Gouvernance des MODIFICATIONS de notes (stage comme formation théorique) : toute
/// modification par un professeur de CAFOP ou un maître d'application doit être MOTIVÉE
/// et AUTORISÉE par le Directeur du CAFOP ou l'ADC — avec traçabilité complète
/// (valeur avant / valeur proposée, décideur, horodatages). Le Directeur/ADC consulte
/// toutes les productions en lecture seule et instruit ces demandes.
model DemandeModificationCafop {
  id      String @id @default(cuid())
  cafopId String
  /// Nature de la cible : « note_cafop » | « evaluation_stage ».
  type    String
  /// Id de l'enregistrement visé (NoteCafop / EvaluationStage).
  cibleId String
  /// Libellé lisible de la cible (apprenant, module…) — reste consultable même si la cible change.
  cibleLibelle String?
  demandeurId  String
  demandeurNom String?
  motif        String
  valeurAvant    Json?
  valeurProposee Json
  /// « en_attente » | « autorisee » | « refusee ».
  statut        String    @default("en_attente")
  decideParId   String?
  decideParNom  String?
  decideLe      DateTime?
  motifDecision String?
  creeLe        DateTime  @default(now())

  @@index([cafopId, statut])
  @@index([cibleId])
  @@map("demandes_modification_cafop")
}

// ─────────────────────────────────────────────────────────────
//  Vie scolaire — Phase 3
// ─────────────────────────────────────────────────────────────

/// Affectation d'un enseignant à une classe pour une discipline (cahier §3.1, §8.5).
model AffectationEnseignant {
  id           String      @id @default(cuid())
  enseignantId String
  enseignant   Utilisateur @relation("AffectationsEnseignant", fields: [enseignantId], references: [id], onDelete: Cascade)
  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline  @relation(fields: [disciplineId], references: [id])

  creeLe DateTime @default(now())

  @@unique([enseignantId, classeId, disciplineId])
  @@index([classeId])
  @@index([enseignantId])
  @@map("affectations_enseignant")
}

/// Inscription d'un élève à une classe pour une année scolaire (cahier §3.1, §8.5).
model Inscription {
  id      String      @id @default(cuid())
  eleveId String
  eleve   Utilisateur @relation("InscriptionsEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  classeId String
  classe   Classe     @relation(fields: [classeId], references: [id], onDelete: Cascade)

  anneeScolaireId String?
  anneeScolaire   AnneeScolaire? @relation(fields: [anneeScolaireId], references: [id])

  creeLe DateTime @default(now())

  @@unique([eleveId, anneeScolaireId])
  @@index([classeId])
  @@index([eleveId])
  @@index([creeLe])
  @@map("inscriptions")
}

/// Séance d'appel pour une classe à une date donnée (cahier §5.3.1).
model Appel {
  id           String      @id @default(cuid())
  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])
  date         DateTime // jour de la séance (normalisé à minuit UTC)
  heureSeance  String? // créneau de la séance, ex : « 07h30 - 08h30 » (filtre + heatmap)
  saisiParId   String
  saisiPar     Utilisateur @relation("AppelsSaisis", fields: [saisiParId], references: [id])

  presences Presence[]

  creeLe DateTime @default(now())

  @@index([classeId])
  @@index([date])
  @@index([classeId, date])
  @@index([creeLe])
  @@map("appels")
}

/// Présence d'un élève sur une séance d'appel (cahier §5.3.1).
model Presence {
  id          String         @id @default(cuid())
  appelId     String
  appel       Appel          @relation(fields: [appelId], references: [id], onDelete: Cascade)
  eleveId     String
  eleve       Utilisateur    @relation("Presences", fields: [eleveId], references: [id], onDelete: Cascade)
  statut      StatutPresence @default(present)
  commentaire String?
  motif       String? // motif d'absence / de retard (colonne MOTIF du registre)
  justifie    Boolean        @default(false) // absence/retard justifié auprès de l'établissement

  @@unique([appelId, eleveId])
  @@index([eleveId])
  @@map("presences")
}

/// Nature d'un événement de vie scolaire saisi depuis le registre d'appel.
enum TypeEvenementAppel {
  encouragement // valorise l'élève (bonus de conduite)
  observation // perturbation ou comportement inadapté (malus de conduite)
  infirmerie // admission à l'infirmerie (neutre pour la conduite)
}

/// Événement par élève saisi depuis le registre d'appel (colonne ACTIONS).
/// Encouragements et observations entrent dans la note de conduite.
model EvenementAppel {
  id      String             @id @default(cuid())
  type    TypeEvenementAppel
  eleveId String
  eleve   Utilisateur        @relation("EvenementsEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  classeId String
  classe   Classe            @relation(fields: [classeId], references: [id], onDelete: Cascade)
  date        DateTime // jour de la séance
  heureSeance String? // créneau de la séance
  description String // rédigée avec aide IA, ajustable par l'utilisateur
  accompagnateur String? // infirmerie : élève accompagnateur (optionnel)
  saisiParId String
  saisiPar   Utilisateur @relation("EvenementsSaisis", fields: [saisiParId], references: [id])

  creeLe DateTime @default(now())

  @@index([eleveId])
  @@index([classeId])
  @@map("evenements_appel")
}

/// Créneau d'emploi du temps généré (cahier §5.3.0). Noms dénormalisés pour un affichage direct.
model Creneau {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  classeId        String
  classeNom       String
  disciplineId    String
  disciplineNom   String
  enseignantId    String
  enseignantNom   String
  salleNom        String
  jour            Int // 0 = lundi … 5 = samedi
  periode         Int // index de période dans la journée
  duree           Int @default(1) // nombre de périodes
  anneeScolaireId String?
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([classeId])
  @@map("creneaux")
}

/// Autorisation d'absence d'un enseignant (permission / congé) saisie par l'établissement.
/// Alimente la heatmap des absences enseignants (consultation SEDEC/SENEC + établissement).
model AbsenceEnseignant {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  enseignantId    String
  enseignant      Utilisateur   @relation("AbsencesEnseignant", fields: [enseignantId], references: [id], onDelete: Cascade)
  date            DateTime // jour de l'absence (normalisé à minuit UTC)
  /// « journee » (défaut) | « matin » | « apres_midi » — nb de demi-journées : 2 si journée, 1 sinon.
  demiJournee     String        @default("journee")
  motif           String?
  /// « autorisee » (défaut) | « non_autorisee » | « justifiee »
  statut          String        @default("autorisee")
  saisiParId      String
  saisiPar        Utilisateur   @relation("AbsencesSaisies", fields: [saisiParId], references: [id])
  /// Demande d'autorisation d'absence approuvée à l'origine de cette absence (null si saisie manuelle).
  demandeAbsenceId String?
  demandeAbsence   DemandeAbsence? @relation(fields: [demandeAbsenceId], references: [id], onDelete: SetNull)
  creeLe          DateTime      @default(now())

  @@index([etablissementId])
  @@index([enseignantId])
  @@index([date])
  @@index([demandeAbsenceId])
  @@map("absences_enseignant")
}

/// Demande d'AUTORISATION d'absence d'un enseignant ou d'un autre personnel : workflow
/// demande → décision (ACE / Chef d'établissement) → fiche officielle. À l'approbation,
/// génère les enregistrements AbsenceEnseignant correspondants (heatmap + statistiques).
model DemandeAbsence {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  demandeurId     String
  demandeur       Utilisateur   @relation("DemandesAbsenceDemandeur", fields: [demandeurId], references: [id], onDelete: Cascade)
  /// Snapshot : le demandeur était enseignant au moment de la demande (pilote classes/suppléance).
  estEnseignant   Boolean       @default(false)
  dateDebut       DateTime // premier jour d'absence (minuit UTC)
  dateFin         DateTime // dernier jour d'absence (minuit UTC, inclus)
  motif           String?
  /// Snapshot JSON des classes/disciplines pédagogiques affectées, calculé depuis l'EDT à la
  /// soumission : [{ classeId, classeNom, disciplineId, disciplineNom, jours:number[], nbSeances }].
  classesAffectees Json?
  nbSeancesAffectees Int         @default(0)
  /// Couverture : true = suppléance choisie ; false = rattrapage prévu (ou personnel non enseignant).
  avecSuppleance  Boolean       @default(false)
  /// Snapshot JSON des suppléants choisis : [{ id, nom }].
  suppleants      Json?
  /// Snapshot JSON des dates de rattrapage prévues (ISO « yyyy-mm-dd ») quand pas de suppléance.
  datesRattrapage Json?
  /// « en_attente » (défaut) | « approuvee » | « refusee ».
  statut          String        @default("en_attente")
  decisionParId   String?
  decisionPar     Utilisateur?  @relation("DemandesAbsenceDecideur", fields: [decisionParId], references: [id])
  decisionLe      DateTime?
  motifDecision   String?
  creeLe          DateTime      @default(now())
  absencesGenerees AbsenceEnseignant[]

  @@index([etablissementId])
  @@index([demandeurId])
  @@index([statut])
  @@map("demandes_absence")
}

/// Note d'évaluation d'un élève dans une discipline, pour une période (cahier §5.3.4).
model Note {
  id           String      @id @default(cuid())
  eleveId      String
  eleve        Utilisateur @relation("NotesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline  @relation(fields: [disciplineId], references: [id])

  libelle    String // ex : « Devoir 1 », « Composition »
  valeur     Float
  sur        Float  @default(20)
  periode    Int    @default(1) // 1..3 (trimestre) ou 1..2 (semestre)
  saisiParId String
  saisiPar   Utilisateur @relation("NotesSaisies", fields: [saisiParId], references: [id])

  creeLe DateTime @default(now())

  @@index([classeId])
  @@index([eleveId])
  @@index([disciplineId])
  @@index([creeLe])
  @@map("notes")
}

/// Entrée du cahier de texte : contenu d'une séance et travail à faire, consigné par
/// l'enseignant pour une classe/discipline à une date donnée (cahier §5.3.2).
/// Statut d'une séance du cahier de texte.
enum StatutSeanceCahier {
  brouillon
  publie
}

/// Statut d'une demande d'accès à une séance (parents, conseillers pédagogiques…).
enum StatutDemandeAcces {
  en_attente
  accordee
  refusee
}

model CahierTexte {
  id           String      @id @default(cuid())
  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline  @relation(fields: [disciplineId], references: [id])
  date         DateTime // jour de la séance (normalisé à minuit UTC)

  statut       StatutSeanceCahier @default(publie)
  titre        String? // titre de la leçon / séance
  heureDebut   String? // « 07:30 »
  dureeMin     Int?
  typeActivite String? // Cours, TD, TP, Évaluation…
  amorce       String? // situation d'amorce
  sousTitres   Json? // [{ niveau: 1..4, texte }] — plan hiérarchique de la séance
  contenu      String // résumé de la séance / leçon traitée
  activitesApprentissage Json? // [texte]
  activitesEvaluation    Json? // [texte]
  prochaineSeanceLe      DateTime?
  travailAFaire String? // devoirs / travail à faire à la maison

  enseignantId String?
  enseignant   Utilisateur? @relation("SeancesEnseignant", fields: [enseignantId], references: [id], onDelete: SetNull)
  saisiParId String
  saisiPar   Utilisateur @relation("CahiersSaisis", fields: [saisiParId], references: [id])

  demandesAcces DemandeAccesCahier[]

  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  @@index([classeId])
  @@index([disciplineId])
  @@index([date])
  @@index([statut])
  @@index([creeLe])
  @@map("cahier_texte")
}

/// Demande d'accès d'un parent / conseiller à une séance du cahier de texte,
/// à valider par l'équipe pédagogique (colonne « Demandes d'accès » de la page).
model DemandeAccesCahier {
  id          String             @id @default(cuid())
  cahierId    String
  cahier      CahierTexte        @relation(fields: [cahierId], references: [id], onDelete: Cascade)
  demandeurId String
  demandeur   Utilisateur        @relation("DemandesAccesCahier", fields: [demandeurId], references: [id], onDelete: Cascade)
  statut      StatutDemandeAcces @default(en_attente)
  creeLe      DateTime           @default(now())
  traiteLe    DateTime?

  @@index([cahierId])
  @@index([statut])
  @@map("demandes_acces_cahier")
}

/// Notification in-app destinée à un utilisateur (socle commun, cahier §5.3.x).
/// Tout module crée une notification via `creerNotification` (src/lib/notifications).
model Notification {
  id             String           @id @default(cuid())
  destinataireId String
  destinataire   Utilisateur      @relation("NotificationsRecues", fields: [destinataireId], references: [id], onDelete: Cascade)
  type           TypeNotification @default(info)
  titre          String
  message        String
  lien           String? // route interne optionnelle (ex : « /app/mon-identification »)
  lu             Boolean          @default(false)
  luLe           DateTime?
  creeLe         DateTime         @default(now())

  @@index([destinataireId, lu])
  @@index([creeLe])
  @@map("notifications")
}

/// Message in-app entre deux utilisateurs (communication interne, cahier partie 5/7).
model Message {
  id             String      @id @default(cuid())
  expediteurId   String
  expediteur     Utilisateur @relation("MessagesEnvoyes", fields: [expediteurId], references: [id], onDelete: Cascade)
  destinataireId String
  destinataire   Utilisateur @relation("MessagesRecus", fields: [destinataireId], references: [id], onDelete: Cascade)
  contenu        String
  lu             Boolean     @default(false)
  creeLe         DateTime    @default(now())

  @@index([expediteurId])
  @@index([destinataireId, lu])
  @@index([creeLe])
  @@map("messages")
}

/// Code promotionnel applicable à un abonnement Premium (cahier partie 7 — Académie Premium).
model CodePromo {
  id          String   @id @default(cuid())
  code        String   @unique
  libelle     String
  pourcentage Int // remise en %
  partenaire  Boolean  @default(false) // taux préférentiel partenaire (IZEN, E-School…)
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())

  abonnements AbonnementPremium[]

  @@map("codes_promo")
}

/// Demande d'un code promo / de rabais, instruite par l'administrateur ou un utilisateur
/// expressément habilité (« Approbations de codes promos », bloc Académie Premium).
model DemandeCodePromo {
  id               String             @id @default(cuid())
  demandeurId      String
  demandeur        Utilisateur        @relation("DemandesPromo", fields: [demandeurId], references: [id], onDelete: Cascade)
  etablissementNom String?
  motif            String
  /// Taux de rabais SOUHAITÉ par le demandeur (%) — « expression du taux de rabais ».
  tauxDemande      Int?
  statut           StatutDemandePromo @default(en_attente)
  codeAttribue     String?
  /// Taux effectivement ACCORDÉ à l'approbation (%) — prédéfini ou fixé librement (incrément).
  tauxAccorde      Int?
  traiteLe         DateTime?
  creeLe           DateTime           @default(now())

  @@index([statut])
  @@map("demandes_code_promo")
}

/// Abonnement à l'Académie Premium pour un établissement (mode démo : paiement simulé).
model AbonnementPremium {
  id                   String           @id @default(cuid())
  etablissementId      String?
  etablissement        Etablissement?   @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  souscritParId        String
  souscritPar          Utilisateur      @relation("AbonnementsSouscrits", fields: [souscritParId], references: [id], onDelete: Cascade)
  formule              FormulePremium
  montantBase          Int // FCFA
  codePromoId          String?
  codePromo            CodePromo?       @relation(fields: [codePromoId], references: [id])
  pourcentageReduction Int              @default(0)
  montantFinal         Int // FCFA après remise
  modePaiement         ModePaiement
  statut               StatutAbonnement @default(en_attente)
  dateDebut            DateTime         @default(now())
  dateFin              DateTime
  creeLe               DateTime         @default(now())

  commissionParrainage CommissionParrainage?

  @@index([etablissementId])
  @@map("abonnements_premium")
}

/// Devenir d'une commission de parrainage.
enum StatutCommission {
  acquise // due au parrain, en attente de versement ou de conversion en crédit
  versee // reversée par l'administrateur (hors plateforme : Mobile Money, espèces…)
  creditee // convertie en réduction sur un abonnement du parrain lui-même
  annulee // abonnement déclencheur annulé / remboursé → commission caduque
}

/// COMMISSION DE PARRAINAGE — 10 % de ce que paie un filleul, dû à son parrain, À CHAQUE
/// abonnement (récurrent). Une ligne PAR abonnement (unicité `abonnementId`) : le rejeu d'une
/// souscription ne crédite jamais deux fois. Montants dénormalisés pour survivre à toute
/// évolution ultérieure des tarifs.
model CommissionParrainage {
  id           String            @id @default(cuid())
  parrainId    String
  parrain      Utilisateur       @relation("CommissionParrain", fields: [parrainId], references: [id], onDelete: Cascade)
  filleulId    String
  filleul      Utilisateur       @relation("CommissionFilleul", fields: [filleulId], references: [id], onDelete: Cascade)
  abonnementId String            @unique
  abonnement   AbonnementPremium @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  montantBase  Int // montant réellement payé par le filleul (FCFA)
  taux         Int               @default(10) // pourcentage
  montant      Int // commission = arrondi(montantBase × taux / 100), en FCFA
  statut       StatutCommission  @default(acquise)
  // Règlement (versement admin OU conversion en crédit) — dénormalisé, comme le journal d'audit.
  regleLe        DateTime?
  regleParEmail  String?
  reference      String? // n° de transaction Mobile Money, ou abonnement crédité
  creeLe       DateTime          @default(now())

  @@index([parrainId, statut])
  @@index([filleulId])
  @@map("commissions_parrainage")
}

/// Alerte SMS envoyée à un parent (un enregistrement par destinataire).
/// Champs dénormalisés : l'historique survit à la suppression des entités liées.
model AlerteSMS {
  id               String        @id @default(cuid())
  /// Établissement émetteur (cloisonnement de l'historique par périmètre). Null pour les
  /// alertes issues d'un CAFOP ou pour les anciennes lignes non rattachables par leur nom.
  etablissementId  String?
  etablissement    Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  /// Pays émetteur (établissement ou CAFOP) — cloisonnement inter-pays même sans FK établissement.
  pays             String?
  /// Nom de la structure émettrice, conservé pour l'affichage et l'historique (établissement ou CAFOP).
  etablissementNom String?
  telephone        String
  contenu          String
  type             TypeAlerteSMS @default(info)
  statut           StatutSMS     @default(simule)
  envoyeParEmail   String?
  creeLe           DateTime      @default(now())

  @@index([creeLe])
  @@index([etablissementId])
  @@index([pays])
  @@map("alertes_sms")
}

/// Paramétrage des alertes automatiques d'un établissement (page Alertes & SMS) : seuils de
/// déclenchement, canaux activés et modèles de message (variables {NOM_PARENT} {PRENOM} {CLASSE}
/// {NB} {TEL_ETAB}). Un enregistrement par établissement. Le moteur d'alertes lit ce paramétrage,
/// calcule les compteurs depuis le registre d'appel et les notes, puis envoie les SMS correspondants.
model ParametrageAlertesSMS {
  etablissementId   String        @id // scalaire (cf. JournalActivite) — pas de back-relation à ajouter
  // Seuils (0 = désactivé)
  seuilAbsences     Int           @default(3) // absences NON justifiées
  seuilRetards      Int           @default(5) // retards NON justifiés
  seuilNote         Int           @default(0) // moyenne /20 en dessous de laquelle alerter (0 = désactivé)
  // Canaux (seul le SMS est transmis aujourd'hui ; les autres sont des drapeaux prêts à brancher)
  canalSms          Boolean       @default(true)
  canalEmail        Boolean       @default(false)
  canalInApp        Boolean       @default(false)
  canalWhatsApp     Boolean       @default(false)
  // Modèles de message (variables de fusion)
  modeleAbsence     String        @default("EduWeb Planner — {CLASSE} : votre enfant {PRENOM} totalise {NB} absence(s) non justifiée(s). Merci de régulariser auprès de l'établissement.")
  modeleRetard      String        @default("EduWeb Planner — {CLASSE} : {PRENOM} cumule {NB} retard(s) non justifié(s). Merci d'y veiller.")
  modeleNotes       String        @default("EduWeb Planner — {CLASSE} : la moyenne de {PRENOM} est de {NB}/20. Un accompagnement est conseillé.")
  telEtablissement  String? // {TEL_ETAB} inséré dans les messages
  majLe             DateTime      @updatedAt

  @@map("parametrages_alertes_sms")
}

/// Nature d'un événement de trafic du site (≠ TypeVisite du module Inspection).
enum TypeTraficSite {
  visite // chargement de la plateforme par un navigateur (1 fois par session)
  connexion // authentification réussie
}

/// Trafic du site — compteur de visites + connexions (widget temps réel de l'accueil).
model VisiteSite {
  id     String         @id @default(cuid())
  type   TypeTraficSite
  chemin String?
  creeLe DateTime       @default(now())

  @@index([creeLe])
  @@index([type])
  @@map("visites_site")
}

/// Rendez-vous entre un demandeur (parent/personnel) et un destinataire (personnel).
model RendezVous {
  id             String           @id @default(cuid())
  demandeurId    String
  demandeur      Utilisateur      @relation("RdvDemandes", fields: [demandeurId], references: [id], onDelete: Cascade)
  destinataireId String
  destinataire   Utilisateur      @relation("RdvRecus", fields: [destinataireId], references: [id], onDelete: Cascade)
  date           DateTime
  motif          String
  statut         StatutRendezVous @default(demande)
  creeLe         DateTime         @default(now())

  @@index([demandeurId])
  @@index([destinataireId])
  @@map("rendez_vous")
}

/// Visite d'inspection d'un établissement (et éventuellement d'un enseignant) — cahier partie 6.
model Visite {
  id              String        @id @default(cuid())
  inspecteurId    String
  inspecteur      Utilisateur   @relation("VisitesInspecteur", fields: [inspecteurId], references: [id])
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  enseignantId    String?
  enseignant      Utilisateur?  @relation("VisitesEnseignant", fields: [enseignantId], references: [id])
  /// Classe pédagogique objet de la visite (types classe/suivi). PAS de relation Prisma :
  /// les classes sont recréées à chaque année scolaire — on garde l'id (jointure possible)
  /// ET le nom dénormalisé `classeNom` pour un affichage robuste même si la classe disparaît.
  classeId  String?
  classeNom String?

  date        DateTime
  /// Créneau de la séance visitée, ex. « 07h30 - 08h25 » (choisi sur l'EDT de l'enseignant).
  heureSeance String?
  type        TypeVisite   @default(classe)
  /// « programmee » (annoncée : la direction et l'enseignant sont notifiés) |
  /// « inopinee » (non annoncée : AUCUNE notification à l'établissement).
  modalite    String       @default("programmee")
  statut      StatutVisite @default(planifiee)
  objet       String
  observations String?
  noteGlobale Float? // appréciation globale /20

  recommandations Recommandation[]
  /// Grille de supervision officielle remplie en ligne pour cette visite (au plus une).
  grille          GrilleSupervision?

  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  @@index([inspecteurId])
  @@index([etablissementId])
  @@map("visites")
}

/// Recommandation issue d'une visite d'inspection, avec suivi de traitement.
model Recommandation {
  id       String                 @id @default(cuid())
  visiteId String
  visite   Visite                 @relation(fields: [visiteId], references: [id], onDelete: Cascade)
  texte    String
  priorite PrioriteRecommandation @default(moyenne)
  statut   StatutRecommandation   @default(ouverte)
  echeance DateTime?
  creeLe   DateTime               @default(now())

  @@index([visiteId])
  @@map("recommandations")
}

/// Grille de supervision des professeurs du secondaire (référentiel officiel MENA — données
/// dans `src/lib/inspection/grille-supervision.ts`) remplie EN LIGNE pour une visite
/// d'inspection : au plus UNE grille par visite (unicité sur `visiteId`).
/// `reponses` : JSON { "1.1-a": "TS", … } — clé d'indicateur → code d'appréciation coché
/// (TS/S/P/I), les indicateurs non appréciés sont absents.
/// `seance` : volet « séance observée » (nature, titre, durée, effectifs filles/garçons +
/// présentes/présents) — champs non portés par le modèle Visite.
model GrilleSupervision {
  id       String @id @default(cuid())
  visiteId String @unique
  visite   Visite @relation(fields: [visiteId], references: [id], onDelete: Cascade)

  reponses Json  @default("{}")
  seance   Json?

  // Synthèse de la supervision (rubriques de fin de grille officielle).
  pointsForts     String?
  pointsAmeliorer String?
  propositions    String?

  /// Dernier utilisateur ayant enregistré la grille (conservée si le compte disparaît).
  rempliParId String?
  rempliPar   Utilisateur? @relation("GrillesSupervisionRempliPar", fields: [rempliParId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([rempliParId])
  @@map("grilles_supervision")
}

/// Rapport bilan narratif de la Coordination Régionale Disciplinaire (CRD) d'une antenne APFC —
/// modèle officiel « Rapport bilan CRD » fourni par le client, rempli EN LIGNE sur la page
/// « Rapports Pédagogiques Disciplinaires » : au plus UN rapport par couple (antenne, discipline).
/// `contenu` : structure complète du rapport (membres, introduction, tableaux d'activités et de
/// programmes — lignes/valeurs —, analyse en 3 volets, conclusion, coordinateur) — voir le module
/// pur `src/lib/inspection/rapport-disciplinaire.ts` (seule source de vérité de la structure).
model RapportDisciplinaire {
  id         String @id @default(cuid())
  apfcId     String
  apfc       Apfc   @relation(fields: [apfcId], references: [id], onDelete: Cascade)
  discipline String
  titre      String?
  contenu    Json

  /// Dernier utilisateur ayant enregistré le rapport (conservé si le compte disparaît).
  rempliParId String?
  rempliPar   Utilisateur? @relation("RapportsDisciplinairesRempliPar", fields: [rempliParId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@unique([apfcId, discipline])
  @@index([rempliParId])
  @@map("rapports_disciplinaires")
}

/// Rapport narratif d'ANTENNE (APFC) — modèles officiels « Rapport trimestriel » et « Rapport
/// annuel » du client, remplis EN LIGNE sur la page « Rapports d'antennes » : au plus UN
/// rapport par (antenne, type, période). `type` : "trimestriel" | "annuel" ; `periode` :
/// « 2025-2026-T1 » (trimestriel) ou « 2025-2026 » (annuel). `contenu` : structure complète
/// (introduction, tableaux d'activités, programmes — dont matrices par discipline —, analyse,
/// conclusion, configuration libre, en-tête) — voir le module pur
/// src/lib/inspection/rapport-antenne.ts (seule source de vérité de la structure).
model RapportAntenne {
  id      String @id @default(cuid())
  apfcId  String
  apfc    Apfc   @relation(fields: [apfcId], references: [id], onDelete: Cascade)
  type    String
  periode String
  titre   String?
  contenu Json

  /// Dernier utilisateur ayant enregistré le rapport (conservé si le compte disparaît).
  rempliParId String?
  rempliPar   Utilisateur? @relation("RapportsAntenneRempliPar", fields: [rempliParId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@unique([apfcId, type, periode])
  @@index([rempliParId])
  @@map("rapports_antennes")
}

/// Modèle PERSONNEL de rapport d'un utilisateur : sa CONFIGURATION réutilisable (en-tête
/// personnalisé, sections masquées, sections libres et zones types, titre type) — jamais les
/// données d'instance (tableaux chiffrés, membres, textes du rapport). Un modèle par
/// utilisateur et par type de rapport (`typeRapport` : « crd » pour l'instant — champ
/// générique pour étendre plus tard aux autres rapports). Structure décrite par
/// `StructureModele` (module pur src/lib/inspection/rapport-disciplinaire.ts).
model ModeleRapport {
  id             String      @id @default(cuid())
  typeRapport    String
  proprietaireId String
  proprietaire   Utilisateur @relation("ModelesRapportProprietaire", fields: [proprietaireId], references: [id], onDelete: Cascade)
  structure      Json

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@unique([proprietaireId, typeRapport])
  @@map("modeles_rapports")
}

// ─────────────────────────────────────────────────────────────
//  Audit
// ─────────────────────────────────────────────────────────────

/// Trace d'une action effectuée sur la plateforme (audit, cahier §5.2.13).
/// Pas de FK vers Utilisateur : l'audit doit survivre à la suppression d'un compte.
/// Journal d'activité UNIFIÉ de la plateforme (traçabilité de TOUTES les activités).
/// Alimenté par trois sources (champ `source`) :
///  - "auto"     : extension Prisma qui intercepte chaque écriture (create/update/delete) — la
///                 GARANTIE de couverture : aucune action ne peut « oublier » de tracer.
///  - "metier"   : appels explicites à journaliserActivite() pour des évènements métier riches.
///  - "securite" : évènements de sécurité (connexion, échec, déconnexion, mot de passe, 2FA, rôles).
/// Table append-only : jamais d'update/delete applicatif (l'historique est immuable).
model JournalActivite {
  id              String   @id @default(cuid())
  utilisateurId   String?
  acteurEmail     String? // capture lisible même si le compte est supprimé ensuite
  acteurRole      String? // rôle effectif de l'acteur au moment de l'action
  etablissementId String? // périmètre : permet de cloisonner la consultation du journal
  action          String // ex : "demande_role.approuvee", "note.create", "securite.connexion"
  operation       String? // create | update | updateMany | delete | deleteMany | upsert | securite | metier
  entite          String? // modèle concerné (ex : "Note", "MouvementStock")
  entiteId        String?
  cible           String? // ex : "Utilisateur:cuid"
  ancienneValeur  Json? // état avant (renseigné par les appels métier ; absent en capture auto)
  nouvelleValeur  Json? // donnée écrite (caviardée : mots de passe / jetons jamais journalisés)
  details         Json?
  ip              String?
  navigateur      String?
  source          String   @default("metier") // auto | metier | securite
  /// MODE ASSISTANCE : administrateur RÉEL ayant agi en lieu et place du compte ci-dessus.
  /// `utilisateurId`/`acteurEmail` = compte AFFECTÉ (la cible) ; `operateur*` = qui a réellement
  /// agi. Un `operateurId` NON NUL identifie donc une action d'assistance.
  operateurId     String?
  operateurEmail  String?
  operateurRole   String?
  creeLe          DateTime @default(now())

  @@index([utilisateurId])
  @@index([action])
  @@index([creeLe])
  @@index([etablissementId])
  @@index([entite])
  @@index([etablissementId, creeLe])
  @@index([operateurId, creeLe])
  @@map("journal_activite")
}

/// PRÉSENCE — page touchée par un utilisateur (balise de navigation côté client : une ligne
/// par changement de page, chemin SANS paramètres de requête). Alimente le détail de la page
/// « Utilisateurs connectés » ; écrite en BRUT (hors journal d'activité RGPD — la navigation
/// n'est pas une « action ») et purgée après 13 mois par le cron purge-journal.
model AccesPage {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation("AccesPages", fields: [utilisateurId], references: [id], onDelete: Cascade)
  chemin        String
  date          DateTime    @default(now())

  @@index([utilisateurId, date])
  @@index([date])
  @@map("acces_pages")
}

/// Anti-force-brute de la connexion (fenêtre glissante) : compteur d'échecs par e-mail. Au-delà
/// d'un seuil dans la fenêtre, la connexion de ce compte est temporairement bloquée. Réinitialisé
/// à la première connexion réussie. Écrit via le client de base (hors traçabilité).
model TentativeConnexion {
  email        String    @id
  echecs       Int       @default(0)
  fenetreDebut DateTime  @default(now())
  bloqueJusqua DateTime?
  majLe        DateTime  @updatedAt

  @@map("tentatives_connexion")
}

// ─────────────────────────────────────────────────────────────
//  LMS « Aide et Formation » (Phase 1) — cours e-learning + sessions
//  Contenu géré par l'admin système. `type`/`format`/`statut` sont des String
//  (volontairement extensibles : ajouter une valeur ne nécessite pas de migration).
// ─────────────────────────────────────────────────────────────

/// Catégorie de la bibliothèque de formation (ex. « Prise en main », « Emplois du temps »).
model CategorieFormation {
  id          String   @id @default(cuid())
  nom         String
  description String?
  icone       String? // nom d'icône lucide (affichage)
  ordre       Int      @default(0)
  creeLe      DateTime @default(now())

  cours Cours[]

  @@map("categories_formation")
}

/// Département de l'organisation EduWeb Planner — présenté sur la page d'accueil
/// (« Nos départements ») et géré depuis Système › Départements (admin système).
model Departement {
  id          String   @id @default(cuid())
  nom         String
  description String?
  /// Regroupement pour les onglets de la page d'accueil (ex : produit, pedagogie, support, pilotage).
  categorie   String   @default("general")
  /// Nom d'icône lucide-react (ex : « Compass », « GraduationCap »).
  icone       String?
  /// Accent de la carte : « forest » | « gold ».
  couleur     String   @default("forest")
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())
  majLe       DateTime @updatedAt

  @@index([actif, ordre])
  @@map("departements")
}

/// Cours / parcours de formation à l'utilisation de la plateforme.
model Cours {
  id           String              @id @default(cuid())
  titre        String
  slug         String              @unique
  description  String?
  categorieId  String?
  categorie    CategorieFormation? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  imageUrl     String?
  niveau       String? // « debutant » | « intermediaire » | « avance »
  publicCible  String[] // identifiants de rôles visés (vide = tous)
  statut       String              @default("brouillon") // « brouillon » | « publie »
  ordre        Int                 @default(0)
  dureeMinutes Int? // durée estimée cumulée (indicative)
  seuilCompletion       Int     @default(100) // % de leçons requis pour valider le cours et débloquer l'attestation
  progressionSequentielle Boolean @default(false) // module verrouillé tant que le précédent n'est pas validé
  estGuide              Boolean @default(false) // « Guide d'utilisation » (figure sur « Guides d'utilisateurs ») vs formation (sur « Formations »)
  attestationSignataire String? // nom du signataire figurant sur l'attestation
  attestationFonction   String? // fonction / titre du signataire
  attestationMention    String? // mention libre affichée sur l'attestation
  creeLe       DateTime            @default(now())
  misAJourLe   DateTime            @updatedAt

  modules      ModuleCours[]
  inscriptions InscriptionCours[]
  etapes       EtapeParcours[]
  tuteurs      TuteurCours[]
  pagesWiki    PageWiki[]

  @@index([categorieId])
  @@index([statut])
  @@map("cours")
}

/// Leçon d'un cours. `type` est un String (extensible : texte, vidéo, fichier, lien, …).
model ModuleCours {
  id           String   @id @default(cuid())
  coursId      String
  cours        Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)
  titre        String
  type         String   @default("texte") // « texte » | « video » | « fichier » | « lien »
  contenu      String? // texte riche (Markdown) OU URL (vidéo / lien)
  fichierUrl   String? // document déposé (Vercel Blob) pour type « fichier »
  fichierNom   String?
  ordre        Int      @default(0)
  dureeMinutes Int?
  creeLe       DateTime @default(now())

  progressions ProgressionModule[]
  quiz         Quiz?
  devoir       Devoir?

  @@index([coursId])
  @@map("modules_cours")
}

/// Inscription d'un utilisateur à un cours (+ progression globale).
model InscriptionCours {
  id               String      @id @default(cuid())
  utilisateurId    String
  utilisateur      Utilisateur @relation("InscriptionsCours", fields: [utilisateurId], references: [id], onDelete: Cascade)
  coursId          String
  cours            Cours       @relation(fields: [coursId], references: [id], onDelete: Cascade)
  statut           String      @default("en_cours") // « en_cours » | « termine »
  progressionPct   Int         @default(0)
  source           String      @default("auto") // « auto » (progression/quiz/devoir) | « nominative » (inscrit par un admin) | « session » (via une session)
  dateInscription  DateTime    @default(now())
  dateFin          DateTime?
  derniereActivite DateTime    @default(now())

  progressions ProgressionModule[]

  @@unique([utilisateurId, coursId])
  @@index([coursId])
  @@map("inscriptions_cours")
}

/// Paramétrage administrateur d'un séminaire / d'une formation figée (statique).
/// Sert à la couverture (bannière) affichée sur la carte ET au pré-remplissage du certificat.
model ConfigSeminaire {
  id                String   @id @default(cuid())
  slug              String   @unique // identifiant du séminaire, ex. « communication-pastorale »
  formateurs        String[] @default([]) // e-mails des formateurs habilités (pilotage des activités, zone « exploitation pédagogique »)
  couvertureUrl     String? // image de couverture / bannière (Vercel Blob)
  organisation      String? // organisation délivrant le certificat
  logoUrl           String? // logo du certificat
  formateur         String? // nom du formateur (pré-rempli)
  directeur         String? // nom du directeur / signataire
  directeurFonction String? // fonction du signataire
  signatureUrl      String? // signature scannée (Vercel Blob)
  cachetUrl         String? // cachet officiel (Vercel Blob)
  qrImageUrl        String? // image du QR de vérification
  dateSignature     String? // date de signature (ISO « AAAA-MM-JJ »)
  certificatModele  String? // identifiant du modèle de certificat choisi (cf. /certificats/modeles.json)
  lieu              String? // lieu de délivrance
  creeLe            DateTime @default(now())
  misAJourLe        DateTime @updatedAt

  @@map("config_seminaires")
}

/// Réponse nominative d'un participant à une activité de sondage d'un séminaire
/// (ex. « Sondage d'entrée » : un mot choisi + une idée saisie). Modifiable par l'auteur.
model ReponseSondage {
  id            String   @id @default(cuid())
  seminaire     String // slug du séminaire
  activite      String // identifiant d'activité, ex. « sondage-entree »
  utilisateurId String // auteur (réponse nominative, modifiable)
  mot           String? // mot choisi dans le nuage
  idee          String? // idée saisie (2e temps)
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt

  @@unique([seminaire, activite, utilisateurId])
  @@index([seminaire, activite])
  @@map("reponses_sondage")
}

/// État de partage d'une activité de sondage, piloté par le formateur
/// (nuage de mots partagé aux élèves, collecte d'idées ouverte).
model EtatSondage {
  id            String   @id @default(cuid())
  seminaire     String
  activite      String
  nuagePartage  Boolean  @default(false)
  ideesOuvertes Boolean  @default(false)
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt

  @@unique([seminaire, activite])
  @@map("etats_sondage")
}

/// Production nominative d'un participant à une activité de séminaire (auto-évaluation,
/// QCM, atelier, engagement). Visible du formateur dans l'« espace formateur ». Modifiable.
model ProductionSeminaire {
  id            String   @id @default(cuid())
  seminaire     String
  activite      String // « auto-evaluation » | « qcm » | « atelier-reformuler » | « atelier-corriger » | « engagement »
  utilisateurId String
  contenu       String? // texte ou JSON (bilan, score, réponse)
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt

  @@unique([seminaire, activite, utilisateurId])
  @@index([seminaire, activite])
  @@map("productions_seminaire")
}

/// Complétion d'une leçon par un apprenant inscrit.
model ProgressionModule {
  id             String           @id @default(cuid())
  inscriptionId  String
  inscription    InscriptionCours @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  moduleId       String
  module         ModuleCours      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  termine        Boolean          @default(false)
  dateCompletion DateTime?

  @@unique([inscriptionId, moduleId])
  @@index([moduleId])
  @@map("progressions_module")
}

/// Session de formation programmée (webinaire / atelier / présentiel) avec inscription en ligne.
model SessionFormation {
  id           String   @id @default(cuid())
  titre        String
  description  String?
  coursIds     String[] // cours associés (facultatif) — identifiants des cours liés
  format       String   @default("webinaire") // « webinaire » | « atelier » | « presentiel »
  animateur    String?
  dateDebut    DateTime
  dateFin      DateTime? // date & heure de fin (facultatif)
  dureeMinutes Int?
  lienVisio    String?
  lieu         String?
  placesMax    Int?
  publicCible  String[] // rôles visés (vide = tous)
  pays         String? // restreint à un pays (facultatif)
  statut       String   @default("planifiee") // « planifiee » | « terminee » | « annulee »
  creeLe       DateTime @default(now())

  inscriptions InscriptionSession[]
  invitations  InvitationFormation[]

  @@index([dateDebut])
  @@map("sessions_formation")
}

/// Inscription d'un utilisateur à une session de formation.
model InscriptionSession {
  id              String           @id @default(cuid())
  utilisateurId   String
  utilisateur     Utilisateur      @relation("InscriptionsSession", fields: [utilisateurId], references: [id], onDelete: Cascade)
  sessionId       String
  session         SessionFormation @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  statut          String           @default("inscrit") // « en_attente » | « inscrit » | « present » | « absent »
  dateInscription DateTime         @default(now())

  @@unique([utilisateurId, sessionId])
  @@index([sessionId])
  @@map("inscriptions_session")
}

/// Lien d'invitation à une session de formation : partageable, avec validation admin par
/// défaut, ou auto-validation si l'invité présente le code associé.
model InvitationFormation {
  id         String           @id @default(cuid())
  token      String           @unique @default(cuid()) // segment d'URL du lien d'invitation
  sessionId  String
  session    SessionFormation @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code       String? // code d'auto-validation (facultatif) — présenté par l'invité pour être validé immédiatement
  actif      Boolean          @default(true)
  expiration DateTime? // au-delà, le lien n'accepte plus d'inscription
  placesMax  Int? // plafond d'inscriptions via ce lien (facultatif)
  creeParId  String?
  creePar    Utilisateur?     @relation("InvitationsCreees", fields: [creeParId], references: [id], onDelete: SetNull)
  creeLe     DateTime         @default(now())

  @@index([sessionId])
  @@map("invitations_formation")
}

// ── LMS Phase 2 : évaluations (quiz) ──

/// Quiz d'évaluation rattaché à une leçon de type « quiz » (1:1). La leçon est validée
/// (progression) lorsque l'apprenant atteint le seuil de réussite.
model Quiz {
  id            String      @id @default(cuid())
  moduleId      String      @unique
  module        ModuleCours @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  consigne      String?
  seuilReussite Int         @default(70) // pourcentage minimal pour valider
  mode          String      @default("formatif") // « formatif » (feedback pédagogique) | « sommatif » (noté)
  revelationSolutions String @default("apres_tentative") // « jamais » | « apres_tentative » | « apres_reussite » | « toujours »
  verificationImmediate Boolean @default(true) // autoriser le bouton « Vérifier » par question (correction immédiate)
  creeLe        DateTime    @default(now())

  questions  QuestionQuiz[]
  tentatives TentativeQuiz[]

  @@map("quiz")
}

/// Question d'un quiz. `type` extensible (choix unique / multiple / vrai-faux).
model QuestionQuiz {
  id     String   @id @default(cuid())
  quizId String
  quiz   Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enonce     String
  type       String   @default("choix_unique") // « choix_unique » | « choix_multiple » | « vrai_faux »
  points     Int      @default(1)
  ordre      Int      @default(0)
  explication String? // correction / feedback détaillé, révélé selon la politique du quiz
  creeLe     DateTime @default(now())

  choix ChoixQuestion[]

  @@index([quizId])
  @@map("questions_quiz")
}

/// Choix (proposition de réponse) d'une question.
model ChoixQuestion {
  id         String       @id @default(cuid())
  questionId String
  question   QuestionQuiz @relation(fields: [questionId], references: [id], onDelete: Cascade)
  texte      String
  correct    Boolean      @default(false)
  ordre      Int          @default(0)
  apparie    String? // « association » : libellé de droite à relier ; « texte_a_trous » : alternatives (a|b) ; sinon null

  @@index([questionId])
  @@map("choix_question")
}

/// Tentative d'un apprenant à un quiz (score + réussite).
model TentativeQuiz {
  id            String      @id @default(cuid())
  quizId        String
  quiz          Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation("TentativesQuiz", fields: [utilisateurId], references: [id], onDelete: Cascade)
  score         Int
  scoreMax      Int
  pourcentage   Int
  reussi        Boolean
  reponses      Json? // instantané { questionId: [choixIds] }
  dateTentative DateTime    @default(now())

  @@index([quizId])
  @@index([utilisateurId])
  @@map("tentatives_quiz")
}

// ── LMS Phase 3 : parcours multi-cours + badges ──

/// Badge de reconnaissance décerné à la complétion d'un parcours (gamification).
model Badge {
  id          String   @id @default(cuid())
  nom         String
  description String?
  icone       String? // nom d'icône lucide (affichage)
  couleur     String   @default("gold") // jeton de teinte : « gold » | « forest » | « rose » | « bleu »
  creeLe      DateTime @default(now())

  parcours   Parcours[]
  obtentions BadgeObtenu[]

  @@map("badges")
}

/// Parcours = séquence ordonnée de cours ; sa complétion décerne un badge (facultatif).
model Parcours {
  id          String   @id @default(cuid())
  titre       String
  slug        String   @unique
  description String?
  niveau      String? // « debutant » | « intermediaire » | « avance »
  publicCible String[] // rôles visés (vide = tous)
  statut      String   @default("brouillon") // « brouillon » | « publie »
  ordre       Int      @default(0)
  badgeId     String?
  badge       Badge?   @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  creeLe      DateTime @default(now())
  misAJourLe  DateTime @updatedAt

  etapes       EtapeParcours[]
  inscriptions InscriptionParcours[]

  @@index([statut])
  @@map("parcours")
}

/// Étape d'un parcours : un cours à une position donnée (un cours peut figurer dans plusieurs parcours).
model EtapeParcours {
  id         String   @id @default(cuid())
  parcoursId String
  parcours   Parcours @relation(fields: [parcoursId], references: [id], onDelete: Cascade)
  coursId    String
  cours      Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)
  ordre      Int      @default(0)

  @@unique([parcoursId, coursId])
  @@index([parcoursId])
  @@index([coursId])
  @@map("etapes_parcours")
}

/// Inscription d'un apprenant à un parcours (+ progression agrégée sur les cours du parcours).
model InscriptionParcours {
  id               String      @id @default(cuid())
  utilisateurId    String
  utilisateur      Utilisateur @relation("InscriptionsParcours", fields: [utilisateurId], references: [id], onDelete: Cascade)
  parcoursId       String
  parcours         Parcours    @relation(fields: [parcoursId], references: [id], onDelete: Cascade)
  statut           String      @default("en_cours") // « en_cours » | « termine »
  progressionPct   Int         @default(0)
  dateInscription  DateTime    @default(now())
  dateFin          DateTime?
  derniereActivite DateTime    @default(now())

  @@unique([utilisateurId, parcoursId])
  @@index([parcoursId])
  @@map("inscriptions_parcours")
}

/// Badge obtenu par un apprenant (une seule fois par badge).
model BadgeObtenu {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation("BadgesObtenus", fields: [utilisateurId], references: [id], onDelete: Cascade)
  badgeId       String
  badge         Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  dateObtention DateTime    @default(now())

  @@unique([utilisateurId, badgeId])
  @@index([badgeId])
  @@map("badges_obtenus")
}

// ── LMS Phase 4-B : devoirs (dépôts corrigés par un tuteur) ──

/// Devoir rattaché à une leçon de type « devoir » (1:1) : dépôt texte et/ou fichier, corrigé par un tuteur.
model Devoir {
  id             String      @id @default(cuid())
  moduleId       String      @unique
  module         ModuleCours @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  consigne       String?
  accepteTexte   Boolean     @default(true)
  accepteFichier Boolean     @default(true)
  noteSur        Int         @default(20)
  dateLimite     DateTime?
  creeLe         DateTime    @default(now())

  soumissions SoumissionDevoir[]

  @@map("devoirs")
}

/// Dépôt d'un apprenant + correction du tuteur (note, appréciation ; l'observation IA est un brouillon éditable).
model SoumissionDevoir {
  id             String       @id @default(cuid())
  devoirId       String
  devoir         Devoir       @relation(fields: [devoirId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur  @relation("SoumissionsDevoir", fields: [utilisateurId], references: [id], onDelete: Cascade)
  texte          String?
  fichierUrl     String?
  fichierNom     String?
  statut         String       @default("soumis") // « soumis » | « corrige »
  note           Int?
  appreciation   String?
  correcteurId   String?
  correcteur     Utilisateur? @relation("CorrectionsDevoir", fields: [correcteurId], references: [id], onDelete: SetNull)
  dateSoumission DateTime     @default(now())
  dateCorrection DateTime?

  @@unique([devoirId, utilisateurId])
  @@index([devoirId])
  @@index([utilisateurId])
  @@map("soumissions_devoir")
}

/// Tuteur correcteur désigné pour un cours (compte existant, sans nouveau rôle global).
model TuteurCours {
  id            String      @id @default(cuid())
  coursId       String
  cours         Cours       @relation(fields: [coursId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation("TuteurCours", fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())

  @@unique([coursId, utilisateurId])
  @@index([utilisateurId])
  @@map("tuteurs_cours")
}

// ── LMS Phase 5 : travaux collaboratifs (wiki) ──

/// Page de travail collaboratif (wiki) d'un cours — contenu HTML riche SANITISÉ à l'enregistrement.
model PageWiki {
  id            String       @id @default(cuid())
  coursId       String
  cours         Cours        @relation(fields: [coursId], references: [id], onDelete: Cascade)
  titre         String
  contenu       String       @default("")
  creeParId     String?
  creePar       Utilisateur? @relation("PagesWikiCreees", fields: [creeParId], references: [id], onDelete: SetNull)
  misAJourParId String?
  misAJourPar   Utilisateur? @relation("PagesWikiModifiees", fields: [misAJourParId], references: [id], onDelete: SetNull)
  creeLe        DateTime     @default(now())
  misAJourLe    DateTime     @updatedAt

  revisions   RevisionWiki[]
  evaluations EvaluationWiki[]

  @@index([coursId])
  @@map("pages_wiki")
}

/// Révision (historique) d'une page wiki — instantané du contenu à chaque modification.
model RevisionWiki {
  id       String       @id @default(cuid())
  pageId   String
  page     PageWiki     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contenu  String
  auteurId String?
  auteur   Utilisateur? @relation("RevisionsWiki", fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe   DateTime     @default(now())

  @@index([pageId])
  @@map("revisions_wiki")
}

/// Évaluation d'une page wiki — par un PAIR (apprenant inscrit) ou par le FORMATEUR/TUTEUR.
model EvaluationWiki {
  id           String      @id @default(cuid())
  pageId       String
  page         PageWiki    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  evaluateurId String
  evaluateur   Utilisateur @relation("EvaluationsWiki", fields: [evaluateurId], references: [id], onDelete: Cascade)
  type         String // « pair » | « tuteur »
  note         Int? // sur 20 (facultative)
  commentaire  String?
  creeLe       DateTime    @default(now())
  misAJourLe   DateTime    @updatedAt

  @@unique([pageId, evaluateurId])
  @@index([pageId])
  @@map("evaluations_wiki")
}

/// Réponse ANONYME à l'enquête de satisfaction de fin de séminaire (accès public,
/// sans authentification). Notes de 1 à 5 (0 à 10 pour la recommandation) + champs libres.
model EnqueteSatisfaction {
  id                  String   @id @default(cuid())
  seminaire           String   @default("magnifica-humanitas")
  appreciationGlobale Int? // 1..5
  contenuClair        Int? // 1..5
  contenuPertinent    Int? // 1..5
  activitesUtiles     Int? // 1..5
  rythmeAdapte        Int? // 1..5
  navigationAisee     Int? // 1..5
  applicationConcrete Int? // 1..5
  usageResponsable    Int? // 1..5
  recommandation      Int? // 0..10 (indice de recommandation)
  pointsForts         String?
  pointsAmeliorer     String?
  suggestions         String?
  role                String?
  pays                String?
  creeLe              DateTime @default(now())

  @@index([seminaire, creeLe])
  @@map("enquetes_satisfaction")
}

// ─────────────────────────────────────────────────────────────
//  FINANCES DE L'ÉTABLISSEMENT (SRS Finance : scolarité, caisse
//  & banque, économat). Montants en FRANCS CFA entiers.
// ─────────────────────────────────────────────────────────────

/// Barème de frais (scolarité, inscription, cantine…) par niveau et année scolaire.
/// `tranches` = échéancier [{ libelle, montant, dateLimite? }] ; somme = montant.
model FraisScolarite {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  anneeScolaireId String?
  niveauId        String? // null = tous les niveaux de l'établissement
  libelle         String // ex : « Scolarité », « Droits d'inscription », « Cantine »
  montant         Int // FCFA
  devise          String @default("XOF") // RM-007 : devise de l'opération
  tranches        Json? // [{ libelle, montant, dateLimite? }]
  obligatoire     Boolean @default(true)
  actif           Boolean @default(true)
  // ── Sous-module Scolarité (06) : paramétrage enrichi du frais ──
  code            String? // code court du frais, ex : « INS », « SCO »
  description     String?
  categorieId     String?
  categorie       CategorieFrais? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  /// Série ciblée (ex : « C », « A2 ») — appariée au NOM du niveau/classe (le modèle Classe ne
  /// porte pas de colonne série) ; null = toutes séries.
  serie           String?
  cycle           String? // « prescolaire » | « primaire » | « college » | « lycee » (CycleNiveau) — null = tous
  /// Statut d'hébergement ciblé : « interne » | « externe » | « demi_pensionnaire » — null = tous.
  /// ⚠️ L'inscription ne porte pas encore ce statut : un frais ciblé n'est PAS généré (cf. 07/08).
  statutEleve     String?
  dateDebut       DateTime? // fenêtre de validité du frais (génération)
  dateFin         DateTime?
  /// « fixe » (défaut, tranches JSON possibles) | « mensuel » (9 échéances) | « trimestriel » (3)
  /// | « semestriel » (2) — répartition automatique à la génération si aucune tranche définie.
  modeCalcul      String @default("fixe")
  version         Int @default(0) // RM-019 : verrouillage optimiste
  annuleLe        DateTime? // RM-004 : annulation logique (jamais de suppression physique)
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsFraisScolarite", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  creances CreanceEleve[]

  @@index([etablissementId])
  @@index([categorieId])
  @@map("frais_scolarite")
}

/// Remise ou bourse accordée à un élève (montant fixe OU pourcentage d'un frais).
model RemiseEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("RemisesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  fraisId         String? // null = remise globale
  type            String @default("remise") // « remise » | « bourse »
  libelle         String
  montant         Int? // FCFA (exclusif du pourcentage)
  devise          String @default("XOF") // RM-007
  pourcentage     Int? // 1..100
  accordeParId    String?
  annuleLe        DateTime? // RM-004 : le retrait d'une remise est une annulation logique
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsRemiseEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([eleveId])
  @@map("remises_eleve")
}

// ─────────────────────────────────────────────────────────────
//  Sous-module SCOLARITÉ (docs/finance/06-Scolarite + 05B)
//  Créances, catégories de frais, exonérations, bourses, plans
//  de paiement, pénalités, avances, remboursements, blocages.
// ─────────────────────────────────────────────────────────────

/// Catégorie de frais (06) : classement des frais + PRIORITÉ D'IMPUTATION configurable
/// (ordre d'affectation des paiements/avances quand plusieurs créances sont ouvertes).
/// 4 catégories par défaut semées à la première utilisation par établissement.
model CategorieFrais {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom             String
  code            String?
  ordreImputation Int @default(0) // 1 = imputé en premier
  actif           Boolean @default(true)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCategorieFrais", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  frais FraisScolarite[]

  // L'unicité (etablissementId, nom) ne porte que sur les catégories ACTIVES : index unique
  // PARTIEL « WHERE annuleLe IS NULL » posé par la migration manuscrite 20260727090000
  // (une catégorie annulée peut être recréée sous le même nom).
  @@index([etablissementId, nom])
  @@map("categories_frais")
}

/// CRÉANCE d'un élève (06 — pièce structurante, prépare 07-Facturation) : montant dû généré
/// depuis un frais applicable (une créance par frais, ou par tranche/échéance du frais).
/// Statuts STOCKÉS : « generee » | « partiellement_payee » | « soldee » | « suspendue » |
/// « annulee » — « en_retard » est CALCULÉ à l'affichage (dateEcheance dépassée, non soldée).
model CreanceEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // ex : « 2025-2026 »
  eleveId         String
  eleve           Utilisateur   @relation("CreancesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  fraisId         String
  frais           FraisScolarite @relation(fields: [fraisId], references: [id], onDelete: Cascade)
  libelle         String // figé à la génération (ex : « Scolarité — Mensualité 3/9 »)
  montant         Decimal @db.Decimal(18, 2)
  devise          String @default("XOF")
  dateEcheance    DateTime?
  statut          String @default("generee")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCreanceEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  penalites     PenaliteEleve[]
  plansPaiement PlanPaiement[]
  lignesFacture LigneFacture[]

  @@index([etablissementId, exercice])
  @@index([eleveId, statut])
  @@index([fraisId])
  @@map("creances_eleve")
}

/// Exonération (06) : dispense totale ou partielle, sur un frais ou sur tout le compte,
/// avec décision, responsable et période de validité — historisée, annulable logiquement.
model ExonerationEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("ExonerationsEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  fraisId         String? // null = tous les frais (référence libre, comme RemiseEleve.fraisId)
  type            String // « totale » | « partielle »
  taux            Int? // 1..100 (exclusif du montant)
  montant         Int? // FCFA
  decision        String // référence/texte de la décision (obligatoire)
  responsableId   String?
  debut           DateTime @default(now())
  fin             DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsExonerationEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([eleveId])
  @@map("exonerations_eleve")
}

/// Bourse ou prise en charge (06) : nationale, privée, interne — pourcentage ou montant fixe,
/// éventuellement limitée à certains frais (fraisCibles = liste d'ids, null = tous).
model BourseEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("BoursesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  type            String // « nationale » | « privee » | « interne » | « prise_en_charge »
  organisme       String?
  taux            Int? // 1..100 (exclusif du montant fixe)
  montantFixe     Int? // FCFA
  fraisCibles     Json? // liste d'ids FraisScolarite ; null = tous les frais
  periode         String // exercice couvert, ex : « 2025-2026 »
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsBourseEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([eleveId])
  @@map("bourses_eleve")
}

/// Plan de paiement personnalisé (06) : échéancier négocié [{date, montant}] (≤ 36 échéances),
/// rattaché à une créance précise ou au compte de l'élève.
model PlanPaiement {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("PlansPaiementEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  creanceId       String?
  creance         CreanceEleve? @relation(fields: [creanceId], references: [id], onDelete: SetNull)
  libelle         String?
  echeances       Json // [{ date: "AAAA-MM-JJ", montant: number }] — bornées à 36
  statut          String @default("actif") // « actif » | « termine » | « annule »
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsPlanPaiement", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([eleveId])
  @@map("plans_paiement")
}

/// Règle de pénalité paramétrable (06) : déclencheur (retard/échéance/rejet), type
/// (fixe/pourcentage/intérêt journalier), valeur et délai de grâce en jours.
model ReglePenalite {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  declencheur     String // « retard » | « echeance » | « rejet »
  type            String // « fixe » | « pourcentage » | « interet_journalier »
  valeur          Decimal @db.Decimal(18, 2) // montant FCFA, ou taux (%) selon le type
  delaiJours      Int @default(0) // délai de grâce après l'échéance
  actif           Boolean @default(true)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsReglePenalite", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  penalites PenaliteEleve[]

  @@index([etablissementId])
  @@map("regles_penalites")
}

/// Pénalité appliquée à une créance en retard (06) — s'AJOUTE au solde de l'élève.
model PenaliteEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("PenalitesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  creanceId       String
  creance         CreanceEleve  @relation(fields: [creanceId], references: [id], onDelete: Cascade)
  regleId         String?
  regle           ReglePenalite? @relation(fields: [regleId], references: [id], onDelete: SetNull)
  montant         Int // FCFA
  statut          String @default("appliquee") // « appliquee » | « annulee »
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsPenaliteEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([eleveId])
  @@index([creanceId])
  @@map("penalites_eleve")
}

/// Avance / acompte d'un élève (06) : crédit disponible, imputé sur les créances ouvertes
/// selon l'ordre d'imputation des catégories. La trésorerie reconnaît les fonds à
/// l'IMPUTATION (création du reçu PaiementScolarite) — choix V1 documenté, revu en 07/08.
model AvanceEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("AvancesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  montant         Int // FCFA reçus
  solde           Int // FCFA restant à imputer
  mode            String @default("especes")
  reference       String?
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsAvanceEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([eleveId])
  @@map("avances_eleve")
}

/// Demande de remboursement (06) : workflow demande → validation/refus → paiement
/// (le paiement crée l'OperationFinanciere de décaissement, référencée par operationId).
model DemandeRemboursement {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("RemboursementsEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  paiementId      String?
  paiement        PaiementScolarite? @relation(fields: [paiementId], references: [id], onDelete: SetNull)
  montant         Int // FCFA
  motif           String
  statut          String @default("demandee") // « demandee » | « validee » | « refusee » | « payee »
  demandeParId    String?
  valideeParId    String?
  dateValidation  DateTime?
  operationId     String? // OperationFinanciere de décaissement créée au paiement
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDemandeRemboursement", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, statut])
  @@index([eleveId])
  @@map("demandes_remboursement")
}

/// Règle de blocage pédagogique (06) : CONFIGURATION + statut consultable uniquement en V1 —
/// l'application effective (impression bulletin, composition, réinscription, transport,
/// cantine) sera branchée dans les modules concernés lors des specs suivantes.
model RegleBlocage {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  type            String // « bulletin » | « composition » | « reinscription » | « transport » | « cantine »
  seuilImpaye     Decimal? @db.Decimal(18, 2) // null = tout impayé bloque
  actif           Boolean @default(true)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsRegleBlocage", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  // Unicité (etablissementId, type) limitée aux règles ACTIVES : index unique PARTIEL
  // « WHERE annuleLe IS NULL » posé par la migration manuscrite 20260727090000.
  @@index([etablissementId, type])
  @@map("regles_blocage")
}

// ─────────────────────────────────────────────────────────────
//  Sous-module FACTURATION (docs/finance/07-Facturation + 05B)
//  Factures & proformas, lignes (liées aux créances du 06),
//  avoirs, notes de débit — numérotation via les séquences de
//  la fondation (FAC/PRO/AVR/ND), cycle de vie historisé.
// ─────────────────────────────────────────────────────────────

/// FACTURE d'un élève (07) : document financier opposable adossé aux créances (06).
/// Statuts STOCKÉS : « brouillon » | « en_attente_validation » | « validee » | « emise » |
/// « partiellement_payee » | « soldee » | « suspendue » | « annulee » | « archivee » —
/// « en_retard » est CALCULÉ à l'affichage (échéance dépassée, non soldée). Chaque transition
/// est historisée au journal d'audit financier (RM-003/011). INVARIANT : une facture ÉMISE ne
/// se modifie plus — seules voies : avoir, note de débit, suspension, annulation logique
/// motivée (07 « une facture ne peut jamais être supprimée »).
model FactureEleve {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // ex : « 2025-2026 »
  eleveId         String
  eleve           Utilisateur   @relation("FacturesEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  /// « facture » | « proforma » (document informatif : numérotée PRO, exclue des agrégats et
  /// du suivi de paiement — 07 « aucune écriture comptable »).
  type            String @default("facture")
  /// Numéro attribué à l'ÉMISSION via les séquences de la fondation (RM-014) : FAC-2026-000123.
  /// Nul tant que la facture est en brouillon/attente/validée. Unicité des numéros ACTIFS par
  /// établissement : index unique PARTIEL posé par la migration manuscrite 20260729090000.
  numero          String?
  objet           String
  observations    String?
  // Totaux dénormalisés depuis les lignes (montants entiers FCFA, régime « aucune taxe » par
  // défaut — le paramétrage fiscal par établissement viendra avec son écran dédié).
  totalBrut       Int @default(0)
  totalRemises    Int @default(0)
  totalTaxes      Int @default(0)
  montantTotal    Int @default(0) // TTC = brut − remises + taxes
  statut          String @default("brouillon")
  motifAnnulation String?
  dateEmission    DateTime?
  dateEcheance    DateTime?
  dateValidation  DateTime? // RM-008 : posée à la validation
  creeParId       String?
  valideeParId    String?
  emiseParId      String?
  devise          String @default("XOF")
  dateComptable   DateTime? // posée à l'émission
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsFactureEleve", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes       LigneFacture[]
  avoirs       AvoirFacture[]
  notesDebit   NoteDebitFacture[]
  ventilations VentilationPaiement[]

  @@index([etablissementId, exercice])
  @@index([etablissementId, statut])
  @@index([eleveId, statut])
  @@map("factures_eleve")
}

/// Ligne de facture (07) : article, quantité, prix unitaire, remise, taxe, montant.
/// `creanceId` relie la ligne à une créance du 06 (articulation « toute facture représente
/// une créance ») : le PAYÉ de la facture se déduit de l'allocation des paiements aux
/// créances liées. Les lignes d'un BROUILLON se remplacent par annulation logique (RM-004).
model LigneFacture {
  id          String       @id @default(cuid())
  factureId   String
  facture     FactureEleve @relation(fields: [factureId], references: [id], onDelete: Cascade)
  creanceId   String?
  creance     CreanceEleve? @relation(fields: [creanceId], references: [id], onDelete: SetNull)
  libelle     String
  description String?
  quantite    Int @default(1)
  prixUnitaire Int
  remise      Int @default(0) // FCFA sur la ligne
  taxe        Int @default(0) // FCFA sur la ligne (régime « aucune taxe » par défaut)
  montant     Int // quantite × prixUnitaire − remise + taxe
  ordre       Int @default(0)
  annuleLe    DateTime?
  annuleParId String?
  annulePar   Utilisateur? @relation("AnnulationsLigneFacture", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe      DateTime @default(now())

  @@index([factureId])
  @@index([creanceId])
  @@map("lignes_facture")
}

/// AVOIR (07) : réduction (partiel) ou annulation commerciale (total) d'une facture ÉMISE —
/// motif obligatoire, numéroté AVR, historisé. Les contre-écritures comptables formelles
/// viendront avec 11-Comptabilité (notre comptabilité est calculée) : l'avoir réduit dès
/// maintenant le net dû de la facture dans tous les calculs.
model AvoirFacture {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  factureId       String
  facture         FactureEleve  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  numero          String // AVR-2026-000042 (séquences de la fondation)
  type            String // « partiel » | « total »
  montant         Int // FCFA
  motif           String
  creeParId       String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsAvoirFacture", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([factureId])
  @@map("avoirs_facture")
}

/// NOTE DE DÉBIT (07) : créance SUPPLÉMENTAIRE ajoutée à une facture émise (pénalité,
/// transport, cantine, activité exceptionnelle…) — numérotée ND, augmente le net dû.
model NoteDebitFacture {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  factureId       String
  facture         FactureEleve  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  numero          String // ND-2026-000007
  libelle         String
  montant         Int // FCFA
  motif           String?
  creeParId       String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsNoteDebitFacture", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([factureId])
  @@map("notes_debit_facture")
}

// ─────────────────────────────────────────────────────────────
//  Sous-module CAISSE (docs/finance/09-Caisse + 05B) : caisses
//  par établissement, sessions (ouverture → mouvements →
//  comptage → clôture), écarts validés par un second acteur,
//  mouvements internes de trésorerie. RM-500→505.
// ─────────────────────────────────────────────────────────────

/// CAISSE d'un établissement (09) : point d'encaissement physique ou virtuel.
/// Statut STOCKÉ : « active » | « suspendue » — « ouverte »/« fermée » est DÉRIVÉ de
/// l'existence d'une session ouverte (jamais stocké) ; « archivée » = annulation logique.
model CaisseEtablissement {
  id                String        @id @default(cuid())
  etablissementId   String
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom               String
  code              String?
  /// « physique » | « mobile_money » | « virtuelle » | « bancaire » (09 — types de caisses).
  type              String @default("physique")
  responsableId     String?
  responsable       Utilisateur? @relation("CaissesResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  /// Montant maximal autorisé en caisse (alerte de dépassement) — nul = pas de plafond.
  plafond           Int?
  decouvertAutorise Boolean @default(false)
  statut            String @default("active") // « active » | « suspendue »
  devise            String @default("XOF") // multi-devises par caisse : report documenté (V1 mono-devise)
  version           Int @default(0)
  annuleLe          DateTime?
  annuleParId       String?
  annulePar         Utilisateur? @relation("AnnulationsCaisse", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe            DateTime @default(now())

  sessions SessionCaisse[]

  // Unicité du NOM parmi les caisses ACTIVES : index unique PARTIEL « WHERE annuleLe IS NULL »
  // posé par la migration manuscrite 20260731090000.
  @@index([etablissementId, nom])
  @@map("caisses_etablissement")
}

/// SESSION de caisse (09) : ouverture (fonds initial) → encaissements/décaissements rattachés
/// → comptage physique → clôture (totaux FIGÉS, RM-505 : opérations non modifiables).
/// RM-502 : une seule session OUVERTE par caisse (et par caissier) — index uniques PARTIELS
/// « WHERE statut = 'ouverte' AND annuleLe IS NULL » posés par la migration manuscrite.
/// Le solde THÉORIQUE d'une session ouverte est CALCULÉ (RM-503) ; il n'est figé qu'à la clôture.
model SessionCaisse {
  id              String              @id @default(cuid())
  etablissementId String
  etablissement   Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  caisseId        String
  caisse          CaisseEtablissement @relation(fields: [caisseId], references: [id], onDelete: Cascade)
  caissierId      String
  caissier        Utilisateur         @relation("SessionsCaissier", fields: [caissierId], references: [id], onDelete: Cascade)
  statut          String @default("ouverte") // « ouverte » | « cloturee »
  fondsInitial    Int // fixe, calculé ou reporté depuis la veille (proposé à l'ouverture)
  observations    String?
  ouverteLe       DateTime @default(now())
  clotureeLe      DateTime?
  // ── Totaux FIGÉS à la clôture (nuls tant que la session est ouverte) ──
  totalEncaissements Int?
  totalDecaissements Int?
  soldeTheorique     Int?
  soldeReel          Int? // comptage physique
  ecart              Int? // soldeReel − soldeTheorique
  typeEcart          String? // « excedent » | « deficit »
  motifEcart         String? // justification obligatoire dès qu'un écart existe
  /// Validation de l'écart par un SECOND acteur (séparation des responsabilités, 04/09).
  ecartValideParId   String?
  ecartValideLe      DateTime?
  montantAVerser     Int? // proposé au versement bancaire (effectif : 10-Banque)
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsSessionCaisse", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  mouvements MouvementCaisse[]
  paiements  PaiementScolarite[]
  operations OperationFinanciere[]

  @@index([caisseId, statut])
  @@index([etablissementId, ouverteLe])
  @@index([caissierId])
  @@map("sessions_caisse")
}

/// MOUVEMENT INTERNE de caisse (09) : approvisionnement, décaissement, transfert entre
/// caisses (paire liée), versement banque (préparé — l'effectif au 10), retrait banque,
/// régularisation (+/−). Les encaissements/dépenses MÉTIER restent les flux existants
/// (paiements & journal OHADA), rattachés à la session par sessionCaisseId.
model MouvementCaisse {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  sessionId       String
  session         SessionCaisse @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// « approvisionnement » | « decaissement » | « transfert_entree » | « transfert_sortie »
  /// | « versement_banque » | « retrait_banque » | « regularisation_plus » | « regularisation_moins »
  type            String
  montant         Int // toujours positif — le sens est porté par le type
  beneficiaire    String? // décaissement : bénéficiaire obligatoire
  motif           String? // obligatoire pour décaissements et régularisations
  pieceJustificative String? // référence de la pièce (le fichier joint : chantier documents)
  /// Auteur de la validation par seuil (09 : < 50 000 auto ; 50 000-500 000 valider ;
  /// > 500 000 approuver — seuils par défaut du domaine, paramétrage à venir).
  valideParId     String?
  /// Transfert : mouvement miroir de l'autre caisse (paire créée dans la même transaction).
  lieMouvementId  String?
  saisiParId      String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsMouvementCaisse", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([sessionId])
  @@index([etablissementId, creeLe])
  @@map("mouvements_caisse")
}

/// VENTILATION d'un paiement sur une facture (08-Encaissements : « un seul paiement peut
/// solder plusieurs factures » ; imputation directe attendue par le 07). Un paiement VENTILÉ
/// ne porte PAS de fraisId : son affectation passe par ses ventilations (les paiements avec
/// fraisId restent alloués aux créances du 06 — jamais de double comptage). Le trop-perçu
/// d'une saisie ventilée devient une AvanceEleve (crédit conservé, comportement par défaut
/// du 08 — le paramétrage viendra avec l'écran de paramétrage financier).
model VentilationPaiement {
  id              String            @id @default(cuid())
  etablissementId String
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  paiementId      String
  paiement        PaiementScolarite @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  factureId       String
  facture         FactureEleve      @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant         Int // FCFA affectés à cette facture
  devise          String @default("XOF")
  annuleLe        DateTime? // annulée avec le paiement (RM-004)
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsVentilationPaiement", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId])
  @@index([paiementId])
  @@index([factureId])
  @@map("ventilations_paiement")
}

/// Encaissement de scolarité d'un élève — reçu numéroté par établissement.
model PaiementScolarite {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleveId         String
  eleve           Utilisateur   @relation("PaiementsEleve", fields: [eleveId], references: [id], onDelete: Cascade)
  fraisId         String?
  libelle         String // frais / tranche réglée (libellé figé au moment du paiement)
  montant         Int // FCFA
  devise          String @default("XOF") // RM-007 : devise enregistrée avec chaque transaction
  mode            String @default("especes") // « especes » | « mobile_money » | « cheque » | « virement » | « carte »
  reference       String? // n° transaction Mobile Money, n° chèque…
  // ── 08-Encaissements : détails du moyen de paiement ──
  banque          String? // chèque / virement / carte : banque émettrice
  titulaire       String? // chèque : titulaire du compte
  fournisseurMobile String? // mobile money : « orange » | « mtn » | « moov » | « wave » | « autre »
  numeroRecu      Int
  date            DateTime @default(now())
  /// RM-008 : date comptable distincte de la date de création (nul = repli sur `date` puis `creeLe`).
  dateComptable   DateTime?
  annule          Boolean @default(false)
  motifAnnulation String?
  /// RM-004 : horodatage et auteur de l'annulation (complète le drapeau `annule` historique).
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsPaiementScolarite", fields: [annuleParId], references: [id], onDelete: SetNull)
  version         Int @default(0) // RM-019 : verrouillage optimiste
  encaisseParId   String?
  /// 09-Caisse (RM-504) : session de caisse à laquelle l'encaissement est rattaché
  /// (nul pour les établissements sans caisses ou les paiements antérieurs au 09).
  sessionCaisseId String?
  sessionCaisse   SessionCaisse? @relation(fields: [sessionCaisseId], references: [id], onDelete: SetNull)
  /// Pointage du rapprochement bancaire : date de constat sur le relevé (nul = non pointé).
  pointeLe        DateTime?
  creeLe          DateTime @default(now())

  demandesRemboursement DemandeRemboursement[]
  ventilations          VentilationPaiement[]

  @@unique([etablissementId, numeroRecu])
  @@index([etablissementId, date])
  @@index([eleveId])
  @@index([sessionCaisseId])
  @@map("paiements_scolarite")
}

/// Journal de caisse & banque : toute RECETTE hors scolarité et toute DÉPENSE,
/// imputée sur une catégorie inspirée du plan OHADA simplifié (classes 6 et 7).
model OperationFinanciere {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  sens            String // « recette » | « depense »
  categorie       String // code OHADA simplifié, ex : « 601 », « 641 », « 706 »
  libelle         String
  montant         Int // FCFA
  devise          String @default("XOF") // RM-007
  mode            String @default("especes")
  reference       String?
  date            DateTime @default(now())
  /// RM-008 : date comptable distincte de la date de création (nul = repli sur `date` puis `creeLe`).
  dateComptable   DateTime?
  annule          Boolean @default(false)
  motifAnnulation String?
  /// RM-004 : horodatage et auteur de l'annulation (complète le drapeau `annule` historique).
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsOperationFinanciere", fields: [annuleParId], references: [id], onDelete: SetNull)
  version         Int @default(0) // RM-019 : verrouillage optimiste
  saisiParId      String?
  /// 09-Caisse (RM-504) : session de caisse à laquelle l'opération est rattachée (nul si sans caisse).
  sessionCaisseId String?
  sessionCaisse   SessionCaisse? @relation(fields: [sessionCaisseId], references: [id], onDelete: SetNull)
  /// Pointage du rapprochement bancaire : date de constat sur le relevé (nul = non pointé).
  pointeLe        DateTime?
  creeLe          DateTime @default(now())

  @@index([etablissementId, date])
  @@index([sessionCaisseId])
  @@map("operations_financieres")
}

/// Article de l'économat (fournitures, uniformes, cantine…) avec stock et seuil d'alerte.
/// 14-Stocks : fiche ENRICHIE par AJOUT — `stock` reste le TOTAL toutes réserves (référence
/// des flux historiques) ; sa répartition par magasin vit dans StockMagasin (Σ = stock).
/// `cump` : coût unitaire moyen pondéré, MIS À JOUR EN TRANSACTION à chaque entrée valorisée
/// (agrégat de valorisation métier — méthode CUMP par défaut de la doc ; FIFO/LIFO reportés).
model ArticleEconomat {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom             String
  categorie       String? // « Fournitures », « Uniformes », « Cantine »…
  prixVente       Int // FCFA
  prixAchat       Int?
  devise          String @default("XOF") // RM-007
  stock           Int @default(0)
  seuilAlerte     Int @default(5) // = stock MINIMUM (14)
  actif           Boolean @default(true)
  // ── 14 : fiche article enrichie ──
  code            String?
  codeBarres      String?
  description     String?
  sousCategorie   String?
  unite           String @default("unité")
  /// « consommable » | « stockable » | « immobilisable » (mise en service → 15, reporté)
  typeArticle     String @default("consommable")
  stockMax        Int?
  stockSecurite   Int?
  eoq             Int? // quantité économique de commande (informative V1)
  cump            Int? // coût unitaire moyen pondéré (FCFA)
  tvaPourcent     Int?
  fournisseurPrincipalId String?
  fournisseurPrincipal   Fournisseur? @relation("ArticlesFournisseurPrincipal", fields: [fournisseurPrincipalId], references: [id], onDelete: SetNull)
  version         Int @default(0) // RM-019 : verrouillage optimiste
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsArticleEconomat", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  mouvements       MouvementStock[]
  stocksMagasin    StockMagasin[]
  lots             LotStock[]
  series           SerieStock[]
  reservations     ReservationStock[]
  lignesInventaire LigneInventaire[]

  @@index([etablissementId])
  @@map("articles_economat")
}

/// Mouvement de stock (RM-1101 : tout mouvement est historisé). Types historiques :
/// « entree » | « vente » | « ajustement » | « retour_fournisseur » (12) ; 14-Stocks ajoute
/// « consommation » | « distribution » | « rebut » (sorties motivées) et
/// « transfert_sortie » | « transfert_entree » (paire liée entre magasins, stock total inchangé).
model MouvementStock {
  id              String          @id @default(cuid())
  articleId       String
  article         ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  etablissementId String
  type            String
  quantite        Int // entrée > 0 ; vente > 0 (décrémente) ; ajustement = nouveau stock
  montant         Int? // total encaissé (vente) ou coût (entrée), FCFA
  devise          String @default("XOF") // RM-007
  mode            String? // mode d'encaissement d'une vente
  eleveId         String? // acheteur élève (optionnel)
  acheteur        String? // acheteur libre (comptoir)
  // ── 14 : localisation, motifs et liens ──
  magasinId       String? // nul = magasin principal (mouvements antérieurs au 14)
  magasin         MagasinStock? @relation(fields: [magasinId], references: [id], onDelete: SetNull)
  lieMouvementId  String? // transfert : mouvement miroir de l'autre magasin
  motif           String? // sorties (consommation/distribution/rebut) et ajustements d'inventaire
  beneficiaire    String? // service / classe / personne servie par la sortie
  valideParId     String? // RM-1103 : sorties importantes validées
  date            DateTime @default(now())
  /// RM-008 : date comptable distincte de la date de création (nul = repli sur `date` puis `creeLe`).
  dateComptable   DateTime?
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsMouvementStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  saisiParId      String?
  // Référence du reçu d'une VENTE au comptoir (séquence « recu_vente_economat », format VE-AAAA-000123).
  // Null pour les entrées/ajustements et les ventes antérieures à cette numérotation.
  numeroRecu      String?
  creeLe          DateTime @default(now())

  @@index([articleId])
  @@index([etablissementId, date])
  @@index([magasinId])
  @@index([etablissementId, numeroRecu])
  // Scalabilité : les KPI Finances agrègent les VENTES (type='vente') sur toute une table
  // pleine de mouvements non-vente (entrées/ajustements/sorties) → index dédié au filtre type.
  @@index([etablissementId, type])
  @@map("mouvements_stock")
}

// ═══════════════════════════════════════════════════════════════════════
//  14-STOCKS : magasins hiérarchisés, répartition par magasin (Σ = stock
//  total de l'article — reprise douce), lots/péremption, numéros de série,
//  réservations (le DISPONIBLE = stock − réservations actives, RM-1100),
//  inventaires (théorique figé → comptage → validation SECOND acteur →
//  ajustements automatiques, RM-1105).
// ═══════════════════════════════════════════════════════════════════════

/// Magasin / emplacement de stock (14) : hiérarchie LIBRE par parentId (magasin → zone →
/// rayon → étagère → emplacement). Le magasin PRINCIPAL (unique actif par établissement)
/// porte le stock historique de l'économat (reprise douce, semée par la migration).
model MagasinStock {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom             String
  /// « central » | « pedagogique » | « informatique » | « laboratoire » | « cantine »
  /// | « maintenance » | « pharmacie » | « depot »
  type            String @default("central")
  parentId        String?
  parent          MagasinStock?  @relation("HierarchieMagasin", fields: [parentId], references: [id], onDelete: SetNull)
  enfants         MagasinStock[] @relation("HierarchieMagasin")
  /// « ouvert » | « ferme » (un magasin fermé ne reçoit plus de mouvements)
  statut          String @default("ouvert")
  principal       Boolean @default(false)
  responsableId   String?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsMagasinStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  stocks     StockMagasin[]
  mouvements MouvementStock[]
  inventaires InventaireStock[]

  @@index([etablissementId])
  @@map("magasins_stock")
}

/// Répartition du stock d'un article par magasin — INVARIANT : Σ quantite = article.stock
/// (maintenu en transaction par tous les mouvements). Table de quantités (pas d'annulation
/// logique : une ligne à zéro reste la trace de l'emplacement).
model StockMagasin {
  id        String          @id @default(cuid())
  articleId String
  article   ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  magasinId String
  magasin   MagasinStock    @relation(fields: [magasinId], references: [id], onDelete: Cascade)
  quantite  Int @default(0)
  creeLe    DateTime @default(now())

  @@unique([articleId, magasinId])
  @@index([magasinId])
  @@map("stocks_magasin")
}

/// Lot d'un article (14) : traçabilité et PÉREMPTION (alertes 90/60/30/7 j DÉRIVÉES).
/// V1 : quantités de lot tenues par les actions de lot (la ventilation automatique de chaque
/// mouvement par lot viendra avec le paramétrage — décision documentée au rapport).
model LotStock {
  id              String          @id @default(cuid())
  articleId       String
  article         ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  numeroLot       String
  dateFabrication DateTime?
  datePeremption  DateTime?
  fournisseurRef  String? // référence libre du fournisseur d'origine
  coutAcquisition Int? // FCFA unitaire
  quantite        Int @default(0)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsLotStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([articleId])
  @@map("lots_stock")
}

/// Numéro de série d'un équipement (14) — UNIQUE par établissement (409 sinon).
model SerieStock {
  id              String          @id @default(cuid())
  etablissementId String
  etablissement   Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  articleId       String
  article         ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  numeroSerie     String
  /// « disponible » | « reserve » | « en_transit » | « endommage » | « obsolete » | « sorti »
  statut          String @default("disponible")
  observation     String?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsSerieStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([articleId])
  @@index([etablissementId])
  @@map("series_stock")
}

/// Réservation de stock (14) : réduit le DISPONIBLE sans toucher au stock physique.
model ReservationStock {
  id              String          @id @default(cuid())
  etablissementId String
  etablissement   Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  articleId       String
  article         ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quantite        Int
  /// « laboratoire » | « examen » | « evenement » | « maintenance » | « salle_informatique » | « autre »
  motif           String
  beneficiaire    String? // service, salle, événement…
  dateDebut       DateTime @default(now())
  dateFin         DateTime?
  /// « active » | « liberee » (transitions historisées)
  statut          String @default("active")
  demandeParId    String?
  demandeParNom   String?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsReservationStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([articleId, statut])
  @@index([etablissementId])
  @@map("reservations_stock")
}

/// Inventaire physique (14) : théorique FIGÉ à l'ouverture → comptage → VALIDATION par un
/// SECOND acteur → ajustements automatiques par ligne à écart (RM-1105 ; les écritures de
/// régularisation comptable suivront l'arrivée des comptes de classe 3 au 11A — documenté).
model InventaireStock {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  reference       String // « INV-2026-000001 » (séquence fondation)
  /// « general » | « tournant » | « exceptionnel »
  type            String @default("general")
  magasinId       String? // nul = tout l'établissement (stock total)
  magasin         MagasinStock? @relation(fields: [magasinId], references: [id], onDelete: SetNull)
  /// « en_cours » | « valide » (transitions historisées)
  statut          String @default("en_cours")
  notes           String?
  compteParId     String?
  compteParNom    String?
  valideParId     String?
  valideParNom    String?
  dateValidation  DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsInventaireStock", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes LigneInventaire[]

  @@index([etablissementId, statut])
  @@map("inventaires_stock")
}

/// Ligne d'inventaire : théorique FIGÉ, physique saisi — l'ÉCART est dérivé.
model LigneInventaire {
  id             String          @id @default(cuid())
  inventaireId   String
  inventaire     InventaireStock @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  articleId      String
  article        ArticleEconomat @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleNom     String // FIGÉ
  stockTheorique Int
  stockPhysique  Int? // nul = pas encore compté
  observation    String?
  creeLe         DateTime @default(now())

  @@index([inventaireId])
  @@map("lignes_inventaire")
}

// ═══════════════════════════════════════════════════════════════════════
//  15-IMMOBILISATIONS : passeport numérique de l'actif (RM-1200 code unique),
//  amortissement LINÉAIRE calculé automatiquement (plan DÉRIVÉ, VNC jamais
//  stockée — seules les dotations COMPTABILISÉES sont persistées, écriture
//  681/28x, RM-1202), cycle de vie à transitions motivées, maintenance
//  préventive/corrective, réévaluation, sortie d'actif avec écriture (RM-1203)
//  et décision par un SECOND acteur. RM-1205 : l'actif issu du stock conserve
//  la référence du mouvement d'origine.
// ═══════════════════════════════════════════════════════════════════════

/// Fiche d'immobilisation (passeport). Statut : « acquisition » | « installation » |
/// « service » | « maintenance » | « hors_service » | « cession » | « reforme » |
/// « detruite » | « perdue » | « archive ». `valeurBrute` = valeur comptable brute courante
/// (= coutAcquisition à la création, ajustée par réévaluation) ; la VNC est DÉRIVÉE.
model Immobilisation {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  code            String // « IMM-000001 » (séquence fondation, RM-1200)
  codeBarres      String?
  designation     String
  description     String?
  /// « incorporelle » | « terrain » | « batiment » | « materiel_informatique » | « mobilier »
  /// | « vehicule » | « materiel_pedagogique » | « equipement_sportif » | « autre »
  categorie       String
  sousCategorie   String?
  numeroSerie     String?
  dateAcquisition DateTime
  dateMiseEnService DateTime? // RM-1201 : pas d'amortissement avant
  fournisseurId   String?
  fournisseur     Fournisseur? @relation("ImmobilisationsFournisseur", fields: [fournisseurId], references: [id], onDelete: SetNull)
  factureReference String?
  coutAcquisition Int // FCFA — historique, immuable
  valeurBrute     Int // FCFA — valeur brute courante (réévaluations comprises)
  valeurResiduelle Int @default(0)
  dureeMois       Int @default(60) // durée d'utilisation prévue
  /// « lineaire » (défaut V1 ; dégressif/unités/personnalisé reportés)
  modeAmortissement String @default("lineaire")
  amortissable    Boolean @default(true) // terrains = false
  /// « achat » | « don » | « subvention » | « transfert » | « production » | « leasing »
  modeAcquisition String @default("achat")
  compteImmo      String // compte 2x figé (semé par assurerComptesImmobilisations)
  compteAmort     String? // compte 28x (nul si non amortissable)
  garantieFournisseur String?
  garantieEcheance DateTime?
  localisation    String? // hiérarchie libre : « Site A › Bâtiment B › Salle 12 »
  responsableId   String?
  responsableNom  String?
  statut          String @default("acquisition")
  motifSortie     String?
  typeSortie      String? // « vente » | « reforme » | « destruction » | « perte » | « vol » | « don »
  dateSortie      DateTime?
  valeurCession   Int? // produit de cession (vente)
  sortieParId     String?
  sortieParNom    String?
  /// RM-1205 : origine stock (article immobilisable mis en service) — traçabilité.
  origineArticleId String?
  origineMouvementId String?
  creeParId       String?
  devise          String @default("XOF") // RM-007
  dateComptable   DateTime?
  version         Int @default(0) // RM-019
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsImmobilisation", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  dotations   DotationAmortissement[]
  maintenances MaintenanceImmobilisation[]
  evenements  EvenementImmobilisation[]

  @@index([etablissementId, statut])
  @@index([categorie])
  @@map("immobilisations")
}

/// Dotation aux amortissements COMPTABILISÉE (RM-1202) — une par exercice/actif, écriture
/// 681/28x posée à la comptabilisation (idempotent par (immobilisation, periode)).
model DotationAmortissement {
  id               String         @id @default(cuid())
  immobilisationId String
  immobilisation   Immobilisation @relation(fields: [immobilisationId], references: [id], onDelete: Cascade)
  etablissementId  String
  periode          String // « AAAA » (annuelle)
  montant          Int // FCFA
  cumulApres       Int // amortissement cumulé après cette dotation
  vncApres         Int // valeur nette comptable après (dérivée figée au moment du calcul)
  dateComptabilisation DateTime @default(now())
  comptabiliseParId String?
  devise           String @default("XOF")
  annuleLe         DateTime?
  annuleParId      String?
  creeLe           DateTime @default(now())

  @@unique([immobilisationId, periode])
  @@index([etablissementId])
  @@map("dotations_amortissement")
}

/// Maintenance d'un actif (15) : préventive (planifiée) ou corrective (incident).
model MaintenanceImmobilisation {
  id               String         @id @default(cuid())
  immobilisationId String
  immobilisation   Immobilisation @relation(fields: [immobilisationId], references: [id], onDelete: Cascade)
  etablissementId  String
  /// « preventive » | « corrective »
  type             String
  description      String
  prestataire      String?
  datePrevue       DateTime?
  dateRealisee     DateTime?
  coutPrevu        Int?
  coutReel         Int?
  /// « planifiee » | « realisee » | « annulee »
  statut           String @default("planifiee")
  devise           String @default("XOF")
  version          Int @default(0)
  annuleLe         DateTime?
  annuleParId      String?
  creeLe           DateTime @default(now())

  @@index([immobilisationId])
  @@index([etablissementId, statut])
  @@map("maintenances_immobilisation")
}

/// Événement du PASSEPORT (15) : timeline append-only de l'actif — acquisition, mise en
/// service, affectation, localisation, transfert, réévaluation, maintenance, sortie…
model EvenementImmobilisation {
  id               String         @id @default(cuid())
  immobilisationId String
  immobilisation   Immobilisation @relation(fields: [immobilisationId], references: [id], onDelete: Cascade)
  /// « acquisition » | « mise_en_service » | « affectation » | « localisation » | « transfert »
  /// | « reevaluation » | « maintenance » | « etat » | « sortie »
  type             String
  description      String
  montant          Int?
  parId            String?
  parNom           String?
  date             DateTime @default(now())

  @@index([immobilisationId])
  @@map("evenements_immobilisation")
}

/// Solde du relevé bancaire d'un mois (rapprochement bancaire). 10-Banque : le relevé peut
/// désormais viser un COMPTE précis (compteId) — nul = relevé global historique (compat).
model ReleveBancaire {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  compteId        String?
  compte          CompteBancaire? @relation(fields: [compteId], references: [id], onDelete: SetNull)
  mois            String // « 2026-07 »
  solde           Int // FCFA — solde de fin de mois du relevé de la banque
  devise          String @default("XOF") // RM-007
  version         Int @default(0) // RM-019 : verrouillage optimiste
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsReleveBancaire", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  // Unicité des relevés ACTIFS : par (etablissement, compte, mois) — et par (etablissement,
  // mois) pour les relevés GLOBAUX (compteId NULL). Index uniques PARTIELS posés par la
  // migration manuscrite 20260801090000 (l'@@unique historique est remplacé).
  @@index([etablissementId, mois])
  @@index([compteId])
  @@map("releves_bancaires")
}

// ─────────────────────────────────────────────────────────────
//  Sous-module BANQUE (docs/finance/10-Banque + 05B) : comptes
//  bancaires & Mobile Money institutionnels, mouvements (dépôts
//  depuis les caisses — RM-600 —, retraits, virements, frais,
//  intérêts), chèques en circulation, rapprochement par compte.
// ─────────────────────────────────────────────────────────────

/// COMPTE BANCAIRE de l'établissement (10) : courant, épargne, Mobile Money Business ou
/// virtuel. Le SOLDE est CALCULÉ (soldeInitial + mouvements actifs) — jamais stocké.
/// Statut STOCKÉ : « actif » | « suspendu » | « ferme » (RM-601) ; archivé = annulation logique.
model CompteBancaire {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom             String
  code            String?
  type            String @default("courant") // « courant » | « epargne » | « mobile_money » | « virtuel »
  banque          String // ex : « SGCI », « Ecobank », « Wave Business »
  agence          String?
  numeroCompte    String?
  iban            String?
  swift           String?
  responsableId   String?
  responsable     Utilisateur? @relation("ComptesBancairesResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  /// Solde de départ à la création du compte dans EduWeb (le suivi part de là).
  soldeInitial    Int @default(0)
  /// Alerte « solde faible » sous ce seuil (nul = pas d'alerte).
  seuilAlerte     Int?
  statut          String @default("actif")
  dateOuverture   DateTime?
  dateFermeture   DateTime?
  devise          String @default("XOF") // un compte = une devise (conversions : report 11+)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCompteBancaire", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  mouvements MouvementBancaire[]
  cheques    Cheque[]
  releves    ReleveBancaire[]

  // Unicité du nom parmi les comptes ACTIFS : index unique PARTIEL (migration 20260801090000).
  @@index([etablissementId, nom])
  @@map("comptes_bancaires")
}

/// MOUVEMENT BANCAIRE (10) : dépôt (obligatoirement issu d'une caisse ou d'une banque —
/// RM-600, tolérance documentée pour les établissements sans caisses), retrait, virements
/// (paire liée pour l'interne), prélèvement, frais bancaires (→ OperationFinanciere cat. 63,
/// RM-604), intérêts créditeurs (→ cat. 77, RM-605). Pièce justificative OBLIGATOIRE
/// (« aucune opération bancaire sans pièce justificative »). `pointeLe` : rapprochement.
model MouvementBancaire {
  id              String         @id @default(cuid())
  etablissementId String
  etablissement   Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  compteId        String
  compte          CompteBancaire @relation(fields: [compteId], references: [id], onDelete: Cascade)
  /// « depot » | « retrait » | « virement_entrant » | « virement_sortant »
  /// | « virement_interne_entree » | « virement_interne_sortie » | « prelevement »
  /// | « frais_bancaires » | « interets » — le sens est porté par le type.
  type            String
  montant         Int // toujours positif
  libelle         String
  reference       String? // n° de virement, bordereau…
  pieceJustificative String // OBLIGATOIRE (10)
  beneficiaire    String? // virement sortant : fournisseur, salarié, parent…
  /// Boucle 09 → 10 : versement de caisse confirmé en banque (mouvement de caisse d'origine).
  mouvementCaisseId String?
  /// Virement interne : mouvement miroir de l'autre compte (paire créée dans la même transaction).
  lieMouvementId  String?
  /// Chèque du registre lié (encaissement d'un chèque reçu, émission…).
  chequeId        String?
  /// Frais/intérêts : OperationFinanciere créée automatiquement (RM-604/605) dans la transaction.
  operationId     String?
  dateOperation   DateTime @default(now())
  /// Pointage du rapprochement (10) : date de constat sur le relevé (nul = en attente).
  pointeLe        DateTime?
  saisiParId      String?
  valideParId     String? // validation hiérarchique des sorties au-delà du seuil
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsMouvementBancaire", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([compteId, dateOperation])
  @@index([etablissementId, dateOperation])
  @@index([mouvementCaisseId])
  @@map("mouvements_bancaires")
}

/// CHÈQUE du registre (10) : émis ou reçu — statuts STOCKÉS (transitions historisées) :
/// « en_circulation » | « encaisse » | « rejete » | « annule ».
model Cheque {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  compteId        String?
  compte          CompteBancaire? @relation(fields: [compteId], references: [id], onDelete: SetNull)
  sens            String // « emis » | « recu »
  numero          String
  banque          String?
  montant         Int
  dateEmission    DateTime @default(now())
  emetteur        String? // chèque reçu : titulaire
  beneficiaire    String? // chèque émis : bénéficiaire
  /// Chèque reçu : paiement de scolarité d'origine (référence libre — lien indicatif).
  paiementId      String?
  statut          String @default("en_circulation")
  motifStatut     String? // rejet / annulation : motif
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCheque", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  // Unicité du numéro parmi les chèques ACTIFS d'un même sens (migration 20260801090000).
  @@index([etablissementId, sens, statut])
  @@index([compteId])
  @@map("cheques_bancaires")
}

/// Ligne de budget par exercice et catégorie OHADA. 16-Budgets : ENRICHIE par AJOUT —
/// `montantRevise` (voté effectif après révisions ; nul = repli sur montantPrevu),
/// rattachement optionnel à une enveloppe (budgetId) et à un centre de coût, statut de ligne
/// (RM-1304 : une ligne clôturée ne se modifie plus). VOTÉ, ENGAGÉ, CONSOMMÉ et DISPONIBLE
/// sont DÉRIVÉS (jamais stockés — cohérence stricte avec l'engagement du 12).
model BudgetLigne {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // ex : « 2025-2026 »
  categorie       String // code OHADA simplifié
  sens            String // « recette » | « depense »
  montantPrevu    Int // FCFA — montant initial voté
  montantRevise   Int? // FCFA — montant après révisions (nul = montantPrevu)
  code            String?
  libelle         String?
  budgetId        String?
  budget          Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  centreCoutId    String?
  centreCout      CentreCout? @relation(fields: [centreCoutId], references: [id], onDelete: SetNull)
  statut          String @default("active") // « active » | « cloturee » (RM-1304)
  devise          String @default("XOF") // RM-007
  version         Int @default(0) // RM-019 : verrouillage optimiste
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsBudgetLigne", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@unique([etablissementId, exercice, categorie, sens])
  @@index([budgetId])
  @@map("budget_lignes")
}

// ═══════════════════════════════════════════════════════════════════════
//  16-BUDGETS : enveloppe budgétaire votée (workflow), centres de coûts/
//  profits, révisions historisées (RM-1301), engagements manuels (contrats/
//  marchés/conventions). Le suivi VOTÉ / ENGAGÉ / CONSOMMÉ / DISPONIBLE est
//  DÉRIVÉ en temps réel (RM-1300/1302/1303) et absorbe l'engagement du 12.
// ═══════════════════════════════════════════════════════════════════════

/// Enveloppe budgétaire (16) : un budget appartient à UN exercice (RM-1305). Workflow :
/// « brouillon » → « soumis » → « approuve » → « execution » → « cloture » → « archive ».
/// Le VOTE (soumis → approuve/execution) est fait par un acteur distinct du préparateur.
model Budget {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  /// « fonctionnement » | « investissement » | « projet » | « exceptionnel »
  type            String @default("fonctionnement")
  libelle         String
  statut          String @default("brouillon")
  preparParId     String?
  preparParNom    String?
  voteParId       String?
  voteParNom      String?
  dateVote        DateTime?
  notes           String?
  devise          String @default("XOF")
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsBudget", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes BudgetLigne[]

  @@index([etablissementId, exercice])
  @@map("budgets")
}

/// Centre de coût ou de profit (16) — référentiel taggable sur les lignes.
model CentreCout {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  code            String
  libelle         String
  /// « cout » | « profit »
  type            String @default("cout")
  actif           Boolean @default(true)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCentreCout", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes BudgetLigne[]

  @@index([etablissementId])
  @@map("centres_cout")
}

/// Révision budgétaire (16, RM-1301) : trace toute modification de crédits.
model RevisionBudget {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  /// « augmentation » | « diminution » | « virement » | « ouverture » | « annulation »
  type            String
  ligneId         String? // ligne source (diminution/virement) ou cible (augmentation/ouverture)
  ligneCibleId    String? // ligne destinataire d'un virement
  categorie       String?
  montant         Int // FCFA (valeur absolue du mouvement)
  montantAvant    Int?
  montantApres    Int?
  motif           String
  parId           String?
  parNom          String?
  creeLe          DateTime @default(now())

  @@index([etablissementId, exercice])
  @@map("revisions_budget")
}

/// Engagement budgétaire MANUEL (16) : réserve des crédits hors cycle d'achat — contrats,
/// marchés, conventions (RM-1302 : déduit immédiatement du disponible). Les BC émis du 12
/// alimentent l'engagé automatiquement (ils ne passent pas par cette table).
model EngagementBudget {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  categorie       String // code OHADA dépense
  centreCoutId    String?
  montant         Int // FCFA
  libelle         String
  /// « contrat » | « marche » | « convention » | « autre »
  source          String @default("autre")
  reference       String?
  /// « actif » | « solde » | « annule »
  statut          String @default("actif")
  parId           String?
  parNom          String?
  devise          String @default("XOF")
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsEngagementBudget", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, exercice, statut])
  @@map("engagements_budget")
}

// ═══════════════════════════════════════════════════════════════════════
//  17-DÉPENSES : sorties financières HORS achats (frais généraux, notes de
//  frais, missions, décaissements directs). Workflow demande → validation à
//  SEUILS → engagement budgétaire → décaissement (caisse 09 / banque 10) →
//  écriture de charge (11). Une dépense APPROUVÉE engage le budget ; PAYÉE,
//  son OperationFinanciere alimente le consommé (jamais de double comptage).
//  Les dépenses SUR ACHATS restent au cycle P2P du 12.
// ═══════════════════════════════════════════════════════════════════════

/// Demande de dépense (17). Statut : « brouillon » → « soumise » → « approuvee » (= engagée)
/// → « payee » → « cloturee » ; « refusee » ; « archivee ». La validation par SEUIL exige
/// finance.depenses.valider (≤ seuil) ou .approuver (au-delà) ; séparation demandeur ≠ valideur.
model DemandeDepense {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  numero          String? // « DEP-000001 » — attribué à la soumission
  /// « fonctionnement » | « investissement » | « pedagogique » | « administrative » | « mission » | « exceptionnelle »
  type            String @default("fonctionnement")
  objet           String
  description     String?
  categorie       String // code OHADA dépense (ligne budgétaire — RM-1401)
  centreCoutId    String?
  service         String?
  projet          String?
  beneficiaire    String? // note de frais / mission : bénéficiaire du remboursement
  montantEstime   Int // FCFA
  montantValide   Int? // montant réellement approuvé (peut différer — notes de frais)
  urgence         String @default("normale") // « normale » | « urgente » | « critique »
  pieceJustificative String?
  statut          String @default("brouillon")
  demandeurId     String?
  demandeurNom    String
  decideParId     String?
  decideParNom    String?
  dateDecision    DateTime?
  motifRefus      String?
  // ── Décaissement ──
  mode            String? // « especes » | « virement » | « cheque » | « mobile_money » | « carte »
  reference       String?
  datePaiement    DateTime?
  operationId     String? // OperationFinanciere de décaissement (trésorerie/KPI)
  sessionCaisseId String? // 09 : session de caisse si espèces
  payeParId       String?
  payeParNom      String?
  devise          String @default("XOF") // RM-007
  dateComptable   DateTime?
  version         Int @default(0) // RM-019
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDemandeDepense", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, statut])
  @@index([etablissementId, exercice])
  @@map("demandes_depense")
}

/// Avance sur frais (17) : accordée puis DÉCAISSÉE, à RÉGULARISER (justificatifs → solde
/// remboursé ou complété — RM-1403). Traitement en logique de caisse (permanence des
/// méthodes avec le 11) : le décaissement passe une opération de dépense sur la catégorie ;
/// la régularisation ajuste par une opération inverse ou complémentaire.
model AvanceFrais {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  numero          String? // « AVF-000001 »
  beneficiaireId  String?
  beneficiaireNom String
  /// « mission » | « achat_urgent » | « activite »
  motif           String @default("mission")
  objet           String
  categorie       String // code OHADA dépense
  montant         Int // avance décaissée
  mode            String @default("especes")
  reference       String?
  /// « decaissee » | « regularisee » | « annulee »
  statut          String @default("decaissee")
  montantJustifie Int? // total des justificatifs à la régularisation
  soldeType       String? // « rembourse » (agent rend) | « complete » (agent avancé de plus) | « equilibre »
  operationId     String? // opération de décaissement
  operationRegulId String? // opération d'ajustement à la régularisation
  sessionCaisseId String?
  decaisseParId   String?
  decaisseParNom  String?
  dateRegularisation DateTime?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsAvanceFrais", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, statut])
  @@map("avances_frais")
}

/// Dépense récurrente (17) : échéancier des dépenses périodiques (loyer, abonnement,
/// assurance, internet…). La génération crée une DemandeDepense APPROUVÉE prête à payer à
/// chaque échéance due, et avance la prochaine échéance (idempotent).
model DepenseRecurrente {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  libelle         String
  categorie       String // code OHADA dépense
  centreCoutId    String?
  montant         Int
  /// « mensuelle » | « trimestrielle » | « annuelle »
  periodicite     String @default("mensuelle")
  prochaineEcheance DateTime
  beneficiaire    String?
  actif           Boolean @default(true)
  derniereGeneration DateTime?
  devise          String @default("XOF")
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDepenseRecurrente", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, actif])
  @@map("depenses_recurrentes")
}

// ─────────────────────────────────────────────────────────────
//  Sous-module COMPTABILITÉ (docs/finance/11-Comptabilite + 05B)
//  Plan comptable paramétrable (semé depuis le plan OHADA du
//  dépôt — le 11A affinera les subdivisions à sa réception),
//  journaux, ÉCRITURES en partie double (RM-700→705 : équilibre
//  strict, validée = intouchable, correction par contre-passation,
//  pièce obligatoire, périodes clôturées verrouillées).
// ─────────────────────────────────────────────────────────────

/// Compte du PLAN COMPTABLE de l'établissement (11) — paramétrable, semé depuis le plan
/// OHADA simplifié du dépôt. Retrait = annulation logique ; unicité du numéro parmi les
/// comptes ACTIFS (index partiel, migration 20260802090000).
model CompteComptable {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  numero          String // ex : « 571 », « 7061 »
  intitule        String
  classe          Int // 1..9 (classes OHADA)
  nature          String @default("mixte") // « charge » | « produit » | « tresorerie » | « tiers » | « capitaux » | « mixte »
  parentNumero    String? // compte parent (hiérarchie du plan)
  statut          String @default("actif") // « actif » | « ferme »
  dateOuverture   DateTime?
  dateCloture     DateTime?
  devise          String @default("XOF")
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCompteComptable", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes LigneEcriture[]

  @@index([etablissementId, numero])
  @@map("comptes_comptables")
}

/// JOURNAL comptable (11) : ventes, achats, caisse, banque, OD, salaires, immobilisations —
/// paramétrable, semé avec les 7 journaux par défaut. Unicité du code parmi les actifs.
model JournalComptable {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  code            String // ex : « VE », « CA », « OD »
  libelle         String
  type            String // « ventes » | « achats » | « caisse » | « banque » | « od » | « salaires » | « immobilisations »
  actif           Boolean @default(true)
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsJournalComptable", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  ecritures EcritureComptable[]

  @@index([etablissementId, code])
  @@map("journaux_comptables")
}

/// ÉCRITURE comptable en partie double (11). Statuts STOCKÉS : « brouillon » | « validee ».
/// RM-700 : équilibre débit = crédit STRICT (contrôlé à la saisie ET à la validation) ;
/// RM-701/702 : une validée ne se modifie ni ne se supprime JAMAIS — correction par
/// CONTRE-PASSATION (écriture inverse liée par contreEcritureDeId) ; RM-703 : pièce
/// justificative obligatoire ; RM-704 : exercice obligatoire ; RM-705 : période clôturée
/// verrouillée. Génération AUTOMATIQUE idempotente : une pièce source = une écriture
/// (unicité partielle sur etablissementId+sourceType+sourceId). Le numéro est attribué à la
/// VALIDATION via les séquences de la fondation (préfixe = code du journal).
model EcritureComptable {
  id              String           @id @default(cuid())
  etablissementId String
  etablissement   Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // RM-704
  journalId       String
  journal         JournalComptable @relation(fields: [journalId], references: [id], onDelete: Cascade)
  numero          String? // nul en brouillon — attribué à la validation
  date            DateTime // date comptable de l'écriture (la période AAAA-MM en dérive)
  libelle         String
  pieceJustificative String // RM-703 : OBLIGATOIRE
  origine         String @default("manuelle") // « manuelle » | « automatique »
  /// Génération automatique : pièce d'origine (« paiement » | « vente » | « operation »
  /// | « mouvement_bancaire » | « mouvement_caisse ») — un seul enregistrement actif par pièce.
  sourceType      String?
  sourceId        String?
  statut          String @default("brouillon") // « brouillon » | « validee »
  valideeParId    String?
  dateValidation  DateTime?
  /// Contre-passation (RM-702) : écriture VALIDÉE que celle-ci corrige (inverse).
  contreEcritureDeId String?
  creeParId       String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime? // seuls les BROUILLONS s'annulent (RM-701)
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsEcritureComptable", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes LigneEcriture[]

  @@index([etablissementId, exercice])
  @@index([etablissementId, date])
  @@index([journalId, statut])
  @@map("ecritures_comptables")
}

/// Ligne d'écriture (11) : compte débité OU crédité (jamais les deux), numéro et intitulé
/// FIGÉS pour l'inviolabilité documentaire, centre analytique facultatif, lettrage simple.
/// Les lignes d'un BROUILLON se remplacent par annulation logique (RM-004).
model LigneEcriture {
  id            String            @id @default(cuid())
  ecritureId    String
  ecriture      EcritureComptable @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  compteId      String
  compte        CompteComptable   @relation(fields: [compteId], references: [id], onDelete: Cascade)
  compteNumero  String // figé à l'enregistrement
  compteIntitule String // figé à l'enregistrement
  debit         Int @default(0)
  credit        Int @default(0)
  libelle       String?
  centreAnalytique String? // ventilation analytique V1 (clé de répartition : paramétrage à venir)
  lettrage      String? // code de lettrage simple (rapprochement de lignes)
  ordre         Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsLigneEcriture", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([ecritureId])
  @@index([compteId])
  @@map("lignes_ecriture")
}

/// CLÔTURE de PÉRIODE comptable mensuelle (11, RM-705) : plus aucune écriture datée de la
/// période après clôture. Réouverture EXCEPTIONNELLE = annulation logique justifiée + audit
/// (complète la clôture d'EXERCICE existante — clotures_exercice, inchangée).
model CloturePeriodeComptable {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  periode         String // « AAAA-MM »
  clotureParId    String?
  version         Int @default(0)
  annuleLe        DateTime? // réouverture exceptionnelle (justifiée, journalisée)
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsCloturePeriode", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, periode])
  @@map("clotures_periode")
}

// ═══════════════════════════════════════════════════════════════════════
//  12-ACHATS : cycle Procure-to-Pay (WF-004) — demandes d'achat validées par
//  seuils, bons de commande, réceptions (entrée en stock économat), factures
//  fournisseurs (écritures AC automatiques RM-904), paiements (RM-903),
//  retours. Fournisseur = MINIMUM exigé par le 12 (référentiel complet au 13).
// ═══════════════════════════════════════════════════════════════════════

/// Fournisseur — RÉFÉRENTIEL UNIQUE (13, enrichit le minimum du 12 par AJOUT — aucune
/// colonne retirée). RM-1000 : code unique ; RM-1001 : RCCM/NIF sans doublon actif ;
/// RM-1002 : suspendu = plus de commandes ; RM-1005 : archivé consultable, non sélectionnable.
/// Workflow de QUALIFICATION (BPMN 13 + 92) : création (« prospect ») → approbation par un
/// SECOND acteur → « actif » ; états « surveillance » (commandable, surveillé), « suspendu »,
/// « archive » ; « inactif » hérité du 12 (non commandable, conservé pour compatibilité).
model Fournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  code            String // « FRS-000001 » (séquence fondation, RM-1000)
  raisonSociale   String
  nomCommercial   String?
  /// « biens » | « services » | « travaux » | « institution » | « financier »
  type            String @default("biens")
  contactNom      String?
  contactFonction String?
  telephone       String?
  email           String?
  adresse         String?
  ville           String?
  numeroRccm      String?
  numeroFiscal    String?
  /// « prospect » | « actif » | « surveillance » | « suspendu » | « archive » | « inactif » (12)
  statut          String @default("actif")
  notes           String?
  // ── 13 : identité juridique et localisation complètes ──
  formeJuridique  String?
  numeroCnps      String?
  numeroTva       String?
  siteWeb         String?
  region          String?
  // ── 13 : catégorisation ──
  secteurActivite String?
  categoriesProduits String? // catégories de produits/services (libellés séparés par virgule)
  niveauStrategique  String @default("standard") // « standard » | « strategique »
  niveauRisque       String @default("faible") // « faible » | « moyen » | « eleve »
  // ── 13 : conditions commerciales ──
  delaiPaiementJours Int?
  remisePourcent     Int?
  minimumCommande    Int? // FCFA
  plafondCredit      Int? // FCFA — alerte si l'encours (factures validées − paiements) dépasse
  // ── 13 : workflow de qualification (double acteur) ──
  creeParId       String?
  approuveParId   String?
  approuveParNom  String?
  dateApprobation DateTime?
  devise          String @default("XOF") // RM-007
  version         Int @default(0) // RM-019
  annuleLe        DateTime? // RM-004
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  demandesRetenues DevisFournisseur[]
  bonsCommande     BonCommande[]
  factures         FactureFournisseur[]
  articlesPrincipaux ArticleEconomat[] @relation("ArticlesFournisseurPrincipal")
  immobilisations  Immobilisation[]   @relation("ImmobilisationsFournisseur")
  contacts         ContactFournisseur[]
  comptesBancaires CompteBancaireFournisseur[]
  documents        DocumentFournisseur[]
  contrats         ContratFournisseur[]
  evaluations      EvaluationFournisseur[]
  litiges          LitigeFournisseur[]

  @@index([etablissementId, statut])
  @@map("fournisseurs")
}

/// Contact d'un fournisseur (13 : contacts multiples, un PRINCIPAL par fiche).
model ContactFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  nom           String
  fonction      String?
  telephone     String?
  email         String?
  principal     Boolean @default(false)
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsContactFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId])
  @@map("contacts_fournisseur")
}

/// Coordonnées bancaires d'un fournisseur (13 : plusieurs comptes, un PRINCIPAL).
model CompteBancaireFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  banque        String
  agence        String?
  numeroCompte  String?
  iban          String?
  swift         String?
  mobileMoney   String? // n° Mobile Money Business
  devise        String @default("XOF")
  principal     Boolean @default(false)
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsCompteBancaireFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId])
  @@map("comptes_bancaires_fournisseur")
}

/// Document administratif d'un fournisseur (13) : RCCM, attestations, agréments, assurances…
/// « Expiré » / « expire bientôt » sont DÉRIVÉS de dateExpiration (RM-1003 — jamais stockés).
/// Le FICHIER joint viendra avec le chantier documents (référence texte en V1).
model DocumentFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  /// « rccm » | « attestation_fiscale » | « attestation_cnps » | « attestation_regularite »
  /// | « agrement » | « assurance » | « piece_identite » | « contrat » | « catalogue »
  /// | « tarifs » | « autre »
  type          String
  reference     String?
  dateEmission  DateTime?
  dateExpiration DateTime?
  numeroVersion Int @default(1)
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsDocumentFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId])
  @@map("documents_fournisseur")
}

/// Contrat d'un fournisseur (13) : « en cours / à échéance / expiré » DÉRIVÉS de dateFin.
model ContratFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  reference     String
  objet         String
  dateDebut     DateTime
  dateFin       DateTime?
  montant       Int? // FCFA
  conditionsPaiement String?
  penalites     String?
  /// « aucun » | « tacite » | « express »
  renouvellement String @default("aucun")
  documentReference String?
  devise        String @default("XOF")
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsContratFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId])
  @@map("contrats_fournisseur")
}

/// Évaluation périodique d'un fournisseur (13/RM-1004) : 5 critères notés de 1 à 5 —
/// le SCORE GLOBAL est DÉRIVÉ (moyenne ; la pondération paramétrable viendra plus tard).
model EvaluationFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  periode       String // libellé libre : « 2025-2026 T1 », « Année 2026 »…
  scoreQualite    Int // 1..5
  scoreDelais     Int
  scorePrix       Int
  scoreService    Int
  scoreConformite Int
  commentaire   String?
  evalueParId   String?
  evalueParNom  String?
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsEvaluationFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId])
  @@map("evaluations_fournisseur")
}

/// Litige avec un fournisseur (13) : ouverture motivée → résolution documentée.
model LitigeFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  /// « retard_livraison » | « non_conformite » | « erreur_facturation » | « rupture_contrat »
  /// | « qualite_insuffisante » | « autre »
  type          String
  description   String
  /// « mineure » | « moyenne » | « majeure » | « critique »
  gravite       String @default("moyenne")
  responsable   String? // interlocuteur / responsable du suivi
  /// « ouvert » | « resolu » (transitions historisées)
  statut        String @default("ouvert")
  solution      String?
  dateCloture   DateTime?
  ouvertParId   String?
  ouvertParNom  String?
  cloParId      String?
  cloParNom     String?
  version       Int @default(0)
  annuleLe      DateTime?
  annuleParId   String?
  annulePar     Utilisateur? @relation("AnnulationsLitigeFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe        DateTime @default(now())

  @@index([fournisseurId, statut])
  @@map("litiges_fournisseur")
}

/// Demande d'achat (12) : statut de WORKFLOW stocké (transitions historisées, jamais dérivable) :
/// « brouillon » → « soumise » → « approuvee » | « refusee » → « commandee » → « cloturee ».
/// Validation par SEUIL : ≤ 1 000 000 F = finance.achats.valider ; au-delà = .approuver
/// (direction). Séparation demandeur ≠ validateur (OPERATIONS_DOUBLE_ACTEUR).
model DemandeAchat {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // ex : « 2025-2026 »
  numero          String? // « DA-000001 » — attribué à la SOUMISSION
  /// « biens » | « services » | « travaux »
  typeAchat       String @default("biens")
  objet           String // désignation du besoin
  justification   String // OBLIGATOIRE (12 : toute dépense justifiée)
  service         String? // service demandeur
  centreCout      String? // centre de coût (suggestions analytiques du 11)
  /// « normale » | « urgente » | « critique »
  urgence         String @default("normale")
  categorieBudget String // code OHADA dépense (60x…) — budget concerné + compte de charge RM-904
  montantEstime   Int // FCFA
  pieceJustificative String? // référence des pièces jointes (fichiers : chantier documents)
  statut          String @default("brouillon")
  demandeurId     String?
  demandeurNom    String // FIGÉ (lisible même si le compte disparaît)
  decideParId     String?
  decideParNom    String?
  dateDecision    DateTime?
  motifRefus      String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDemandeAchat", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  devis        DevisFournisseur[]
  bonsCommande BonCommande[]

  @@index([etablissementId, statut])
  @@index([etablissementId, exercice])
  @@map("demandes_achat")
}

/// Consultation fournisseurs (12) : devis/cotations rattachés à une demande — archivés
/// (annulation logique), un seul RETENU actif par demande (contrôlé en transaction).
model DevisFournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  demandeId       String
  demande         DemandeAchat  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  fournisseurId   String
  fournisseur     Fournisseur   @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  montant         Int // FCFA
  delaiJours      Int?
  conditions      String?
  pieceReference  String? // référence du devis reçu
  retenu          Boolean @default(false)
  devise          String @default("XOF")
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDevisFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([demandeId])
  @@map("devis_fournisseur")
}

/// Bon de commande (12) : émis sur une demande APPROUVÉE (RM-900) pour un fournisseur
/// ACTIF (RM-901). Statut stocké minimal (« brouillon » → « emise » → « annulee ») ;
/// reçu/partiel/facturé/payé sont DÉRIVÉS des réceptions, factures et paiements.
model BonCommande {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  numero          String? // « BC-000001 » — attribué à l'ÉMISSION
  demandeId       String
  demande         DemandeAchat  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  fournisseurId   String
  fournisseur     Fournisseur   @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  statut          String @default("brouillon")
  conditionsPaiement String?
  lieuLivraison   String?
  dateLivraisonPrevue DateTime?
  emisParId       String?
  emisParNom      String?
  dateEmission    DateTime?
  motifAnnulation String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsBonCommande", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes     LigneBonCommande[]
  receptions ReceptionAchat[]
  factures   FactureFournisseur[]
  retours    RetourFournisseur[]

  @@index([etablissementId, statut])
  @@index([demandeId])
  @@index([fournisseurId])
  @@map("bons_commande")
}

/// Ligne d'un bon de commande : article de l'économat (stockable — l'entrée en stock
/// découlera de la réception) OU désignation libre (services, travaux).
model LigneBonCommande {
  id              String      @id @default(cuid())
  bonCommandeId   String
  bonCommande     BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  articleId       String? // ArticleEconomat (référence indicative, libellé FIGÉ ci-dessous)
  designation     String // FIGÉE au moment de la commande
  quantite        Int
  prixUnitaire    Int // FCFA
  ordre           Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsLigneBonCommande", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignesReception LigneReception[]
  retours         RetourFournisseur[]

  @@index([bonCommandeId])
  @@map("lignes_bon_commande")
}

/// Réception (12) : totale ou PARTIELLE — le cumul reçu par ligne ne dépasse jamais le
/// commandé (RM-902, contrôlé en transaction). Conformité : écarts DÉRIVÉS (reçu vs commandé).
model ReceptionAchat {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  bonCommandeId   String
  bonCommande     BonCommande   @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  receptionnaireId String?
  receptionnaireNom String // FIGÉ
  observations    String?
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsReceptionAchat", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  lignes LigneReception[]

  @@index([bonCommandeId])
  @@index([etablissementId])
  @@map("receptions_achat")
}

/// Ligne de réception : quantité reçue (et refusée le cas échéant) pour une ligne du BC.
model LigneReception {
  id                String           @id @default(cuid())
  receptionId       String
  reception         ReceptionAchat   @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  ligneBonCommandeId String
  ligneBonCommande  LigneBonCommande @relation(fields: [ligneBonCommandeId], references: [id], onDelete: Cascade)
  quantiteRecue     Int
  quantiteRefusee   Int @default(0)
  observation       String?
  /// MouvementStock d'entrée créé automatiquement (article stockable) — traçabilité 12↔14.
  mouvementStockId  String?
  creeLe            DateTime @default(now())

  @@index([receptionId])
  @@index([ligneBonCommandeId])
  @@map("lignes_reception")
}

/// Facture fournisseur (12) : rapprochée du BC (écart affiché — le 3-way match complet
/// viendra avec le 13/14). Statut de workflow stocké : « saisie » → « validee » | « annulee » ;
/// « payée » est DÉRIVÉ du cumul des paiements actifs (RM-903). RM-904 : la VALIDATION crée
/// l'écriture formelle AC (débit charge 60x / crédit 401) via le registre du 11 (idempotente).
model FactureFournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String
  bonCommandeId   String
  bonCommande     BonCommande   @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  fournisseurId   String
  fournisseur     Fournisseur   @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  numeroFournisseur String // numéro porté par la facture du fournisseur
  date            DateTime @default(now())
  montant         Int // FCFA TTC
  taxes           Int @default(0) // dont taxes (informatif V1)
  dateEcheance    DateTime?
  pieceJustificative String // référence de la pièce (obligatoire, 12)
  statut          String @default("saisie")
  valideeParId    String?
  valideeParNom   String?
  dateValidation  DateTime?
  motifAnnulation String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsFactureFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  paiements PaiementFournisseur[]

  @@index([etablissementId, statut])
  @@index([bonCommandeId])
  @@map("factures_fournisseur")
}

/// Paiement fournisseur (12) : total, partiel ou échelonné — le CUMUL des paiements actifs
/// ne dépasse jamais la facture (RM-903, contrôlé en transaction). Chaque paiement crée
/// l'OperationFinanciere (dépense 60x — compta calculée, KPI, budget, session de caisse si
/// espèces) ET l'écriture formelle « débit 401 / crédit trésorerie » (le 11 EXCLUT ces
/// opérations de sa collecte pour éviter tout double comptage).
model PaiementFournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  factureId       String
  facture         FactureFournisseur @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant         Int // FCFA
  mode            String @default("especes")
  reference       String? // n° virement, chèque, transaction Mobile Money…
  date            DateTime @default(now())
  /// OperationFinanciere créée automatiquement dans la transaction (jamais en double).
  operationId     String?
  payeParId       String?
  payeParNom      String?
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsPaiementFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([factureId])
  @@index([etablissementId])
  @@map("paiements_fournisseur")
}

/// Retour fournisseur (12) : total ou partiel, par ligne de BC — bon de retour numéroté
/// (BR-), stock régularisé (article stockable) et écriture de régularisation
/// « débit 401 / crédit charge » au prorata si une facture VALIDÉE existe sur le BC.
model RetourFournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  bonCommandeId   String
  bonCommande     BonCommande   @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  ligneBonCommandeId String
  ligneBonCommande LigneBonCommande @relation(fields: [ligneBonCommandeId], references: [id], onDelete: Cascade)
  numero          String // « BR-000001 »
  quantite        Int
  motif           String // OBLIGATOIRE
  /// MouvementStock de régularisation créé automatiquement (article stockable).
  mouvementStockId String?
  retourneParId   String?
  retourneParNom  String?
  date            DateTime @default(now())
  devise          String @default("XOF")
  dateComptable   DateTime?
  version         Int @default(0)
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsRetourFournisseur", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([bonCommandeId])
  @@index([etablissementId])
  @@map("retours_fournisseur")
}

/// Clôture d'un exercice : instantané du résultat et des soldes (à-nouveaux repris au
/// bilan de l'exercice suivant) ; les écritures antérieures à finPeriode sont verrouillées.
model ClotureExercice {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exercice        String // ex : « 2025-2026 »
  finPeriode      DateTime // dernier jour inclus dans l'exercice clôturé
  resultat        Int // FCFA — produits − charges de l'exercice
  devise          String @default("XOF") // RM-007
  soldes          Json // [{ compte, libelle, solde }] : trésorerie par compte, créances, report à nouveau
  notes           String?
  clotureParId    String?
  /// RM-008 : date de validation de la clôture (posée à la création à partir de la fondation).
  dateValidation  DateTime?
  version         Int @default(0) // RM-019 : verrouillage optimiste
  /// RM-004 : la réouverture d'un exercice est une ANNULATION logique de la clôture (plus de delete).
  annuleLe        DateTime?
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsClotureExercice", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  // L'unicité (etablissementId, exercice) ne porte que sur les clôtures ACTIVES : index unique
  // PARTIEL « WHERE annuleLe IS NULL » posé par la migration manuscrite 20260726090000 (un
  // exercice rouvert — clôture annulée — peut être re-clôturé sous le même libellé).
  @@index([etablissementId, exercice])
  @@map("clotures_exercice")
}

// ─────────────────────────────────────────────────────────────
//  Finance — FONDATION TRANSVERSE (docs/finance 03 & 05B)
//  RM-003/011/017 (journal d'audit inviolable), RM-007 (taux
//  de change historisés), RM-014 (numérotation configurable).
// ─────────────────────────────────────────────────────────────

/// Journal d'audit FINANCIER inviolable (RM-003/011/017) : table STRICTEMENT append-only —
/// aucune action d'update/delete n'est jamais écrite dessus (pas de colonne majLe, à dessein).
/// Chaque écriture d'audit est créée DANS LA MÊME transaction que l'opération auditée
/// (src/lib/finances/commun/audit.ts) : pas d'opération financière sans trace d'audit.
model JournalAuditFinance {
  id              String        @id @default(cuid())
  etablissementId String
  /// onDelete Restrict : l'audit ne disparaît JAMAIS, même si l'on tentait de supprimer l'établissement.
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Restrict)
  exerciceId      String? // libellé/identifiant d'exercice (ex : « 2025-2026 ») quand l'opération en porte un
  utilisateurId   String?
  utilisateur     Utilisateur?  @relation("AuditsFinanceUtilisateur", fields: [utilisateurId], references: [id], onDelete: SetNull)
  action          String // ex : « paiement.creation », « depense.annulation »
  entite          String // modèle concerné, ex : « PaiementScolarite »
  entiteId        String
  ancienneValeur  Json?
  nouvelleValeur  Json?
  ip              String?
  navigateur      String? // user-agent tronqué à 300 caractères
  /// MODE ASSISTANCE : administrateur RÉEL ayant agi en lieu et place de `utilisateurId`.
  /// Ce journal FAIT FOI pour les opérations financières : l'opérateur y est donc indispensable.
  operateurId     String?
  operateurEmail  String?
  creeLe          DateTime @default(now())

  @@index([etablissementId, creeLe])
  @@index([entite, entiteId])
  @@index([utilisateurId])
  @@index([operateurId])
  @@map("journal_audit_finance")
}

/// Taux de change HISTORISÉS (RM-007) : dernier taux dont dateEffet <= date de l'opération.
/// Jamais de taux inventé : absence de taux = conversion impossible (null côté domaine).
model TauxChange {
  id           String   @id @default(cuid())
  deviseSource String // code ISO 4217, ex : « XOF »
  deviseCible  String
  taux         Decimal  @db.Decimal(18, 8)
  dateEffet    DateTime
  creeParId    String?
  creePar      Utilisateur? @relation("TauxChangeCreePar", fields: [creeParId], references: [id], onDelete: SetNull)
  creeLe       DateTime @default(now())

  @@index([deviseSource, deviseCible, dateEffet])
  @@map("taux_change")
}

/// DÉLÉGATION de permissions Finance (97-RBAC : permissions temporaires RM-2604, délégation
/// limitée/tracée/révocable ; 04-Profils « Délégation de pouvoirs ») : un détenteur de
/// « finance.delegations.gerer » accorde à un utilisateur de l'ÉTABLISSEMENT un sous-ensemble
/// du registre de permissions (src/lib/finances/commun/permissions.ts) pour une période à FIN
/// OBLIGATOIRE. L'expiration s'évalue À LA VÉRIFICATION (fin < maintenant → inactive — aucun
/// cron) ; la révocation est une annulation logique (RM-004). Créations/révocations auditées
/// dans la transaction (RM-2603).
model DelegationFinance {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  beneficiaireId  String
  beneficiaire    Utilisateur   @relation("DelegationsFinanceBeneficiaire", fields: [beneficiaireId], references: [id], onDelete: Cascade)
  accordeParId    String?
  accordePar      Utilisateur?  @relation("DelegationsFinanceAccordePar", fields: [accordeParId], references: [id], onDelete: SetNull)
  permissions     Json // tableau de codes du registre, ex : ["finance.remboursements.valider"]
  motif           String
  debut           DateTime @default(now())
  fin             DateTime // OBLIGATOIRE (jamais de délégation sans terme)
  version         Int @default(0)
  annuleLe        DateTime? // révocation (RM-004)
  annuleParId     String?
  annulePar       Utilisateur? @relation("AnnulationsDelegationFinance", fields: [annuleParId], references: [id], onDelete: SetNull)
  creeLe          DateTime @default(now())

  @@index([etablissementId, fin])
  @@index([beneficiaireId, fin])
  @@map("delegations_finance")
}

/// Séquences de numérotation configurables (RM-014, équivalent « numbering_sequences » du 05) :
/// numéros uniques par établissement (et par exercice si renseigné), format PREFIXE-AAAA-000123.
/// Les reçus existants (PaiementScolarite.numeroRecu) restent sur leur numérotation historique ;
/// le branchement viendra avec les specs 07/08 via src/lib/finances/commun/numerotation.ts.
model SequenceNumerotation {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  exerciceId      String? // nul = séquence continue hors exercice (unicité NULL garantie par index partiel en base)
  type            String // ex : « recu », « facture », « bon_commande »
  prefixe         String // ex : « REC », « FAC », « BC »
  prochainNumero  Int @default(1)
  largeur         Int @default(6) // nombre de chiffres du compteur formaté
  creeLe          DateTime @default(now())
  majLe           DateTime @updatedAt

  @@unique([etablissementId, exerciceId, type])
  @@map("sequences_numerotation")
}

// ─────────────────────────────────────────────────────────────
//  MODULE « Transport d'élèves » (Vie scolaire)
//  Géolocalisation temps réel des cars (Leaflet/OSM), abonnement
//  payant (un parent ne voit le car que s'il est du même établissement
//  ET abonné actif), conducteur qui émet sa position, paiement Mobile
//  Money à validation manuelle. Portage du kit fourni, adapté aux
//  conventions de l'app : identifiants `String`/cuid (pas de @db.Uuid),
//  `etablissementId` = cuid d'Etablissement (null = périmètre « Général »),
//  `userId` = id d'Utilisateur (scalaires non reliés, comme JournalActivite).
// ─────────────────────────────────────────────────────────────

/// Réglages transport par périmètre : id = cuid d'établissement OU « global ».
model TransportSettings {
  id                String   @id @default("global")
  priceFcfa         Int      @default(0) @map("price_fcfa") // legacy (compat mensuel)
  priceMonthFcfa    Int?     @map("price_month_fcfa")
  priceYearFcfa     Int?     @map("price_year_fcfa")
  upgradePenaltyPct Int      @default(20) @map("upgrade_penalty_pct")
  beepIntervalMin   Int      @default(5) @map("beep_interval_min")
  centerLat         Float?   @map("center_lat")
  centerLng         Float?   @map("center_lng")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("transport_settings")
}

/// Un car (terminal émetteur), identifié par son matricule.
model TransportBus {
  id              String       @id @default(uuid())
  etablissementId String?      @map("etablissement_id") // cuid Etablissement, null = « Général »
  matricule       String
  label           String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  position        BusPosition?

  @@index([etablissementId])
  @@map("transport_buses")
}

/// Créneau d'émission (jour + fenêtre horaire) pendant lequel le car diffuse sa position.
model TransportSlot {
  id              String   @id @default(uuid())
  etablissementId String?  @map("etablissement_id")
  label           String?
  direction       String   @default("aller") // « aller » | « retour »
  days            Int[]    @default([1, 2, 3, 4, 5]) // 1 = lundi … 7 = dimanche
  startTime       String   @map("start_time") // « HH:MM »
  endTime         String   @map("end_time")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([etablissementId])
  @@map("transport_slots")
}

/// Dernière position connue d'un car (mise à jour par le conducteur, lue par les abonnés).
model BusPosition {
  busId     String       @id @map("bus_id")
  bus       TransportBus @relation(fields: [busId], references: [id], onDelete: Cascade)
  driverId  String?      @map("driver_id") // id Utilisateur
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  direction String?
  updatedAt DateTime     @default(now()) @map("updated_at")

  @@map("bus_positions")
}

/// Conducteur désigné (autorisé à émettre la position des cars de son établissement).
model TransportDriver {
  userId          String   @id @map("user_id") // id Utilisateur
  email           String?
  etablissementId String?  @map("etablissement_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([etablissementId])
  @@map("transport_drivers")
}

/// Abonnement d'un parent au suivi transport (échéance ; jamais raccourcie par un upgrade).
model TransportSubscription {
  userId          String    @id @map("user_id") // id Utilisateur
  active          Boolean   @default(true)
  period          String? // « month » | « year »
  expiresAt       DateTime? @map("expires_at")
  etablissementId String?   @map("etablissement_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([etablissementId])
  @@map("transport_subscriptions")
}

/// Paiement Mobile Money d'un abonnement transport (validation manuelle par le gestionnaire).
model TransportPayment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id") // id Utilisateur
  etablissementId String?   @map("etablissement_id")
  payerEmail      String?   @map("payer_email")
  amountFcfa      Int       @default(0) @map("amount_fcfa")
  method          String    @default("mobile_money")
  reference       String?
  period          String    @default("month") // « month » | « year »
  isUpgrade       Boolean   @default(false) @map("is_upgrade")
  status          String    @default("pending") // « pending » | « confirmed » | « rejected »
  createdAt       DateTime  @default(now()) @map("created_at")
  confirmedAt     DateTime? @map("confirmed_at")
  confirmedBy     String?   @map("confirmed_by") // id Utilisateur (gestionnaire)

  @@index([status])
  @@index([userId])
  @@index([etablissementId])
  @@map("transport_payments")
}
